<%
const tagsOf = (item) => (item.categories || []);
const tagLink = (tag) => `posts.html#tag=${encodeURIComponent(tag)}`;
const allTags = [...new Set(items.flatMap(tagsOf))].sort();
%>
```{=html}
<% if (allTags.length > 0) { %>
<nav class="tag-bar" aria-label="Filter posts by tag">
<a class="tag-chip" href="posts.html" data-tag-filter="">All</a>
<% for (const tag of allTags) { %><a class="tag-chip" href="<%- tagLink(tag) %>" data-tag-filter="<%= tag %>"><%= tag %></a>
<% } %></nav>
<p class="tag-empty" hidden>No posts with this tag yet.</p>
<% } %>
<div class="post-list">
<% for (const item of items) { %>
<article class="post-row" data-tags="<%- tagsOf(item).join('|') %>">
<a class="post-row-thumb" href="<%- item.path %>"><img src="<%- item.image %>" alt="" loading="lazy"></a>
<div class="post-row-text">
<p class="post-row-date"><%= item.date %></p>
<h3><a href="<%- item.path %>"><%= item.title %></a></h3>
<p><%= item.description %></p>
<div class="listing-categories">
<% for (const tag of tagsOf(item)) { %><a class="tag-chip" href="<%- tagLink(tag) %>"><%= tag %></a><% } %>
</div>
</div>
</article>
<% } %>
</div>
```
