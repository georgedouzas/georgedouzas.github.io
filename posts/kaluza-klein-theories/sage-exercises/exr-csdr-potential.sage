# Exercise exr-csdr-potential: the potential from the internal field strength F_12 = [phi_1, phi_2] - tau, its form
# r^2/2 - r + 2/3 in r = |Phi|^2, the minimum, and the unbroken generator at the vacuum.
p, q, pb, qb = var("p q pb qb")
E = lambda i, j: matrix(SR, 3, 3, lambda a, b: 1 if (a, b) == (i, j) else 0)
tau = I / 3 * diagonal_matrix(SR, [1, 1, -2])
ad = lambda A, B: A * B - B * A
phip = p * E(0, 2) + q * E(1, 2); phim = -(pb * E(2, 0) + qb * E(2, 1))
phi1 = (phip + phim) / 2; phi2 = I * (phip - phim) / 2
print("[phi_1, phi_2] ="); print(ad(phi1, phi2).simplify_full())
F12 = ad(phi1, phi2) - tau
V = -(F12 * F12).trace().expand()
r = var("r")
print("[PASS] V = -Tr F_12^2 = r^2/2 - r + 2/3, r = |p|^2 + |q|^2:", bool((V - ((p * pb + q * qb)^2 / 2 - (p * pb + q * qb) + 2/3)).expand() == 0))
print("[PASS] minimum 1/6 at r = 1:", solve(diff(r^2 / 2 - r + 2/3, r) == 0, r) == [r == 1] and bool((r^2 / 2 - r + 2/3).subs(r=1) == 1/6))
# unbroken generator at the vacuum p = 0, q = 1: the diagonal anti-Hermitian traceless matrices commuting with E_23
a, b = var("a b"); D = I * diagonal_matrix(SR, [a, b, -a - b])
comm = ad(D, E(1, 2))
print("[D, E_23] = 0 requires:", solve([e == 0 for e in comm.list() if e != 0], b))
print("[PASS] the vacuum E_23 is centralised exactly by the U(1) generated by i diag(2, -1, -1) (b = -a - b, i.e. a = -2b):", solve([e == 0 for e in comm.list() if e != 0], b) == [b == -a / 2])
Qem = I * diagonal_matrix(SR, [2, -1, -1]) / 3; T3 = I * diagonal_matrix(SR, [1, -1, 0]) / 2
print("[PASS] Q_em = T_3 + tau/2 and [Q_em, E_23] = 0 while [T_3, E_23] != 0:", Qem == T3 + tau / 2 and ad(Qem, E(1, 2)).is_zero() and not ad(T3, E(1, 2)).is_zero())
