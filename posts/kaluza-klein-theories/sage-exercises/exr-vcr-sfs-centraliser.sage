# Exercise exr-vcr-sfs-centraliser: the gauge group surviving a symmetric-field reduction is the centraliser of the
# embedded isotropy group. Compute the dimension of the centraliser in sl(3) of a U(1) generated by
# Y = diag(1, 1, -2) (the lambda_8 direction) and by T = diag(1, -1, 0) (the lambda_3 direction).
def centraliser_dim(Y):
    n = Y.nrows()
    basis = []
    for i in range(n):
        for j in range(n):
            if i != j:
                E = matrix(QQ, n, n); E[i, j] = 1; basis.append(E)
    for i in range(n - 1):
        E = matrix(QQ, n, n); E[i, i] = 1; E[i + 1, i + 1] = -1; basis.append(E)
    A = matrix(QQ, [list((Y * B - B * Y).list()) for B in basis]).transpose()
    return A.right_kernel().dimension()
print("centraliser of diag(1, 1, -2) in sl(3): dimension", centraliser_dim(diagonal_matrix(QQ, [1, 1, -2])), "= su(2) + u(1)")
print("centraliser of diag(1, -1, 0) in sl(3): dimension", centraliser_dim(diagonal_matrix(QQ, [1, -1, 0])), "= u(1) + u(1)")
print("centraliser of diag(1, 1, -1, -1) in sl(4): dimension", centraliser_dim(diagonal_matrix(QQ, [1, 1, -1, -1])), "= su(2) + su(2) + u(1)")
