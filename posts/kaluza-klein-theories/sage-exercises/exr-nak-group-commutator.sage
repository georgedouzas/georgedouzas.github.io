# Exercise exr-nak-group-commutator: two rotations of the sphere about the 1- and 2-axes, by angles s and t, do not
# commute; their group commutator R_1(s) R_2(t) R_1(-s) R_2(-t) is, to second order, the rotation generated by
# s t [L_1, L_2], where L_a with (L_a)_{bc} = -eps_abc generates the rotation about the a-axis (the flow of K_a).
s, t = var("s t")
def lc(a, b, c): return Permutation([a + 1, b + 1, c + 1]).sign() if len({a, b, c}) == 3 else 0
L = [matrix(QQ, 3, 3, lambda b, c: -lc(a, b, c)) for a in range(3)]
R = lambda a, ang: identity_matrix(3) + sin(ang) * L[a] + (1 - cos(ang)) * L[a]^2   # Rodrigues: exp(ang L_a)
print("R_1(s) =", R(0, s).rows())
print("[PASS] R_a(s) = exp(s L_a): d/ds R_a = L_a R_a and R_a(0) = 1:", all((diff(R(a, s), s) - L[a] * R(a, s)).apply_map(lambda e: e.simplify_full()).is_zero() and R(a, 0) == 1 for a in range(3)))
C = R(0, s) * R(1, t) * R(0, -s) * R(1, -t)
second = C.apply_map(lambda e: e.taylor((s, 0), (t, 0), 2))
print("commutator to second order:", second)
print("[PASS] R_1(s) R_2(t) R_1(-s) R_2(-t) = 1 + s t [L_1, L_2] + O(3):", (second - identity_matrix(3) - s * t * (L[0] * L[1] - L[1] * L[0])).apply_map(lambda e: e.simplify_full()).is_zero())
print("[PASS] [L_1, L_2] = L_3, the matrix commutator (the vector fields L_a x have the opposite bracket -eps_abc):", L[0] * L[1] - L[1] * L[0] == L[2])
