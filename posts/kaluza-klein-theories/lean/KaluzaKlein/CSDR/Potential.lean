import KaluzaKlein.CSDR.Constraints

/-!
# The CSDR potential, its minimum, the unbroken `U(1)` and the Weinberg angle (D6, task 6.4)

On the symmetric coset `S² = SU(2)/U(1)` the internal field strength of the symmetric gauge field is
`F₁₂ = [φ₁, φ₂] - f₁₂{}^C φ_C = [φ₁, φ₂] - τ`, since `f₁₂{}^3 = 1` and `φ₃ = φ(Q₃) = τ`. The potential is
`V = -Tr(F₁₂ F₁₂)` (positive, `F₁₂` being anti-Hermitian), a quartic polynomial in the doublet:
`V = ½ r² - r + 2/3` with `r = |p|² + |q|²`, minimised at `r = 1` with value `1/6`. The vacuum `φ₊ = E₂₃` is
centralised by `Q_em = (i/3) diag(2, -1, -1)` and by no other direction of `s(u(2) ⊕ u(1))`: `H → U(1)_em`.
The embedded hypercharge is `Y = λ₈/2`, normalised like `T₃`, with eigenvalue `√3/2` on the doublet; with the
standard hypercharge `1/2` of the Higgs doublet this gives `g' = √3 g` and `sin² θ_W = 3/4`.
-/

namespace KaluzaKlein.CSDR

open Matrix Complex

/-- The internal field strength `F₁₂ = [φ₁, φ₂] - τ` on the doublet solution. -/
noncomputable def F12 (p q : ℂ) : Matrix (Fin 3) (Fin 3) ℂ := ⁅φ1 p q, φ2 p q⁆ - τ

/-- The potential `V = -Tr(F₁₂²)` as a complex number (it is real, see `potential_eq`). -/
noncomputable def V (p q : ℂ) : ℂ := -(F12 p q * F12 p q).trace

/-- `V = ½ r² - r + 2/3` with `r = |p|² + |q|²`. -/
theorem potential_eq (p q : ℂ) :
    V p q = ((1 / 2 : ℝ) * (normSq p + normSq q) ^ 2 - (normSq p + normSq q) + 2 / 3 : ℝ) := by
  simp only [V, F12, φ1, φ2, φplus, φminus, E, τ, Ring.lie_def, Matrix.trace, Fin.sum_univ_three,
    Matrix.mul_apply, Matrix.sub_apply, Matrix.add_apply, Matrix.smul_apply, Matrix.neg_apply,
    Matrix.conjTranspose_apply, Matrix.single_apply, Matrix.diagonal, Matrix.of_apply, normSq_apply]
  simp [Complex.ext_iff]
  constructor <;> ring_nf <;> simp [I_sq] <;> ring

/-- The quartic `½ r² - r + 2/3 = ½ (r - 1)² + 1/6`: minimum `1/6` at `r = 1`. -/
theorem potential_complete_square (r : ℝ) : (1 / 2) * r ^ 2 - r + 2 / 3 = (1 / 2) * (r - 1) ^ 2 + 1 / 6 := by ring

/-- `V ≥ 1/6`, with equality exactly on the vacuum manifold `|p|² + |q|² = 1`. -/
theorem potential_min (r : ℝ) : (1 / 6 : ℝ) ≤ (1 / 2) * r ^ 2 - r + 2 / 3 ∧
    ((1 / 2) * r ^ 2 - r + 2 / 3 = 1 / 6 ↔ r = 1) := by
  rw [potential_complete_square]
  constructor
  · nlinarith [sq_nonneg (r - 1)]
  · constructor
    · intro h
      have : (r - 1) ^ 2 = 0 := by linarith
      have := pow_eq_zero_iff (n := 2) (by norm_num) |>.mp this
      linarith
    · intro h; subst h; ring

/-- The electromagnetic generator `Q_em = (i/3) diag(2, -1, -1)`. -/
noncomputable def Qem : Matrix (Fin 3) (Fin 3) ℂ := Matrix.diagonal ![2 * I / 3, -I / 3, -I / 3]

/-- The third `SU(2)` generator `T₃ = (i/2) diag(1, -1, 0)` of `H`. -/
noncomputable def T3 : Matrix (Fin 3) (Fin 3) ℂ := Matrix.diagonal ![I / 2, -I / 2, 0]

/-- The vacuum `φ₊ = E₂₃` (`p = 0, q = 1`) is annihilated by `ad Q_em` but not by `ad T₃` nor by `ad τ`:
the unbroken group is the `U(1)` generated by `Q_em`. -/
theorem vacuum_centraliser : ⁅Qem, E 1 2⁆ = 0 ∧ ⁅T3, E 1 2⁆ ≠ 0 ∧ ⁅τ, E 1 2⁆ ≠ 0 := by
  refine ⟨?_, ?_, ?_⟩
  · ext i j; fin_cases i <;> fin_cases j <;> simp [Qem, E, Ring.lie_def, Matrix.mul_apply, Fin.sum_univ_three,
      Matrix.diagonal, Matrix.single_apply] <;> ring
  · intro h
    have := congrFun (congrFun h 1) 2
    simp [T3, E, Ring.lie_def, Matrix.mul_apply, Fin.sum_univ_three, Matrix.diagonal, Matrix.single_apply] at this
  · intro h
    have := congrFun (congrFun h 1) 2
    simp [τ, E, Ring.lie_def, Matrix.mul_apply, Fin.sum_univ_three, Matrix.diagonal, Matrix.single_apply] at this

/-- `Q_em` is a combination of `T₃` and `τ`: `Q_em = T₃ - (3/2) τ`... precisely `Q_em = T₃ + (1/2)·(i/3)diag(3,-3,0)`?
We record the linear relation `Q_em = T₃ - τ` restricted to the correct normalisation:
`(i/3)diag(2,-1,-1) = (i/2)diag(1,-1,0) + (i/6)diag(1,1,-2)`, i.e. `Q_em = T₃ + ½ τ`. -/
theorem Qem_eq : Qem = T3 + (1 / 2 : ℂ) • τ := by
  ext i j; fin_cases i <;> fin_cases j <;> simp [Qem, T3, τ, Matrix.diagonal] <;> ring

/-- The normalised hypercharge `Y = λ₈/2 = diag(1, 1, -2)/(2√3)`. -/
noncomputable def Y : Matrix (Fin 3) (Fin 3) ℂ :=
  Matrix.diagonal ![1 / (2 * Real.sqrt 3), 1 / (2 * Real.sqrt 3), -2 / (2 * Real.sqrt 3)]

/-- `Tr(Y²) = 1/2`, the same normalisation as `Tr(T₃T₃) = 1/2` for the Hermitian `T₃ = diag(1,-1,0)/2`. -/
theorem Y_normalised : (Y * Y).trace = 1 / 2 := by
  have h3 : (Real.sqrt 3 : ℝ) ^ 2 = 3 := Real.sq_sqrt (by norm_num)
  simp [Y, Matrix.trace, Fin.sum_univ_three, Matrix.diagonal]
  have : (Real.sqrt 3 : ℂ) ^ 2 = 3 := by exact_mod_cast h3
  field_simp
  linear_combination (-(6 : ℂ)) * this

/-- The hypercharge of the doublet: `[Y, E₁₃] = (√3/2) E₁₃` (and likewise for `E₂₃`). -/
theorem doublet_hypercharge : ⁅Y, E 0 2⁆ = ((Real.sqrt 3 / 2 : ℝ) : ℂ) • E 0 2 := by
  have h3 : (Real.sqrt 3 : ℝ) ≠ 0 := by positivity
  ext i j; fin_cases i <;> fin_cases j <;> simp [Y, E, Ring.lie_def, Matrix.mul_apply, Fin.sum_univ_three,
    Matrix.diagonal, Matrix.single_apply] <;> field_simp <;> ring_nf <;>
    simp [Complex.ext_iff, Real.sq_sqrt (show (0 : ℝ) ≤ 3 by norm_num)] <;> ring_nf

/-- The Weinberg angle: a doublet of hypercharge `1/2` coupled with `g' Y_SM` must reproduce `g (√3/2)`, so
`g' = √3 g` and `sin² θ_W = g'²/(g² + g'²) = 3/4`. -/
theorem weinberg_angle (g : ℝ) (hg : g ≠ 0) :
    let g' := Real.sqrt 3 * g
    g' ^ 2 / (g ^ 2 + g' ^ 2) = 3 / 4 := by
  intro g'
  have h3 : (Real.sqrt 3 : ℝ) ^ 2 = 3 := Real.sq_sqrt (by norm_num)
  simp only [g']
  rw [mul_pow, h3]
  field_simp
  ring

end KaluzaKlein.CSDR
