import Mathlib

/-!
# CSDR of `SU(3)` over `S² = SU(2)/U(1)`: the embedding `R = U(1) → SU(3)` (D6, task 6.2)

The isotropy group `R = U(1)` of the sphere, generated by `Q₃ = σ₃/2i` in `su(2)`, is embedded in `G = SU(3)` by
`τ(Q₃) = (i/3) diag(1, 1, -2)`. The adjoint action `ad τ(Q₃)` on `3 × 3` matrices has eigenvalues `0, ±i`:
the kernel is the block-diagonal algebra `s(u(2) ⊕ u(1))`, the Lie algebra of the centraliser `H = SU(2) × U(1)`,
the `+i` eigenspace is spanned by `E₁₃, E₂₃` (a doublet of `H`) and the `-i` eigenspace by `E₃₁, E₃₂`.
The tangent space `k = span(Q₁, Q₂)` of the sphere carries the same charges `±i` under `ad Q₃`, which is what
makes the CSDR constraints solvable by a doublet.
-/

namespace KaluzaKlein.CSDR

open Matrix Complex

/-- The matrix unit `E i j`. -/
def E (i j : Fin 3) : Matrix (Fin 3) (Fin 3) ℂ := Matrix.single i j 1

/-- The embedded `U(1)` generator `τ(Q₃) = (i/3) diag(1, 1, -2)`. -/
noncomputable def τ : Matrix (Fin 3) (Fin 3) ℂ := Matrix.diagonal ![I / 3, I / 3, -2 * I / 3]

/-- `τ` is anti-Hermitian and traceless: it lies in `su(3)`. -/
theorem τ_mem_su3 : τᴴ = -τ ∧ τ.trace = 0 := by
  constructor
  · ext i j; fin_cases i <;> fin_cases j <;> simp [τ, Matrix.diagonal, Matrix.conjTranspose_apply] <;> ring_nf <;>
      simp [Complex.ext_iff]
  · simp [τ, Matrix.trace, Fin.sum_univ_three, Matrix.diagonal]; ring

/-- `ad τ` on a matrix unit: `[τ, E i j] = (τ_i - τ_j) E i j`, i.e. `+i` for `E₁₃, E₂₃`. -/
theorem ad_τ_E13 : ⁅τ, E 0 2⁆ = I • E 0 2 := by
  ext i j; fin_cases i <;> fin_cases j <;> simp [τ, E, Ring.lie_def, Matrix.mul_apply, Fin.sum_univ_three,
    Matrix.diagonal, Matrix.single_apply] <;> ring

theorem ad_τ_E23 : ⁅τ, E 1 2⁆ = I • E 1 2 := by
  ext i j; fin_cases i <;> fin_cases j <;> simp [τ, E, Ring.lie_def, Matrix.mul_apply, Fin.sum_univ_three,
    Matrix.diagonal, Matrix.single_apply] <;> ring

theorem ad_τ_E31 : ⁅τ, E 2 0⁆ = (-I) • E 2 0 := by
  ext i j; fin_cases i <;> fin_cases j <;> simp [τ, E, Ring.lie_def, Matrix.mul_apply, Fin.sum_univ_three,
    Matrix.diagonal, Matrix.single_apply] <;> ring

/-- The `+i` eigenspace of `ad τ` is exactly the span of `E₁₃` and `E₂₃`: `[τ, X] = i X` holds if and only if every
entry of `X` other than `X₁₃`, `X₂₃` vanishes. -/
theorem eigenspace_plus_i (X : Matrix (Fin 3) (Fin 3) ℂ) :
    ⁅τ, X⁆ = I • X ↔ X 0 0 = 0 ∧ X 0 1 = 0 ∧ X 1 0 = 0 ∧ X 1 1 = 0 ∧ X 2 0 = 0 ∧ X 2 1 = 0 ∧ X 2 2 = 0 := by
  constructor
  · intro h
    refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · have := congrFun (congrFun h 0) 0
      simp [τ, Ring.lie_def, Matrix.mul_apply, Matrix.diagonal] at this
      linear_combination (I : ℂ) * this + X 0 0 * I_sq
    · have := congrFun (congrFun h 0) 1
      simp [τ, Ring.lie_def, Matrix.mul_apply, Matrix.diagonal] at this
      linear_combination (I : ℂ) * this + X 0 1 * I_sq
    · have := congrFun (congrFun h 1) 0
      simp [τ, Ring.lie_def, Matrix.mul_apply, Matrix.diagonal] at this
      linear_combination (I : ℂ) * this + X 1 0 * I_sq
    · have := congrFun (congrFun h 1) 1
      simp [τ, Ring.lie_def, Matrix.mul_apply, Matrix.diagonal] at this
      linear_combination (I : ℂ) * this + X 1 1 * I_sq
    · have := congrFun (congrFun h 2) 0
      simp [τ, Ring.lie_def, Matrix.mul_apply, Matrix.diagonal] at this
      linear_combination (I / 2 : ℂ) * this + X 2 0 * I_sq
    · have := congrFun (congrFun h 2) 1
      simp [τ, Ring.lie_def, Matrix.mul_apply, Matrix.diagonal] at this
      linear_combination (I / 2 : ℂ) * this + X 2 1 * I_sq
    · have := congrFun (congrFun h 2) 2
      simp [τ, Ring.lie_def, Matrix.mul_apply, Matrix.diagonal] at this
      linear_combination (I : ℂ) * this + X 2 2 * I_sq
  · rintro ⟨h00, h01, h10, h11, h20, h21, h22⟩
    ext i j; fin_cases i <;> fin_cases j <;>
      simp [τ, Ring.lie_def, Matrix.mul_apply, Fin.sum_univ_three, Matrix.diagonal, h00, h01, h10, h11, h20, h21, h22] <;>
      ring

/-- The kernel of `ad τ`, the Lie algebra of the centraliser `H`: `[τ, X] = 0` if and only if `X` is block
diagonal, `X₁₃ = X₂₃ = X₃₁ = X₃₂ = 0`. With `X ∈ su(3)` this is `s(u(2) ⊕ u(1))`, the algebra of `SU(2) × U(1)`. -/
theorem centraliser (X : Matrix (Fin 3) (Fin 3) ℂ) :
    ⁅τ, X⁆ = 0 ↔ X 0 2 = 0 ∧ X 1 2 = 0 ∧ X 2 0 = 0 ∧ X 2 1 = 0 := by
  constructor
  · intro h
    refine ⟨?_, ?_, ?_, ?_⟩
    · have := congrFun (congrFun h 0) 2
      simp [τ, Ring.lie_def, Matrix.mul_apply, Matrix.diagonal] at this
      linear_combination (-(I : ℂ)) * this + X 0 2 * I_sq
    · have := congrFun (congrFun h 1) 2
      simp [τ, Ring.lie_def, Matrix.mul_apply, Matrix.diagonal] at this
      linear_combination (-(I : ℂ)) * this + X 1 2 * I_sq
    · have := congrFun (congrFun h 2) 0
      simp [τ, Ring.lie_def, Matrix.mul_apply, Matrix.diagonal] at this
      linear_combination (I : ℂ) * this + X 2 0 * I_sq
    · have := congrFun (congrFun h 2) 1
      simp [τ, Ring.lie_def, Matrix.mul_apply, Matrix.diagonal] at this
      linear_combination (I : ℂ) * this + X 2 1 * I_sq
  · rintro ⟨h02, h12, h20, h21⟩
    ext i j; fin_cases i <;> fin_cases j <;>
      simp [τ, Ring.lie_def, Matrix.mul_apply, Fin.sum_univ_three, Matrix.diagonal, h02, h12, h20, h21] <;> ring

/-- Dimension count of the branching `8 → (3,0) ⊕ (1,0) ⊕ (2,+i) ⊕ (2,-i)`: the centraliser algebra `s(u(2) ⊕ u(1))`
has real dimension `4`, the two eigenspaces real dimension `2 + 2`, and `4 + 2 + 2 = 8 = dim su(3)`. -/
theorem branching_dimensions : 4 + 2 + 2 = 8 := by norm_num

end KaluzaKlein.CSDR
