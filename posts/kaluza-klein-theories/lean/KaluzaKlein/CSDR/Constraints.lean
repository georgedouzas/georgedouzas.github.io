import KaluzaKlein.CSDR.Embedding

/-!
# The symmetric-field constraints and their solution (D6, task 6.3)

With `S = SU(2)`, generators `Q_a = σ_a/2i`, `[Q_a, Q_b] = ε_abc Q_c`, `R` generated by `Q₃` and `k = span(Q₁, Q₂)`,
the CSDR constraint on the internal components `φ₁ = φ(Q₁)`, `φ₂ = φ(Q₂) ∈ su(3)` is the `R`-equivariance
`[τ(Q₃), φ(X)] = φ([Q₃, X])`, i.e. `[τ, φ₁] = φ₂` and `[τ, φ₂] = -φ₁`. In the combinations `φ± = φ₁ ∓ i φ₂` this reads
`[τ, φ±] = ±i φ±`, so by `eigenspace_plus_i` the solution is `φ₊ = p E₁₃ + q E₂₃` with `(p, q) ∈ ℂ²` free,
a complex doublet of `H = SU(2) × U(1)`, and `φ₋ = -φ₊ᴴ` by anti-Hermiticity.
-/

namespace KaluzaKlein.CSDR

open Matrix Complex

/-- `φ₊ = p E₁₃ + q E₂₃`: the upper-right column of a `3 × 3` matrix. -/
noncomputable def φplus (p q : ℂ) : Matrix (Fin 3) (Fin 3) ℂ := p • E 0 2 + q • E 1 2
/-- `φ₋ = -φ₊ᴴ`. -/
noncomputable def φminus (p q : ℂ) : Matrix (Fin 3) (Fin 3) ℂ := -(φplus p q)ᴴ
/-- `φ₁ = (φ₊ + φ₋)/2`. -/
noncomputable def φ1 (p q : ℂ) : Matrix (Fin 3) (Fin 3) ℂ := (1 / 2 : ℂ) • (φplus p q + φminus p q)
/-- `φ₂ = (i/2)(φ₊ - φ₋)`. -/
noncomputable def φ2 (p q : ℂ) : Matrix (Fin 3) (Fin 3) ℂ := (I / 2 : ℂ) • (φplus p q - φminus p q)

/-- The constraints are equivalent to the eigenvalue equations for `φ± = φ₁ ∓ i φ₂`. -/
theorem constraints_iff_eigen (A B : Matrix (Fin 3) (Fin 3) ℂ) :
    (⁅τ, A⁆ = B ∧ ⁅τ, B⁆ = -A) ↔ (⁅τ, A - I • B⁆ = I • (A - I • B) ∧ ⁅τ, A + I • B⁆ = (-I) • (A + I • B)) := by
  simp only [Ring.lie_def]
  constructor
  · rintro ⟨h1, h2⟩
    refine ⟨?_, ?_⟩
    · ext i j
      have e1 := congrFun (congrFun h1 i) j
      have e2 := congrFun (congrFun h2 i) j
      simp only [Matrix.mul_apply, Matrix.sub_apply, Matrix.add_apply, Matrix.smul_apply, Matrix.neg_apply,
        Fin.sum_univ_three, smul_eq_mul] at e1 e2 ⊢
      linear_combination e1 - I * e2 + B i j * I_sq
    · ext i j
      have e1 := congrFun (congrFun h1 i) j
      have e2 := congrFun (congrFun h2 i) j
      simp only [Matrix.mul_apply, Matrix.sub_apply, Matrix.add_apply, Matrix.smul_apply, Matrix.neg_apply,
        Fin.sum_univ_three, smul_eq_mul] at e1 e2 ⊢
      linear_combination e1 + I * e2 + B i j * I_sq
  · rintro ⟨h1, h2⟩
    refine ⟨?_, ?_⟩
    · ext i j
      have e1 := congrFun (congrFun h1 i) j
      have e2 := congrFun (congrFun h2 i) j
      simp only [Matrix.mul_apply, Matrix.sub_apply, Matrix.add_apply, Matrix.smul_apply, Matrix.neg_apply,
        Fin.sum_univ_three, smul_eq_mul] at e1 e2 ⊢
      linear_combination (1 / 2 : ℂ) * e1 + (1 / 2 : ℂ) * e2 - B i j * I_sq
    · ext i j
      have e1 := congrFun (congrFun h1 i) j
      have e2 := congrFun (congrFun h2 i) j
      simp only [Matrix.mul_apply, Matrix.sub_apply, Matrix.add_apply, Matrix.smul_apply, Matrix.neg_apply,
        Fin.sum_univ_three, smul_eq_mul] at e1 e2 ⊢
      apply mul_left_cancel₀ I_ne_zero
      linear_combination (-(1 / 2) : ℂ) * e1 + (1 / 2 : ℂ) * e2

/-- The explicit doublet solves the constraints: `[τ, φ₁] = φ₂` and `[τ, φ₂] = -φ₁` for every `(p, q)`. -/
theorem doublet_solves (p q : ℂ) : ⁅τ, φ1 p q⁆ = φ2 p q ∧ ⁅τ, φ2 p q⁆ = -φ1 p q := by
  constructor <;>
    (ext i j; fin_cases i <;> fin_cases j <;>
      simp [φ1, φ2, φplus, φminus, E, τ, Ring.lie_def, Matrix.mul_apply, Fin.sum_univ_three, Matrix.diagonal,
        Matrix.single_apply, Matrix.conjTranspose_apply] <;> (try ring_nf) <;> (try simp [I_sq]) <;> (try ring))

/-- Completeness: every solution of the constraints has `φ₁ - i φ₂` in the span of `E₁₃, E₂₃`, i.e. is of the
doublet form `φ₊ = p E₁₃ + q E₂₃` with `p = (φ₁ - iφ₂)₁₃`, `q = (φ₁ - iφ₂)₂₃`. -/
theorem solution_is_doublet (A B : Matrix (Fin 3) (Fin 3) ℂ) (h : ⁅τ, A⁆ = B ∧ ⁅τ, B⁆ = -A) :
    A - I • B = φplus ((A - I • B) 0 2) ((A - I • B) 1 2) := by
  have h1 := ((constraints_iff_eigen A B).mp h).1
  have hz := (eigenspace_plus_i _).mp h1
  ext i j; fin_cases i <;> fin_cases j <;> simp [φplus, E, Matrix.single_apply, hz.1, hz.2.1, hz.2.2.1, hz.2.2.2.1,
    hz.2.2.2.2.1, hz.2.2.2.2.2.1, hz.2.2.2.2.2.2]

/-- The solution is anti-Hermitian, as a field in `su(3)` must be: `φ₁ᴴ = -φ₁`, `φ₂ᴴ = -φ₂`. -/
theorem doublet_antihermitian (p q : ℂ) : (φ1 p q)ᴴ = -φ1 p q ∧ (φ2 p q)ᴴ = -φ2 p q := by
  constructor <;>
  · ext i j; fin_cases i <;> fin_cases j <;>
      simp [φ1, φ2, φplus, φminus, E, Matrix.conjTranspose_apply, Matrix.single_apply] <;> ring_nf <;>
      simp [Complex.ext_iff] <;> ring_nf

end KaluzaKlein.CSDR
