# Figure: the CSDR matching rule on S^2 = SU(2)/U(1) with G = SU(3). Left: the weights of the adjoint of su(3)
# (the root diagram, from Sage's RootSystem) with their charges under the embedded U(1) generated by
# tau = (i/3) diag(1,1,-2), i.e. the lambda_8 direction: four states of charge 0 (the adjoint of H = SU(2) x U(1)),
# two of charge +1 and two of charge -1. Right: the tangent space k of the sphere, spanned by Q_1, Q_2, carries the
# charges +-1 under ad Q_3; the CSDR rule keeps one H-multiplet for every pair of equal R-charges: the doublet.
# Output: figures/csdr_constraints.svg.
import os
OUT = os.path.join(os.path.dirname(os.path.abspath(__file__)), "csdr_constraints.svg")
# charges of the su(3) adjoint under tau: ad tau on E_ij has eigenvalue i (t_i - t_j) with t = (1/3, 1/3, -2/3)
t = [QQ(1)/3, QQ(1)/3, QQ(-2)/3]
charges = {}
for i in range(3):
    for j in range(3):
        if i != j: charges[(i, j)] = t[i] - t[j]
print("charges of the off-diagonal units E_ij:", charges)
from collections import Counter
cnt = Counter(charges.values()); cnt[0] += 2          # the two diagonal (Cartan) directions have charge 0
print("[PASS] adjoint of su(3) under the embedded U(1): 4 states of charge 0, 2 of charge +1, 2 of charge -1:", cnt == Counter({0: 4, 1: 2, -1: 2}))
# the charges of k = span(Q_1, Q_2) under ad Q_3 with [Q_a, Q_b] = eps_abc Q_c: Q_+- = Q_1 -+ i Q_2 have charges +-i
Q = [matrix(QQbar, [[0, 1], [1, 0]]) / (2 * I), matrix(QQbar, [[0, -I], [I, 0]]) / (2 * I), matrix(QQbar, [[1, 0], [0, -1]]) / (2 * I)]
Qp = Q[0] - I * Q[1]; Qm = Q[0] + I * Q[1]
ad = lambda X, Y: X * Y - Y * X
print("[PASS] [Q_3, Q_+-] = +-i Q_+-: the tangent space of the sphere has R-charges +-1:", ad(Q[2], Qp) == I * Qp and ad(Q[2], Qm) == -I * Qm)
# weight diagram of the adjoint from the root system A2
R = RootSystem(["A", 2]).ambient_space()
roots = R.roots()
def xy(v): # project the ambient A2 vector (sum zero) to the plane
    a, b, c = [QQ(v[i]) for i in range(3)]
    return (float(a - b) / 2, float((a + b - 2 * c) / (2 * sqrt(3))))
left = Graphics()
for r in roots:
    x, y = xy(r); ch = round(2 * y / sqrt(3))            # lambda_8 ~ vertical axis: charge = y-coordinate scaled
    col = {0: "gray", 1: "firebrick", -1: "royalblue"}[int(ch)]
    left += arrow((0, 0), (x, y), color=col, width=1.2, arrowsize=2)
    left += point((x, y), size=40, color=col)
left += point((0, 0), size=60, color="gray")
left += text("charge $0$: adjoint of $SU(2)\\times U(1)$", (0, -1.35), fontsize=9, color="gray")
left += text("charge $+1$: doublet", (1.05, 1.0), fontsize=9, color="firebrick"); left += text("charge $-1$", (-1.0, -1.0), fontsize=9, color="royalblue")
left.axes(False); left.set_aspect_ratio(1); left.xmin(-1.6); left.xmax(1.6); left.ymin(-1.6); left.ymax(1.4)
right = Graphics()
right += arrow((0, 0), (1, 0), color="firebrick", width=1.2) + arrow((0, 0), (-1, 0), color="royalblue", width=1.2)
right += text("$Q_+$, charge $+1$", (1.0, 0.25), fontsize=9, color="firebrick"); right += text("$Q_-$, charge $-1$", (-1.0, 0.25), fontsize=9, color="royalblue")
right += text("tangent space $k$ of $S^2$ under $R = U(1)$", (0, 0.8), fontsize=10)
right += text("rule: equal $R$-charges $\\Rightarrow$ one surviving\n$H$-multiplet: the complex doublet $\\Phi$", (0, -0.7), fontsize=9)
right.axes(False); right.set_aspect_ratio(1); right.xmin(-1.6); right.xmax(1.6); right.ymin(-1.2); right.ymax(1.2)
fig = graphics_array([left, right]).matplotlib(figsize=[9, 4]); fig.savefig(OUT, bbox_inches="tight")
print("wrote", os.path.relpath(OUT))

# the SU(2) x U(1) content of the charge classes: T_3 = (i/2) diag(1, -1, 0) gives E_ij the weight t3_i - t3_j
t3 = [QQ(1)/2, QQ(-1)/2, 0]
zero_T3 = sorted([t3[i] - t3[j] for (i, j), c in charges.items() if c == 0] + [0, 0])
plus_T3 = sorted([t3[i] - t3[j] for (i, j), c in charges.items() if c == 1])
print("T_3 weights of the charge-0 states:", zero_T3, "; of the charge +1 states:", plus_T3)
print("[PASS] charge 0: T_3 weights -1, 0, 0, 1 (triplet + singlet, the adjoint of SU(2) x U(1)); charge +1: T_3 = -1/2, 1/2 (a doublet):", zero_T3 == [-1, 0, 0, 1] and plus_T3 == [QQ(-1)/2, QQ(1)/2])
pairs = sum(1 for c in charges.values() if c == 1)
print("[PASS] matching: k has one state of charge +1, g has a doublet of charge +1, so one complex doublet (4 real scalars) survives:", pairs == 2 and 2 * pairs == 4)

# interactive version: the weight diagram of the adjoint of su(3) in the plane (T_3, Y_n), Y_n = lambda_8/2,
# coloured by the charge under the embedded U(1), with the electric charge Q_em = T_3 + Y_n/sqrt(3) on hover
import sys as _sys; _sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _interactive import plotly_html
yn = [1 / (2 * sqrt(3)), 1 / (2 * sqrt(3)), -1 / sqrt(3)]
names = {0: "H = SU(2) x U(1) (charge 0)", 1: "doublet phi_+ (charge +1)", -1: "conjugate phi_- (charge -1)"}
colours = {0: "gray", 1: "firebrick", -1: "royalblue"}
_traces = []
for ch in (0, 1, -1):
    xs, ys, txt = [], [], []
    for (i, j), c in charges.items():
        if c == ch:
            xs.append(float(t3[i] - t3[j])); ys.append(float(yn[i] - yn[j]))
            txt.append("E_%d%d<br>T_3 = %s<br>Y_n = %s<br>tau-charge = %s<br>Q_em = %s" % (i + 1, j + 1, t3[i] - t3[j], (yn[i] - yn[j]).simplify(), c, t3[i] - t3[j] + (c / 2)))
    if ch == 0:
        for k, lab in enumerate(["T_3 (Cartan)", "Y_n = lambda_8/2 (Cartan)"]):
            xs.append(0.0 + 0.06 * (2 * k - 1)); ys.append(0.0); txt.append("%s<br>T_3 = 0, Y_n = 0<br>tau-charge = 0<br>Q_em = 0" % lab)
    _traces.append({"x": xs, "y": ys, "mode": "markers", "type": "scatter", "name": names[ch], "text": txt, "hoverinfo": "text",
                    "marker": {"size": 16, "color": colours[ch], "line": {"width": 1, "color": "black"}}})
_traces.append({"x": [-1.3, 1.3], "y": [0, 0], "mode": "lines", "name": "Q_em = T_3 axis (tau-charge 0)", "line": {"color": "lightgray", "dash": "dot"}, "hoverinfo": "skip"})
plotly_html("csdr_constraints", _traces, {"title": "Adjoint of su(3) under SU(2) x U(1): hover a weight for its charges",
            "xaxis": {"title": "T_3", "range": [-1.4, 1.4], "zeroline": False}, "yaxis": {"title": "Y_n = lambda_8 / 2", "range": [-1.1, 1.1], "scaleanchor": "x", "zeroline": False},
            "legend": {"orientation": "h", "y": -0.2}})
print("wrote figures/interactive/csdr_constraints.html")
