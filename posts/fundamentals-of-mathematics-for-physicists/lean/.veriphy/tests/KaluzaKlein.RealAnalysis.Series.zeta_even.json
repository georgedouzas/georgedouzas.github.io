 "∀ (k : ℕ),\n  1 ≤ k →\n    HasSum (fun n => 1 / ↑n ^ (2 * k))\n      ((-1) ^ (k + 1) * 2 ^ (2 * k - 1) * π ^ (2 * k) * ↑(bernoulli (2 * k)) / ↑(2 * k)!)",
 "seed": 0,
