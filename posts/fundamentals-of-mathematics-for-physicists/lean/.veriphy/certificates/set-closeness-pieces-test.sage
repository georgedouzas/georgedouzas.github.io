# name: set-closeness-pieces-test
# technique: test fallback (test_fallback recipe): instances the kernel checks, chosen by hand
# goal: sage_test KaluzaKlein.Sets.Equivalence.closeness_two_pieces
# description: the claim at the instances below, each proved independently of the claim
SEED = 0
CASES = [
    (['0', '5', '(by norm_num)', '1/2', '11/2', '(Or.inl (by norm_num))', '(Or.inr (by norm_num))'], True, 'set_option maxHeartbeats 2000000 in\nhave key : ∀ (a b : ℝ) (hab : a + 2 < b) (x y : ℝ) (hx : x ∈ Set.Ioo a (a + 1) ∪ Set.Ioo b (b + 1)) (hy : y ∈ Set.Ioo a (a + 1) ∪ Set.Ioo b (b + 1)), Relation.EqvGen (fun p q : ↥(Set.Ioo a (a + 1) ∪ Set.Ioo b (b + 1)) => |(p : ℝ) - (q : ℝ)| < 1) ⟨x, hx⟩ ⟨y, hy⟩ ↔ (x < a + 1 ↔ y < a + 1) := by\n  intro a b hab x y hx hy\n  have key : ∀ p q : ↥(Set.Ioo a (a + 1) ∪ Set.Ioo b (b + 1)),\n      Relation.EqvGen (fun p q : ↥(Set.Ioo a (a + 1) ∪ Set.Ioo b (b + 1)) => |(p : ℝ) - (q : ℝ)| < 1) p q →\n        ((p : ℝ) < a + 1 ↔ (q : ℝ) < a + 1) := by\n    intro p q hpq\n    induction hpq with\n    | rel p q hpq =>\n      obtain ⟨p, hp⟩ := p\n      obtain ⟨q, hq⟩ := q\n      simp only at hpq ⊢\n      rw [abs_lt] at hpq\n      rcases hp with hp | hp <;> rcases hq with hq | hq <;>\n        simp only [Set.mem_Ioo] at hp hq <;> constructor <;> intro <;> linarith\n    | refl => exact Iff.rfl\n    | symm _ _ _ ih => exact ih.symm\n    | trans _ _ _ _ _ ih1 ih2 => exact ih1.trans ih2\n  constructor\n  · intro h\n    exact key _ _ h\n  · intro h\n    apply Relation.EqvGen.rel\n    simp only\n    rw [abs_lt]\n    rcases hx with hx | hx <;> rcases hy with hy | hy <;> simp only [Set.mem_Ioo] at hx hy\n    · constructor <;> linarith\n    · exact absurd (h.1 hx.2) (by linarith)\n    · exact absurd (h.2 hy.2) (by linarith)\n    · constructor <;> linarith\nexact @key (0) (5) ((by norm_num)) (1/2) (11/2) ((Or.inl (by norm_num))) ((Or.inr (by norm_num)))'),
    (['0', '5', '(by norm_num)', '1/4', '3/4', '(Or.inl (by norm_num))', '(Or.inl (by norm_num))'], False, 'set_option maxHeartbeats 2000000 in\nhave key : ∀ (a b : ℝ) (hab : a + 2 < b) (x y : ℝ) (hx : x ∈ Set.Ioo a (a + 1) ∪ Set.Ioo b (b + 1)) (hy : y ∈ Set.Ioo a (a + 1) ∪ Set.Ioo b (b + 1)), Relation.EqvGen (fun p q : ↥(Set.Ioo a (a + 1) ∪ Set.Ioo b (b + 1)) => |(p : ℝ) - (q : ℝ)| < 1) ⟨x, hx⟩ ⟨y, hy⟩ ↔ (x < a + 1 ↔ y < a + 1) := by\n  intro a b hab x y hx hy\n  have key : ∀ p q : ↥(Set.Ioo a (a + 1) ∪ Set.Ioo b (b + 1)),\n      Relation.EqvGen (fun p q : ↥(Set.Ioo a (a + 1) ∪ Set.Ioo b (b + 1)) => |(p : ℝ) - (q : ℝ)| < 1) p q →\n        ((p : ℝ) < a + 1 ↔ (q : ℝ) < a + 1) := by\n    intro p q hpq\n    induction hpq with\n    | rel p q hpq =>\n      obtain ⟨p, hp⟩ := p\n      obtain ⟨q, hq⟩ := q\n      simp only at hpq ⊢\n      rw [abs_lt] at hpq\n      rcases hp with hp | hp <;> rcases hq with hq | hq <;>\n        simp only [Set.mem_Ioo] at hp hq <;> constructor <;> intro <;> linarith\n    | refl => exact Iff.rfl\n    | symm _ _ _ ih => exact ih.symm\n    | trans _ _ _ _ _ ih1 ih2 => exact ih1.trans ih2\n  constructor\n  · intro h\n    exact key _ _ h\n  · intro h\n    apply Relation.EqvGen.rel\n    simp only\n    rw [abs_lt]\n    rcases hx with hx | hx <;> rcases hy with hy | hy <;> simp only [Set.mem_Ioo] at hx hy\n    · constructor <;> linarith\n    · exact absurd (h.1 hx.2) (by linarith)\n    · exact absurd (h.2 hy.2) (by linarith)\n    · constructor <;> linarith\nexact @key (0) (5) ((by norm_num)) (1/4) (3/4) ((Or.inl (by norm_num))) ((Or.inl (by norm_num)))'),
    (['-1', '3', '(by norm_num)', '7/2', '13/4', '(Or.inr (by norm_num))', '(Or.inr (by norm_num))'], False, 'set_option maxHeartbeats 2000000 in\nhave key : ∀ (a b : ℝ) (hab : a + 2 < b) (x y : ℝ) (hx : x ∈ Set.Ioo a (a + 1) ∪ Set.Ioo b (b + 1)) (hy : y ∈ Set.Ioo a (a + 1) ∪ Set.Ioo b (b + 1)), Relation.EqvGen (fun p q : ↥(Set.Ioo a (a + 1) ∪ Set.Ioo b (b + 1)) => |(p : ℝ) - (q : ℝ)| < 1) ⟨x, hx⟩ ⟨y, hy⟩ ↔ (x < a + 1 ↔ y < a + 1) := by\n  intro a b hab x y hx hy\n  have key : ∀ p q : ↥(Set.Ioo a (a + 1) ∪ Set.Ioo b (b + 1)),\n      Relation.EqvGen (fun p q : ↥(Set.Ioo a (a + 1) ∪ Set.Ioo b (b + 1)) => |(p : ℝ) - (q : ℝ)| < 1) p q →\n        ((p : ℝ) < a + 1 ↔ (q : ℝ) < a + 1) := by\n    intro p q hpq\n    induction hpq with\n    | rel p q hpq =>\n      obtain ⟨p, hp⟩ := p\n      obtain ⟨q, hq⟩ := q\n      simp only at hpq ⊢\n      rw [abs_lt] at hpq\n      rcases hp with hp | hp <;> rcases hq with hq | hq <;>\n        simp only [Set.mem_Ioo] at hp hq <;> constructor <;> intro <;> linarith\n    | refl => exact Iff.rfl\n    | symm _ _ _ ih => exact ih.symm\n    | trans _ _ _ _ _ ih1 ih2 => exact ih1.trans ih2\n  constructor\n  · intro h\n    exact key _ _ h\n  · intro h\n    apply Relation.EqvGen.rel\n    simp only\n    rw [abs_lt]\n    rcases hx with hx | hx <;> rcases hy with hy | hy <;> simp only [Set.mem_Ioo] at hx hy\n    · constructor <;> linarith\n    · exact absurd (h.1 hx.2) (by linarith)\n    · exact absurd (h.2 hy.2) (by linarith)\n    · constructor <;> linarith\nexact @key (-1) (3) ((by norm_num)) (7/2) (13/4) ((Or.inr (by norm_num))) ((Or.inr (by norm_num)))'),
]
instances = [kernel_instance(*values, proof=proof, edge=edge) for values, edge, proof in CASES]
