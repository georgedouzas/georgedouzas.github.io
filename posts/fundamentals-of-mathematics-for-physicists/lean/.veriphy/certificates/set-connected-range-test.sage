# name: set-connected-range-test
# technique: test fallback (test_fallback recipe): instances the kernel checks, chosen by hand
# goal: sage_test KaluzaKlein.Sets.Connected.connected_of_range
# description: the claim at the instances below, each proved independently of the claim
SEED = 0
CASES = [
    (['ℝ', 'ℝ × ℝ', 'inferInstance', 'inferInstance', 'inferInstance', '{p : ℝ × ℝ | p.1 ^ 2 + p.2 ^ 2 = 1 ^ 2}', 'fun φ => (1 * Real.cos φ, 1 * Real.sin φ)', '(by fun_prop)', '(KaluzaKlein.Sets.Maps.range_wrap 1 zero_le_one)'], False, 'set_option maxHeartbeats 2000000 in\nhave key : ∀ (X Y : Type) [inst1 : TopologicalSpace X] [inst2 : TopologicalSpace Y] [inst3 : ConnectedSpace X] (S : Set Y) (f : X → Y) (hf : Continuous f) (hS : range f = S), IsConnected S := by\n  intro X Y inst1 inst2 inst3 S f hf hS\n  exact (hS ▸ isConnected_range hf)\nexact @key (ℝ) (ℝ × ℝ) (inferInstance) (inferInstance) (inferInstance) ({p : ℝ × ℝ | p.1 ^ 2 + p.2 ^ 2 = 1 ^ 2}) (fun φ => (1 * Real.cos φ, 1 * Real.sin φ)) ((by fun_prop)) ((KaluzaKlein.Sets.Maps.range_wrap 1 zero_le_one))'),
    (['KaluzaKlein.Sets.Quotients.SO3t', 'Fin 3 → ℝ', 'inferInstance', 'inferInstance', 'inferInstance', 'KaluzaKlein.Sets.Sets.sphere', 'fun g => KaluzaKlein.Sets.Maps.orbit (g : Matrix (Fin 3) (Fin 3) ℝ)', '(continuous_subtype_val.matrix_mulVec continuous_const)', 'KaluzaKlein.Sets.Connected.range_orbit_SO3'], False, 'set_option maxHeartbeats 2000000 in\nhave key : ∀ (X Y : Type) [inst1 : TopologicalSpace X] [inst2 : TopologicalSpace Y] [inst3 : ConnectedSpace X] (S : Set Y) (f : X → Y) (hf : Continuous f) (hS : range f = S), IsConnected S := by\n  intro X Y inst1 inst2 inst3 S f hf hS\n  exact (hS ▸ isConnected_range hf)\nexact @key (KaluzaKlein.Sets.Quotients.SO3t) (Fin 3 → ℝ) (inferInstance) (inferInstance) (inferInstance) (KaluzaKlein.Sets.Sets.sphere) (fun g => KaluzaKlein.Sets.Maps.orbit (g : Matrix (Fin 3) (Fin 3) ℝ)) ((continuous_subtype_val.matrix_mulVec continuous_const)) (KaluzaKlein.Sets.Connected.range_orbit_SO3)'),
    (['ℝ × ℝ', '(ℝ × ℝ) × (ℝ × ℝ)', 'inferInstance', 'inferInstance', 'inferInstance', '{p : ℝ × ℝ | p.1 ^ 2 + p.2 ^ 2 = 1 ^ 2} ×ˢ {p : ℝ × ℝ | p.1 ^ 2 + p.2 ^ 2 = 1 ^ 2}', 'fun q : ℝ × ℝ => ((1 * Real.cos q.1, 1 * Real.sin q.1), (1 * Real.cos q.2, 1 * Real.sin q.2))', '(by fun_prop)', '(KaluzaKlein.Sets.Products.torus_pairs_of_angles 1 1 zero_le_one zero_le_one)'], False, 'set_option maxHeartbeats 2000000 in\nhave key : ∀ (X Y : Type) [inst1 : TopologicalSpace X] [inst2 : TopologicalSpace Y] [inst3 : ConnectedSpace X] (S : Set Y) (f : X → Y) (hf : Continuous f) (hS : range f = S), IsConnected S := by\n  intro X Y inst1 inst2 inst3 S f hf hS\n  exact (hS ▸ isConnected_range hf)\nexact @key (ℝ × ℝ) ((ℝ × ℝ) × (ℝ × ℝ)) (inferInstance) (inferInstance) (inferInstance) ({p : ℝ × ℝ | p.1 ^ 2 + p.2 ^ 2 = 1 ^ 2} ×ˢ {p : ℝ × ℝ | p.1 ^ 2 + p.2 ^ 2 = 1 ^ 2}) (fun q : ℝ × ℝ => ((1 * Real.cos q.1, 1 * Real.sin q.1), (1 * Real.cos q.2, 1 * Real.sin q.2))) ((by fun_prop)) ((KaluzaKlein.Sets.Products.torus_pairs_of_angles 1 1 zero_le_one zero_le_one))'),
    (['EuclideanSpace ℝ (Fin 2)', 'EuclideanSpace ℝ (Fin 2)', 'inferInstance', 'inferInstance', 'inferInstance', 'Set.univ', 'id', 'continuous_id', 'Set.range_id'], True, 'set_option maxHeartbeats 2000000 in\nhave key : ∀ (X Y : Type) [inst1 : TopologicalSpace X] [inst2 : TopologicalSpace Y] [inst3 : ConnectedSpace X] (S : Set Y) (f : X → Y) (hf : Continuous f) (hS : range f = S), IsConnected S := by\n  intro X Y inst1 inst2 inst3 S f hf hS\n  exact (hS ▸ isConnected_range hf)\nexact @key (EuclideanSpace ℝ (Fin 2)) (EuclideanSpace ℝ (Fin 2)) (inferInstance) (inferInstance) (inferInstance) (Set.univ) (id) (continuous_id) (Set.range_id)'),
]
instances = [kernel_instance(*values, proof=proof, edge=edge) for values, edge, proof in CASES]
