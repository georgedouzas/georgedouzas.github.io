# name: set-wrap-injon-test
# technique: test fallback (test_fallback recipe): instances the kernel checks, chosen by hand
# goal: sage_test KaluzaKlein.Sets.Injective.wrap_injOn
# description: the claim at the instances below, each proved independently of the claim
SEED = 0
CASES = [
    (['0'], True, "set_option maxHeartbeats 2000000 in\nhave key : ∀ (a : ℝ), Set.InjOn wrap (Set.Ioo a (a + 2 * Real.pi)) := by\n  intro a\n  intro s hs t ht hst\n  have h := wrap_preimage t\n  have hs' : s ∈ wrap ⁻¹' {wrap t} := hst\n  rw [h] at hs'\n  obtain ⟨k, hk⟩ := hs'\n  have hpi := Real.pi_pos\n  have hk1 : (k : ℝ) * (2 * Real.pi) < 2 * Real.pi := by linarith [hs.1, hs.2, ht.1, ht.2]\n  have hk2 : -(2 * Real.pi) < (k : ℝ) * (2 * Real.pi) := by linarith [hs.1, hs.2, ht.1, ht.2]\n  have hk3 : (k : ℝ) < 1 := by nlinarith\n  have hk4 : (-1 : ℝ) < k := by nlinarith\n  have : k = 0 := by\n    have h1 : k < 1 := by exact_mod_cast hk3\n    have h2 : -1 < k := by exact_mod_cast hk4\n    omega\n  subst this\n  simpa using hk\nexact @key (0)"),
    (['-Real.pi'], False, "set_option maxHeartbeats 2000000 in\nhave key : ∀ (a : ℝ), Set.InjOn wrap (Set.Ioo a (a + 2 * Real.pi)) := by\n  intro a\n  intro s hs t ht hst\n  have h := wrap_preimage t\n  have hs' : s ∈ wrap ⁻¹' {wrap t} := hst\n  rw [h] at hs'\n  obtain ⟨k, hk⟩ := hs'\n  have hpi := Real.pi_pos\n  have hk1 : (k : ℝ) * (2 * Real.pi) < 2 * Real.pi := by linarith [hs.1, hs.2, ht.1, ht.2]\n  have hk2 : -(2 * Real.pi) < (k : ℝ) * (2 * Real.pi) := by linarith [hs.1, hs.2, ht.1, ht.2]\n  have hk3 : (k : ℝ) < 1 := by nlinarith\n  have hk4 : (-1 : ℝ) < k := by nlinarith\n  have : k = 0 := by\n    have h1 : k < 1 := by exact_mod_cast hk3\n    have h2 : -1 < k := by exact_mod_cast hk4\n    omega\n  subst this\n  simpa using hk\nexact @key (-Real.pi)"),
    (['1'], False, "set_option maxHeartbeats 2000000 in\nhave key : ∀ (a : ℝ), Set.InjOn wrap (Set.Ioo a (a + 2 * Real.pi)) := by\n  intro a\n  intro s hs t ht hst\n  have h := wrap_preimage t\n  have hs' : s ∈ wrap ⁻¹' {wrap t} := hst\n  rw [h] at hs'\n  obtain ⟨k, hk⟩ := hs'\n  have hpi := Real.pi_pos\n  have hk1 : (k : ℝ) * (2 * Real.pi) < 2 * Real.pi := by linarith [hs.1, hs.2, ht.1, ht.2]\n  have hk2 : -(2 * Real.pi) < (k : ℝ) * (2 * Real.pi) := by linarith [hs.1, hs.2, ht.1, ht.2]\n  have hk3 : (k : ℝ) < 1 := by nlinarith\n  have hk4 : (-1 : ℝ) < k := by nlinarith\n  have : k = 0 := by\n    have h1 : k < 1 := by exact_mod_cast hk3\n    have h2 : -1 < k := by exact_mod_cast hk4\n    omega\n  subst this\n  simpa using hk\nexact @key (1)"),
]
instances = [kernel_instance(*values, proof=proof, edge=edge) for values, edge, proof in CASES]
