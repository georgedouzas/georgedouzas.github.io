# name: set-infinite-inter-test
# technique: test fallback (test_fallback recipe): instances the kernel checks, chosen by hand
# goal: sage_test KaluzaKlein.Sets.OpenSets.infinite_inter_not_open
# description: the claim at the instances below, each proved independently of the claim
SEED = 0
CASES = [
    (['1', '(by norm_num)'], True, "set_option maxHeartbeats 2000000 in\nhave key : ∀ (c : ℝ) (hc : 0 < c), (⋂ n : ℕ, Ioo (-c / (n + 1)) (c / (n + 1))) = {0} ∧ ¬ IsOpen ({0} : Set ℝ) := by\n  intro c hc\n  refine ⟨?_, not_isOpen_singleton 0⟩\n  ext x\n  simp only [mem_iInter, mem_Ioo, mem_singleton_iff]\n  constructor\n  · intro h\n    by_contra hx\n    obtain ⟨n, hn⟩ := exists_nat_gt (c / |x|)\n    have hx' : 0 < |x| := abs_pos.2 hx\n    have h1 := h n\n    have h2 : c / (n + 1) < |x| := by\n      rw [div_lt_iff₀ (by positivity)]\n      rw [div_lt_iff₀ hx'] at hn\n      nlinarith\n    rw [neg_div] at h1\n    rcases abs_cases x with ⟨h3, -⟩ | ⟨h3, -⟩ <;> rw [h3] at h2 <;> linarith [h1.1, h1.2]\n  · rintro rfl n\n    exact ⟨by rw [neg_div]; exact neg_lt_zero.2 (by positivity), by positivity⟩\nexact @key (1) ((by norm_num))"),
    (['2', '(by norm_num)'], False, "set_option maxHeartbeats 2000000 in\nhave key : ∀ (c : ℝ) (hc : 0 < c), (⋂ n : ℕ, Ioo (-c / (n + 1)) (c / (n + 1))) = {0} ∧ ¬ IsOpen ({0} : Set ℝ) := by\n  intro c hc\n  refine ⟨?_, not_isOpen_singleton 0⟩\n  ext x\n  simp only [mem_iInter, mem_Ioo, mem_singleton_iff]\n  constructor\n  · intro h\n    by_contra hx\n    obtain ⟨n, hn⟩ := exists_nat_gt (c / |x|)\n    have hx' : 0 < |x| := abs_pos.2 hx\n    have h1 := h n\n    have h2 : c / (n + 1) < |x| := by\n      rw [div_lt_iff₀ (by positivity)]\n      rw [div_lt_iff₀ hx'] at hn\n      nlinarith\n    rw [neg_div] at h1\n    rcases abs_cases x with ⟨h3, -⟩ | ⟨h3, -⟩ <;> rw [h3] at h2 <;> linarith [h1.1, h1.2]\n  · rintro rfl n\n    exact ⟨by rw [neg_div]; exact neg_lt_zero.2 (by positivity), by positivity⟩\nexact @key (2) ((by norm_num))"),
    (['1/2', '(by norm_num)'], False, "set_option maxHeartbeats 2000000 in\nhave key : ∀ (c : ℝ) (hc : 0 < c), (⋂ n : ℕ, Ioo (-c / (n + 1)) (c / (n + 1))) = {0} ∧ ¬ IsOpen ({0} : Set ℝ) := by\n  intro c hc\n  refine ⟨?_, not_isOpen_singleton 0⟩\n  ext x\n  simp only [mem_iInter, mem_Ioo, mem_singleton_iff]\n  constructor\n  · intro h\n    by_contra hx\n    obtain ⟨n, hn⟩ := exists_nat_gt (c / |x|)\n    have hx' : 0 < |x| := abs_pos.2 hx\n    have h1 := h n\n    have h2 : c / (n + 1) < |x| := by\n      rw [div_lt_iff₀ (by positivity)]\n      rw [div_lt_iff₀ hx'] at hn\n      nlinarith\n    rw [neg_div] at h1\n    rcases abs_cases x with ⟨h3, -⟩ | ⟨h3, -⟩ <;> rw [h3] at h2 <;> linarith [h1.1, h1.2]\n  · rintro rfl n\n    exact ⟨by rw [neg_div]; exact neg_lt_zero.2 (by positivity), by positivity⟩\nexact @key (1/2) ((by norm_num))"),
]
instances = [kernel_instance(*values, proof=proof, edge=edge) for values, edge, proof in CASES]
