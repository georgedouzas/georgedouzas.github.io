# name: set-corners-test
# technique: test fallback (test_fallback recipe): instances the kernel checks, chosen by hand
# goal: sage_test KaluzaKlein.Sets.Quotients.corners_one_class
# description: the claim at the instances below, each proved independently of the claim
SEED = 0
CASES = [
    (['(0, 0)', '(1, 1)', '(by norm_num)', '(by norm_num)'], False, "set_option maxHeartbeats 2000000 in\nhave key : ∀ (c c' : ℝ × ℝ) (hc : (c.1 = 0 ∨ c.1 = 1) ∧ (c.2 = 0 ∨ c.2 = 1)) (hc' : (c'.1 = 0 ∨ c'.1 = 1) ∧ (c'.2 = 0 ∨ c'.2 = 1)), Relation.EqvGen (glue 1) c c' := by\n  intro c c' hc hc'\n  have hsq : ∀ x : ℝ × ℝ, (x.1 = 0 ∨ x.1 = 1) ∧ (x.2 = 0 ∨ x.2 = 1) → x ∈ square 1 := by\n    rintro ⟨a, b⟩ ⟨ha, hb⟩\n    simp only [square, Set.mem_prod, Set.mem_Icc]\n    simp only at ha hb\n    rcases ha with rfl | rfl <;> rcases hb with rfl | rfl <;> norm_num\n  rw [glue_eqvGen_iff 1 one_pos c c' (hsq c hc) (hsq c' hc'), κ_eq_iff 1 _ _ one_pos, κ_eq_iff 1 _ _ one_pos]\n  obtain ⟨a, b⟩ := c\n  obtain ⟨a', b'⟩ := c'\n  simp only at hc hc' ⊢\n  obtain ⟨h1 | h1, h2 | h2⟩ := hc <;> obtain ⟨h3 | h3, h4 | h4⟩ := hc' <;> subst_vars <;> norm_num\nexact @key ((0, 0)) ((1, 1)) ((by norm_num)) ((by norm_num))"),
    (['(0, 0)', '(0, 0)', '(by norm_num)', '(by norm_num)'], True, "set_option maxHeartbeats 2000000 in\nhave key : ∀ (c c' : ℝ × ℝ) (hc : (c.1 = 0 ∨ c.1 = 1) ∧ (c.2 = 0 ∨ c.2 = 1)) (hc' : (c'.1 = 0 ∨ c'.1 = 1) ∧ (c'.2 = 0 ∨ c'.2 = 1)), Relation.EqvGen (glue 1) c c' := by\n  intro c c' hc hc'\n  have hsq : ∀ x : ℝ × ℝ, (x.1 = 0 ∨ x.1 = 1) ∧ (x.2 = 0 ∨ x.2 = 1) → x ∈ square 1 := by\n    rintro ⟨a, b⟩ ⟨ha, hb⟩\n    simp only [square, Set.mem_prod, Set.mem_Icc]\n    simp only at ha hb\n    rcases ha with rfl | rfl <;> rcases hb with rfl | rfl <;> norm_num\n  rw [glue_eqvGen_iff 1 one_pos c c' (hsq c hc) (hsq c' hc'), κ_eq_iff 1 _ _ one_pos, κ_eq_iff 1 _ _ one_pos]\n  obtain ⟨a, b⟩ := c\n  obtain ⟨a', b'⟩ := c'\n  simp only at hc hc' ⊢\n  obtain ⟨h1 | h1, h2 | h2⟩ := hc <;> obtain ⟨h3 | h3, h4 | h4⟩ := hc' <;> subst_vars <;> norm_num\nexact @key ((0, 0)) ((0, 0)) ((by norm_num)) ((by norm_num))"),
    (['(1, 0)', '(0, 1)', '(by norm_num)', '(by norm_num)'], False, "set_option maxHeartbeats 2000000 in\nhave key : ∀ (c c' : ℝ × ℝ) (hc : (c.1 = 0 ∨ c.1 = 1) ∧ (c.2 = 0 ∨ c.2 = 1)) (hc' : (c'.1 = 0 ∨ c'.1 = 1) ∧ (c'.2 = 0 ∨ c'.2 = 1)), Relation.EqvGen (glue 1) c c' := by\n  intro c c' hc hc'\n  have hsq : ∀ x : ℝ × ℝ, (x.1 = 0 ∨ x.1 = 1) ∧ (x.2 = 0 ∨ x.2 = 1) → x ∈ square 1 := by\n    rintro ⟨a, b⟩ ⟨ha, hb⟩\n    simp only [square, Set.mem_prod, Set.mem_Icc]\n    simp only at ha hb\n    rcases ha with rfl | rfl <;> rcases hb with rfl | rfl <;> norm_num\n  rw [glue_eqvGen_iff 1 one_pos c c' (hsq c hc) (hsq c' hc'), κ_eq_iff 1 _ _ one_pos, κ_eq_iff 1 _ _ one_pos]\n  obtain ⟨a, b⟩ := c\n  obtain ⟨a', b'⟩ := c'\n  simp only at hc hc' ⊢\n  obtain ⟨h1 | h1, h2 | h2⟩ := hc <;> obtain ⟨h3 | h3, h4 | h4⟩ := hc' <;> subst_vars <;> norm_num\nexact @key ((1, 0)) ((0, 1)) ((by norm_num)) ((by norm_num))"),
]
instances = [kernel_instance(*values, proof=proof, edge=edge) for values, edge, proof in CASES]
