# name: set-finite-map-four-test
# technique: test fallback (test_fallback recipe): instances the kernel checks, chosen by hand
# goal: sage_test KaluzaKlein.Sets.Maps.finite_map_four
# description: the claim at the instances below, each proved independently of the claim
SEED = 0
CASES = [
    (['Fin 3', '0', '1', '2', '(by decide)', '(by decide)', '(by decide)'], True, "set_option maxHeartbeats 2000000 in\nhave key : ∀ {β : Type} (a b c : β) (hab : a ≠ b) (hac : a ≠ c) (hbc : b ≠ c), Set.range ![a, c, a, a] = {a, c} ∧ ![a, c, a, a] ⁻¹' {a} = {0, 2, 3} ∧ ![a, c, a, a] ⁻¹' {b} = ∅ ∧ ![a, c, a, a] ⁻¹' {a, c} = Set.univ := by\n  intro β a b c hab hac hbc\n  refine ⟨?_, ?_, ?_, ?_⟩\n  · ext z\n    simp only [Set.mem_range, Set.mem_insert_iff, Set.mem_singleton_iff]\n    constructor\n    · rintro ⟨i, rfl⟩; fin_cases i <;> simp\n    · rintro (rfl | rfl)\n      · exact ⟨0, rfl⟩\n      · exact ⟨1, rfl⟩\n  · ext i; fin_cases i <;> simp [hac.symm]\n  · ext i; fin_cases i <;> simp [hab, hbc.symm]\n  · ext i; fin_cases i <;> simp\nexact @key (Fin 3) (0) (1) (2) ((by decide)) ((by decide)) ((by decide))"),
    (['ℕ', '1', '2', '3', '(by decide)', '(by decide)', '(by decide)'], False, "set_option maxHeartbeats 2000000 in\nhave key : ∀ {β : Type} (a b c : β) (hab : a ≠ b) (hac : a ≠ c) (hbc : b ≠ c), Set.range ![a, c, a, a] = {a, c} ∧ ![a, c, a, a] ⁻¹' {a} = {0, 2, 3} ∧ ![a, c, a, a] ⁻¹' {b} = ∅ ∧ ![a, c, a, a] ⁻¹' {a, c} = Set.univ := by\n  intro β a b c hab hac hbc\n  refine ⟨?_, ?_, ?_, ?_⟩\n  · ext z\n    simp only [Set.mem_range, Set.mem_insert_iff, Set.mem_singleton_iff]\n    constructor\n    · rintro ⟨i, rfl⟩; fin_cases i <;> simp\n    · rintro (rfl | rfl)\n      · exact ⟨0, rfl⟩\n      · exact ⟨1, rfl⟩\n  · ext i; fin_cases i <;> simp [hac.symm]\n  · ext i; fin_cases i <;> simp [hab, hbc.symm]\n  · ext i; fin_cases i <;> simp\nexact @key (ℕ) (1) (2) (3) ((by decide)) ((by decide)) ((by decide))"),
    (['Char', "'a'", "'b'", "'c'", '(by decide)', '(by decide)', '(by decide)'], False, "set_option maxHeartbeats 2000000 in\nhave key : ∀ {β : Type} (a b c : β) (hab : a ≠ b) (hac : a ≠ c) (hbc : b ≠ c), Set.range ![a, c, a, a] = {a, c} ∧ ![a, c, a, a] ⁻¹' {a} = {0, 2, 3} ∧ ![a, c, a, a] ⁻¹' {b} = ∅ ∧ ![a, c, a, a] ⁻¹' {a, c} = Set.univ := by\n  intro β a b c hab hac hbc\n  refine ⟨?_, ?_, ?_, ?_⟩\n  · ext z\n    simp only [Set.mem_range, Set.mem_insert_iff, Set.mem_singleton_iff]\n    constructor\n    · rintro ⟨i, rfl⟩; fin_cases i <;> simp\n    · rintro (rfl | rfl)\n      · exact ⟨0, rfl⟩\n      · exact ⟨1, rfl⟩\n  · ext i; fin_cases i <;> simp [hac.symm]\n  · ext i; fin_cases i <;> simp [hab, hbc.symm]\n  · ext i; fin_cases i <;> simp\nexact @key (Char) ('a') ('b') ('c') ((by decide)) ((by decide)) ((by decide))"),
]
instances = [kernel_instance(*values, proof=proof, edge=edge) for values, edge, proof in CASES]
