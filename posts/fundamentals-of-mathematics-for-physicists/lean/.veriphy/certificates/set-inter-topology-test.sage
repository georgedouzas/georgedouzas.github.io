# name: set-inter-topology-test
# technique: test fallback (test_fallback recipe): instances the kernel checks, chosen by hand
# goal: sage_test KaluzaKlein.Sets.TopologicalSpaces.inter_isTopologyOn
# description: the claim at the instances below, each proved independently of the claim
SEED = 0
CASES = [
    (['Fin 2', 'Set.univ', '{∅, Set.univ}', '(KaluzaKlein.Sets.TopologicalSpaces.discrete_indiscrete _).1', '(KaluzaKlein.Sets.TopologicalSpaces.discrete_indiscrete _).2'], False, 'set_option maxHeartbeats 2000000 in\nhave key : ∀ (X : Type) (O₁ O₂ : Set (Set X)) (h₁ : IsTopologyOn X O₁) (h₂ : IsTopologyOn X O₂), IsTopologyOn X (O₁ ∩ O₂) := by\n  intro X O₁ O₂ h₁ h₂\n  exact (⟨⟨h₁.1, h₂.1⟩, ⟨h₁.2.1, h₂.2.1⟩, fun U V hU hV => ⟨h₁.2.2.1 U V hU.1 hV.1, h₂.2.2.1 U V hU.2 hV.2⟩,\n    fun S hS => ⟨h₁.2.2.2 S (fun _ h => (hS h).1), h₂.2.2.2 S (fun _ h => (hS h).2)⟩⟩)\nexact @key (Fin 2) (Set.univ) ({∅, Set.univ}) ((KaluzaKlein.Sets.TopologicalSpaces.discrete_indiscrete _).1) ((KaluzaKlein.Sets.TopologicalSpaces.discrete_indiscrete _).2)'),
    (['Fin 2', 'Set.univ', 'Set.univ', '(KaluzaKlein.Sets.TopologicalSpaces.discrete_indiscrete _).1', '(KaluzaKlein.Sets.TopologicalSpaces.discrete_indiscrete _).1'], True, 'set_option maxHeartbeats 2000000 in\nhave key : ∀ (X : Type) (O₁ O₂ : Set (Set X)) (h₁ : IsTopologyOn X O₁) (h₂ : IsTopologyOn X O₂), IsTopologyOn X (O₁ ∩ O₂) := by\n  intro X O₁ O₂ h₁ h₂\n  exact (⟨⟨h₁.1, h₂.1⟩, ⟨h₁.2.1, h₂.2.1⟩, fun U V hU hV => ⟨h₁.2.2.1 U V hU.1 hV.1, h₂.2.2.1 U V hU.2 hV.2⟩,\n    fun S hS => ⟨h₁.2.2.2 S (fun _ h => (hS h).1), h₂.2.2.2 S (fun _ h => (hS h).2)⟩⟩)\nexact @key (Fin 2) (Set.univ) (Set.univ) ((KaluzaKlein.Sets.TopologicalSpaces.discrete_indiscrete _).1) ((KaluzaKlein.Sets.TopologicalSpaces.discrete_indiscrete _).1)'),
    (['ℕ', '{∅, Set.univ}', 'Set.univ', '(KaluzaKlein.Sets.TopologicalSpaces.discrete_indiscrete _).2', '(KaluzaKlein.Sets.TopologicalSpaces.discrete_indiscrete _).1'], False, 'set_option maxHeartbeats 2000000 in\nhave key : ∀ (X : Type) (O₁ O₂ : Set (Set X)) (h₁ : IsTopologyOn X O₁) (h₂ : IsTopologyOn X O₂), IsTopologyOn X (O₁ ∩ O₂) := by\n  intro X O₁ O₂ h₁ h₂\n  exact (⟨⟨h₁.1, h₂.1⟩, ⟨h₁.2.1, h₂.2.1⟩, fun U V hU hV => ⟨h₁.2.2.1 U V hU.1 hV.1, h₂.2.2.1 U V hU.2 hV.2⟩,\n    fun S hS => ⟨h₁.2.2.2 S (fun _ h => (hS h).1), h₂.2.2.2 S (fun _ h => (hS h).2)⟩⟩)\nexact @key (ℕ) ({∅, Set.univ}) (Set.univ) ((KaluzaKlein.Sets.TopologicalSpaces.discrete_indiscrete _).2) ((KaluzaKlein.Sets.TopologicalSpaces.discrete_indiscrete _).1)'),
]
instances = [kernel_instance(*values, proof=proof, edge=edge) for values, edge, proof in CASES]
