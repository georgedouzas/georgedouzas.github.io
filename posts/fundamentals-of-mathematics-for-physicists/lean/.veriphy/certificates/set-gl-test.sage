# name: set-gl-test
# technique: test fallback (test_fallback recipe): instances the kernel checks, chosen by hand
# goal: sage_test KaluzaKlein.Sets.Connected.GL_not_connected
# description: the claim at the instances below, each proved independently of the claim
SEED = 0
CASES = [
    (['1', '(by norm_num)'], True, "set_option maxHeartbeats 2000000 in\nhave key : ∀ (n : ℕ) (hn : 1 ≤ n), ¬ IsPreconnected {A : Matrix (Fin n) (Fin n) ℝ | A.det ≠ 0} := by\n  intro n hn\n  intro h\n  have hc : Continuous (fun A : Matrix (Fin n) (Fin n) ℝ => A.det) := continuous_id.matrix_det\n  set D : Matrix (Fin n) (Fin n) ℝ := Matrix.diagonal (fun i => if i.val = 0 then -1 else 1)\n  have hD : D.det = -1 := by\n    rw [Matrix.det_diagonal]\n    rw [Finset.prod_eq_single (⟨0, hn⟩ : Fin n)]\n    · simp\n    · intro b _ hb\n      have : b.val ≠ 0 := fun h' => hb (Fin.ext h')\n      simp [this]\n    · simp\n  obtain ⟨A, -, hA1, hA2⟩ := h {A | 0 < A.det} {A | A.det < 0} (isOpen_lt continuous_const hc)\n    (isOpen_lt hc continuous_const)\n    (fun A hA => by\n      rcases lt_or_gt_of_ne hA with h' | h'\n      · right; exact h'\n      · left; exact h')\n    ⟨1, by simp, by simp⟩ ⟨D, by simp [hD], by simp [hD]⟩\n  simp only [mem_setOf_eq] at hA1 hA2\n  linarith\nexact @key (1) ((by norm_num))"),
    (['2', '(by norm_num)'], False, "set_option maxHeartbeats 2000000 in\nhave key : ∀ (n : ℕ) (hn : 1 ≤ n), ¬ IsPreconnected {A : Matrix (Fin n) (Fin n) ℝ | A.det ≠ 0} := by\n  intro n hn\n  intro h\n  have hc : Continuous (fun A : Matrix (Fin n) (Fin n) ℝ => A.det) := continuous_id.matrix_det\n  set D : Matrix (Fin n) (Fin n) ℝ := Matrix.diagonal (fun i => if i.val = 0 then -1 else 1)\n  have hD : D.det = -1 := by\n    rw [Matrix.det_diagonal]\n    rw [Finset.prod_eq_single (⟨0, hn⟩ : Fin n)]\n    · simp\n    · intro b _ hb\n      have : b.val ≠ 0 := fun h' => hb (Fin.ext h')\n      simp [this]\n    · simp\n  obtain ⟨A, -, hA1, hA2⟩ := h {A | 0 < A.det} {A | A.det < 0} (isOpen_lt continuous_const hc)\n    (isOpen_lt hc continuous_const)\n    (fun A hA => by\n      rcases lt_or_gt_of_ne hA with h' | h'\n      · right; exact h'\n      · left; exact h')\n    ⟨1, by simp, by simp⟩ ⟨D, by simp [hD], by simp [hD]⟩\n  simp only [mem_setOf_eq] at hA1 hA2\n  linarith\nexact @key (2) ((by norm_num))"),
    (['3', '(by norm_num)'], False, "set_option maxHeartbeats 2000000 in\nhave key : ∀ (n : ℕ) (hn : 1 ≤ n), ¬ IsPreconnected {A : Matrix (Fin n) (Fin n) ℝ | A.det ≠ 0} := by\n  intro n hn\n  intro h\n  have hc : Continuous (fun A : Matrix (Fin n) (Fin n) ℝ => A.det) := continuous_id.matrix_det\n  set D : Matrix (Fin n) (Fin n) ℝ := Matrix.diagonal (fun i => if i.val = 0 then -1 else 1)\n  have hD : D.det = -1 := by\n    rw [Matrix.det_diagonal]\n    rw [Finset.prod_eq_single (⟨0, hn⟩ : Fin n)]\n    · simp\n    · intro b _ hb\n      have : b.val ≠ 0 := fun h' => hb (Fin.ext h')\n      simp [this]\n    · simp\n  obtain ⟨A, -, hA1, hA2⟩ := h {A | 0 < A.det} {A | A.det < 0} (isOpen_lt continuous_const hc)\n    (isOpen_lt hc continuous_const)\n    (fun A hA => by\n      rcases lt_or_gt_of_ne hA with h' | h'\n      · right; exact h'\n      · left; exact h')\n    ⟨1, by simp, by simp⟩ ⟨D, by simp [hD], by simp [hD]⟩\n  simp only [mem_setOf_eq] at hA1 hA2\n  linarith\nexact @key (3) ((by norm_num))"),
]
instances = [kernel_instance(*values, proof=proof, edge=edge) for values, edge, proof in CASES]
