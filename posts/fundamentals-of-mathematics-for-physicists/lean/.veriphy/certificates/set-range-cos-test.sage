# name: set-range-cos-test
# technique: test fallback (test_fallback recipe): instances the kernel checks, chosen by hand
# goal: sage_test KaluzaKlein.Sets.Maps.range_mul_cos
# description: the claim at the instances below, each proved independently of the claim
SEED = 0
CASES = [
    (['1', '(by norm_num)'], True, "set_option maxHeartbeats 2000000 in\nhave key : ∀ (a : ℝ) (ha : 0 ≤ a), Set.range (fun x => a * Real.cos x) = Set.Icc (-a) a := by\n  intro a ha\n  ext y\n  simp only [Set.mem_range, Set.mem_Icc]\n  constructor\n  · rintro ⟨x, rfl⟩\n    constructor <;> nlinarith [Real.neg_one_le_cos x, Real.cos_le_one x]\n  · rintro ⟨h1, h2⟩\n    rcases eq_or_lt_of_le ha with rfl | ha'\n    · exact ⟨0, by linarith⟩\n    · obtain ⟨x, -, hx⟩ := Real.bijOn_cos.surjOn\n        (show y / a ∈ Set.Icc (-1 : ℝ) 1 from ⟨by rw [le_div_iff₀ ha']; linarith,\n          by rw [div_le_iff₀ ha']; linarith⟩)\n      exact ⟨x, by rw [hx]; field_simp⟩\nexact @key (1) ((by norm_num))"),
    (['0', '(by norm_num)'], False, "set_option maxHeartbeats 2000000 in\nhave key : ∀ (a : ℝ) (ha : 0 ≤ a), Set.range (fun x => a * Real.cos x) = Set.Icc (-a) a := by\n  intro a ha\n  ext y\n  simp only [Set.mem_range, Set.mem_Icc]\n  constructor\n  · rintro ⟨x, rfl⟩\n    constructor <;> nlinarith [Real.neg_one_le_cos x, Real.cos_le_one x]\n  · rintro ⟨h1, h2⟩\n    rcases eq_or_lt_of_le ha with rfl | ha'\n    · exact ⟨0, by linarith⟩\n    · obtain ⟨x, -, hx⟩ := Real.bijOn_cos.surjOn\n        (show y / a ∈ Set.Icc (-1 : ℝ) 1 from ⟨by rw [le_div_iff₀ ha']; linarith,\n          by rw [div_le_iff₀ ha']; linarith⟩)\n      exact ⟨x, by rw [hx]; field_simp⟩\nexact @key (0) ((by norm_num))"),
    (['2', '(by norm_num)'], False, "set_option maxHeartbeats 2000000 in\nhave key : ∀ (a : ℝ) (ha : 0 ≤ a), Set.range (fun x => a * Real.cos x) = Set.Icc (-a) a := by\n  intro a ha\n  ext y\n  simp only [Set.mem_range, Set.mem_Icc]\n  constructor\n  · rintro ⟨x, rfl⟩\n    constructor <;> nlinarith [Real.neg_one_le_cos x, Real.cos_le_one x]\n  · rintro ⟨h1, h2⟩\n    rcases eq_or_lt_of_le ha with rfl | ha'\n    · exact ⟨0, by linarith⟩\n    · obtain ⟨x, -, hx⟩ := Real.bijOn_cos.surjOn\n        (show y / a ∈ Set.Icc (-1 : ℝ) 1 from ⟨by rw [le_div_iff₀ ha']; linarith,\n          by rw [div_le_iff₀ ha']; linarith⟩)\n      exact ⟨x, by rw [hx]; field_simp⟩\nexact @key (2) ((by norm_num))"),
]
instances = [kernel_instance(*values, proof=proof, edge=edge) for values, edge, proof in CASES]
