# name: set-range-wrap-test
# technique: test fallback (test_fallback recipe): instances the kernel checks, chosen by hand
# goal: sage_test KaluzaKlein.Sets.Maps.range_wrap
# description: the claim at the instances below, each proved independently of the claim
SEED = 0
CASES = [
    (['1', '(by norm_num)'], True, 'set_option maxHeartbeats 2000000 in\nhave key : ∀ (r : ℝ) (hr : 0 ≤ r), Set.range (fun φ => (r * Real.cos φ, r * Real.sin φ)) = {p : ℝ × ℝ | p.1 ^ 2 + p.2 ^ 2 = r ^ 2} := by\n  intro r hr\n  ext ⟨x, y⟩\n  simp only [Set.mem_range, Set.mem_setOf_eq, Prod.mk.injEq]\n  constructor\n  · rintro ⟨φ, rfl, rfl⟩\n    nlinarith [Real.sin_sq_add_cos_sq φ]\n  · intro h\n    set z : ℂ := ⟨x, y⟩\n    have hz : ‖z‖ = r := by\n      rw [Complex.norm_def, Complex.normSq_mk, ← Real.sqrt_sq hr]\n      congr 1; nlinarith\n    refine ⟨Complex.arg z, ?_, ?_⟩\n    · rw [← hz, Complex.norm_mul_cos_arg]\n    · rw [← hz, Complex.norm_mul_sin_arg]\nexact @key (1) ((by norm_num))'),
    (['0', '(by norm_num)'], False, 'set_option maxHeartbeats 2000000 in\nhave key : ∀ (r : ℝ) (hr : 0 ≤ r), Set.range (fun φ => (r * Real.cos φ, r * Real.sin φ)) = {p : ℝ × ℝ | p.1 ^ 2 + p.2 ^ 2 = r ^ 2} := by\n  intro r hr\n  ext ⟨x, y⟩\n  simp only [Set.mem_range, Set.mem_setOf_eq, Prod.mk.injEq]\n  constructor\n  · rintro ⟨φ, rfl, rfl⟩\n    nlinarith [Real.sin_sq_add_cos_sq φ]\n  · intro h\n    set z : ℂ := ⟨x, y⟩\n    have hz : ‖z‖ = r := by\n      rw [Complex.norm_def, Complex.normSq_mk, ← Real.sqrt_sq hr]\n      congr 1; nlinarith\n    refine ⟨Complex.arg z, ?_, ?_⟩\n    · rw [← hz, Complex.norm_mul_cos_arg]\n    · rw [← hz, Complex.norm_mul_sin_arg]\nexact @key (0) ((by norm_num))'),
    (['3', '(by norm_num)'], False, 'set_option maxHeartbeats 2000000 in\nhave key : ∀ (r : ℝ) (hr : 0 ≤ r), Set.range (fun φ => (r * Real.cos φ, r * Real.sin φ)) = {p : ℝ × ℝ | p.1 ^ 2 + p.2 ^ 2 = r ^ 2} := by\n  intro r hr\n  ext ⟨x, y⟩\n  simp only [Set.mem_range, Set.mem_setOf_eq, Prod.mk.injEq]\n  constructor\n  · rintro ⟨φ, rfl, rfl⟩\n    nlinarith [Real.sin_sq_add_cos_sq φ]\n  · intro h\n    set z : ℂ := ⟨x, y⟩\n    have hz : ‖z‖ = r := by\n      rw [Complex.norm_def, Complex.normSq_mk, ← Real.sqrt_sq hr]\n      congr 1; nlinarith\n    refine ⟨Complex.arg z, ?_, ?_⟩\n    · rw [← hz, Complex.norm_mul_cos_arg]\n    · rw [← hz, Complex.norm_mul_sin_arg]\nexact @key (3) ((by norm_num))'),
]
instances = [kernel_instance(*values, proof=proof, edge=edge) for values, edge, proof in CASES]
