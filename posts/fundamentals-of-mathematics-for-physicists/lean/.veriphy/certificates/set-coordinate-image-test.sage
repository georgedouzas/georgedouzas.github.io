# name: set-coordinate-image-test
# technique: test fallback (test_fallback recipe): instances the kernel checks, chosen by hand
# goal: sage_test KaluzaKlein.Sets.Maps.coordinate_image_sphere
# description: the claim at the instances below, each proved independently of the claim
SEED = 0
CASES = [
    (['2'], False, "set_option maxHeartbeats 2000000 in\nhave key : ∀ (i : Fin 3), (fun p : Fin 3 → ℝ => p i) '' sphere = Set.Icc (-1) 1 := by\n  intro i\n  ext t\n  simp only [Set.mem_image, Set.mem_Icc, sphere, Set.mem_setOf_eq]\n  constructor\n  · rintro ⟨p, hp, rfl⟩\n    fin_cases i <;> simp <;> constructor <;> nlinarith [sq_nonneg (p 0), sq_nonneg (p 1), sq_nonneg (p 2)]\n  · rintro ⟨h1, h2⟩\n    have hs : Real.sqrt (1 - t ^ 2) ^ 2 = 1 - t ^ 2 := Real.sq_sqrt (by nlinarith)\n    fin_cases i\n    · exact ⟨![t, Real.sqrt (1 - t ^ 2), 0], by simp; linarith, by simp⟩\n    · exact ⟨![Real.sqrt (1 - t ^ 2), t, 0], by simp; linarith, by simp⟩\n    · exact ⟨![Real.sqrt (1 - t ^ 2), 0, t], by simp; linarith, by simp⟩\nexact @key (2)"),
    (['0'], True, "set_option maxHeartbeats 2000000 in\nhave key : ∀ (i : Fin 3), (fun p : Fin 3 → ℝ => p i) '' sphere = Set.Icc (-1) 1 := by\n  intro i\n  ext t\n  simp only [Set.mem_image, Set.mem_Icc, sphere, Set.mem_setOf_eq]\n  constructor\n  · rintro ⟨p, hp, rfl⟩\n    fin_cases i <;> simp <;> constructor <;> nlinarith [sq_nonneg (p 0), sq_nonneg (p 1), sq_nonneg (p 2)]\n  · rintro ⟨h1, h2⟩\n    have hs : Real.sqrt (1 - t ^ 2) ^ 2 = 1 - t ^ 2 := Real.sq_sqrt (by nlinarith)\n    fin_cases i\n    · exact ⟨![t, Real.sqrt (1 - t ^ 2), 0], by simp; linarith, by simp⟩\n    · exact ⟨![Real.sqrt (1 - t ^ 2), t, 0], by simp; linarith, by simp⟩\n    · exact ⟨![Real.sqrt (1 - t ^ 2), 0, t], by simp; linarith, by simp⟩\nexact @key (0)"),
    (['1'], False, "set_option maxHeartbeats 2000000 in\nhave key : ∀ (i : Fin 3), (fun p : Fin 3 → ℝ => p i) '' sphere = Set.Icc (-1) 1 := by\n  intro i\n  ext t\n  simp only [Set.mem_image, Set.mem_Icc, sphere, Set.mem_setOf_eq]\n  constructor\n  · rintro ⟨p, hp, rfl⟩\n    fin_cases i <;> simp <;> constructor <;> nlinarith [sq_nonneg (p 0), sq_nonneg (p 1), sq_nonneg (p 2)]\n  · rintro ⟨h1, h2⟩\n    have hs : Real.sqrt (1 - t ^ 2) ^ 2 = 1 - t ^ 2 := Real.sq_sqrt (by nlinarith)\n    fin_cases i\n    · exact ⟨![t, Real.sqrt (1 - t ^ 2), 0], by simp; linarith, by simp⟩\n    · exact ⟨![Real.sqrt (1 - t ^ 2), t, 0], by simp; linarith, by simp⟩\n    · exact ⟨![Real.sqrt (1 - t ^ 2), 0, t], by simp; linarith, by simp⟩\nexact @key (1)"),
]
instances = [kernel_instance(*values, proof=proof, edge=edge) for values, edge, proof in CASES]
