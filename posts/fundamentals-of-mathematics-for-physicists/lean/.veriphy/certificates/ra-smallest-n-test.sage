# name: ra-smallest-n-test
# technique: test a claim no recipe certifies, at instances the kernel checks by computation
# goal: sage_test KaluzaKlein.RealAnalysis.Sequences.smallest_N file "ra-smallest-n-test.sage"
# description: N = 48, 498, 4998 for ε = 10⁻¹, 10⁻², 10⁻³ are the smallest thresholds
SEED = 0  # the instances are listed, no sampling
PROOF = None
CASES = [(['1 / 10', '(by norm_num)', '48', '(by norm_num)', '(by norm_num)', '(by norm_num)'], False, 'refine ⟨fun n hn => ?_, ?_⟩\n· have h : (48 : ℝ) ≤ n := by exact_mod_cast hn\n  have e : (2 * (n : ℝ) + 1) / (n + 3) - 2 = -(5 / (n + 3)) := by field_simp; ring\n  rw [e, abs_neg, abs_of_pos (by positivity), div_lt_iff₀ (by positivity)]\n  linarith\n· norm_num [abs_div]'), (['1 / 100', '(by norm_num)', '498', '(by norm_num)', '(by norm_num)', '(by norm_num)'], False, 'refine ⟨fun n hn => ?_, ?_⟩\n· have h : (498 : ℝ) ≤ n := by exact_mod_cast hn\n  have e : (2 * (n : ℝ) + 1) / (n + 3) - 2 = -(5 / (n + 3)) := by field_simp; ring\n  rw [e, abs_neg, abs_of_pos (by positivity), div_lt_iff₀ (by positivity)]\n  linarith\n· norm_num [abs_div]'), (['1 / 1000', '(by norm_num)', '4998', '(by norm_num)', '(by norm_num)', '(by norm_num)'], False, 'refine ⟨fun n hn => ?_, ?_⟩\n· have h : (4998 : ℝ) ≤ n := by exact_mod_cast hn\n  have e : (2 * (n : ℝ) + 1) / (n + 3) - 2 = -(5 / (n + 3)) := by field_simp; ring\n  rw [e, abs_neg, abs_of_pos (by positivity), div_lt_iff₀ (by positivity)]\n  linarith\n· norm_num [abs_div]'), (['3 / 2', '(by norm_num)', '1', '(by norm_num)', '(by norm_num)', '(by norm_num)'], True, 'refine ⟨fun n hn => ?_, ?_⟩\n· have h : (1 : ℝ) ≤ n := by exact_mod_cast hn\n  have e : (2 * (n : ℝ) + 1) / (n + 3) - 2 = -(5 / (n + 3)) := by field_simp; ring\n  rw [e, abs_neg, abs_of_pos (by positivity), div_lt_iff₀ (by positivity)]\n  linarith\n· norm_num [abs_div]')]
instances = [kernel_instance(*values, proof=(p if p is not None else PROOF), edge=edge) for values, edge, p in CASES]
