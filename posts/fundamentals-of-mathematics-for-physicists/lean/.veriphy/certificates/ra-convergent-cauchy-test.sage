# name: ra-convergent-cauchy-test
# technique: test a claim no recipe certifies, at instances the kernel checks by computation
# goal: sage_test KaluzaKlein.RealAnalysis.Sequences.convergent_cauchy file "ra-convergent-cauchy-test.sage"
# description: a convergent sequence is Cauchy: Sage picks N for ε, Lean checks |a_m - a_n| < ε for m, n ≥ N
SEED = 0  # the instances are listed, no sampling
PROOF = None
CASES = [(['(fun _ : ℕ => (0 : ℝ))', '0', 'tendsto_const_nhds', '1', '(by norm_num)'], True, 'exact ⟨0, fun m n _ _ => by norm_num⟩'), (['(fun n : ℕ => 1 / ((n : ℝ) + 1))', '0', 'tendsto_one_div_add_atTop_nhds_zero_nat', '1 / 10', '(by norm_num)'], False, "refine ⟨10, fun m n hm hn => ?_⟩\nhave hm' : (10 : ℝ) ≤ m := by exact_mod_cast hm\nhave hn' : (10 : ℝ) ≤ n := by exact_mod_cast hn\nhave h1 : 1 / ((m : ℝ) + 1) ≤ 1 / 11 := one_div_le_one_div_of_le (by norm_num) (by linarith)\nhave h2 : 1 / ((n : ℝ) + 1) ≤ 1 / 11 := one_div_le_one_div_of_le (by norm_num) (by linarith)\nhave h3 : 0 < 1 / ((m : ℝ) + 1) := by positivity\nhave h4 : 0 < 1 / ((n : ℝ) + 1) := by positivity\nrw [abs_lt]; constructor <;> linarith"), (['(fun n : ℕ => 1 / ((n : ℝ) + 1))', '0', 'tendsto_one_div_add_atTop_nhds_zero_nat', '1 / 1000', '(by norm_num)'], False, "refine ⟨1000, fun m n hm hn => ?_⟩\nhave hm' : (1000 : ℝ) ≤ m := by exact_mod_cast hm\nhave hn' : (1000 : ℝ) ≤ n := by exact_mod_cast hn\nhave h1 : 1 / ((m : ℝ) + 1) ≤ 1 / 1001 := one_div_le_one_div_of_le (by norm_num) (by linarith)\nhave h2 : 1 / ((n : ℝ) + 1) ≤ 1 / 1001 := one_div_le_one_div_of_le (by norm_num) (by linarith)\nhave h3 : 0 < 1 / ((m : ℝ) + 1) := by positivity\nhave h4 : 0 < 1 / ((n : ℝ) + 1) := by positivity\nrw [abs_lt]; constructor <;> linarith")]
instances = [kernel_instance(*values, proof=(p if p is not None else PROOF), edge=edge) for values, edge, p in CASES]
