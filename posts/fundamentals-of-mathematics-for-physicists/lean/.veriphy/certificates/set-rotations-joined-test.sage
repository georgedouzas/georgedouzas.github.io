# name: set-rotations-joined-test
# technique: test fallback (test_fallback recipe): instances the kernel checks, chosen by hand
# goal: sage_test KaluzaKlein.Sets.Connected.rotations_joined
# description: the claim at the instances below, each proved independently of the claim
SEED = 0
CASES = [
    (['1', '!![1, 0, 0; 0, 1, 0; 0, 0, -1]', '(Matrix.specialOrthogonalGroup (Fin 3) ℝ).one_mem', '(by rw [KaluzaKlein.Sets.Connected.mem_O3_iff]; ext i j; fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply, Fin.sum_univ_succ])', '(by simp [Matrix.det_fin_three])'], True, 'set_option maxHeartbeats 2000000 in\nhave key : ∀ (R g : Matrix (Fin 3) (Fin 3) ℝ) (hR : R ∈ SO3) (hg : g ∈ O3) (hdg : g.det = -1), JoinedIn SO3 1 R ∧ ¬ JoinedIn O3 R g := by\n  intro R g hR hg hdg\n  refine ⟨rotation_path R hR, fun h => ?_⟩\n  have hRO : R ∈ O3 := by rw [mem_SO3_iff] at hR; rw [mem_O3_iff]; exact hR.1\n  have hcomp := O3_components R hRO\n  obtain ⟨γ, hγ⟩ := h\n  have hsub := (isPreconnected_range γ.continuous).subset_connectedComponentIn (x := R) ⟨0, by simp⟩\n    (by rintro _ ⟨t, rfl⟩; exact hγ t)\n  have hmem : g ∈ connectedComponentIn O3 R := hsub ⟨1, by simp⟩\n  rw [hcomp] at hmem\n  rw [mem_SO3_iff] at hR\n  have := hmem.2\n  rw [hdg, hR.2] at this\n  norm_num at this\nexact @key (1) (!![1, 0, 0; 0, 1, 0; 0, 0, -1]) ((Matrix.specialOrthogonalGroup (Fin 3) ℝ).one_mem) ((by rw [KaluzaKlein.Sets.Connected.mem_O3_iff]; ext i j; fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply, Fin.sum_univ_succ])) ((by simp [Matrix.det_fin_three]))'),
    (['KaluzaKlein.Sets.Surjective.Rz (Real.pi / 2)', '!![1, 0, 0; 0, 1, 0; 0, 0, -1]', '((KaluzaKlein.Sets.Surjective.stabilizer_eq _).2 ⟨_, rfl⟩).1', '(by rw [KaluzaKlein.Sets.Connected.mem_O3_iff]; ext i j; fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply, Fin.sum_univ_succ])', '(by simp [Matrix.det_fin_three])'], False, 'set_option maxHeartbeats 2000000 in\nhave key : ∀ (R g : Matrix (Fin 3) (Fin 3) ℝ) (hR : R ∈ SO3) (hg : g ∈ O3) (hdg : g.det = -1), JoinedIn SO3 1 R ∧ ¬ JoinedIn O3 R g := by\n  intro R g hR hg hdg\n  refine ⟨rotation_path R hR, fun h => ?_⟩\n  have hRO : R ∈ O3 := by rw [mem_SO3_iff] at hR; rw [mem_O3_iff]; exact hR.1\n  have hcomp := O3_components R hRO\n  obtain ⟨γ, hγ⟩ := h\n  have hsub := (isPreconnected_range γ.continuous).subset_connectedComponentIn (x := R) ⟨0, by simp⟩\n    (by rintro _ ⟨t, rfl⟩; exact hγ t)\n  have hmem : g ∈ connectedComponentIn O3 R := hsub ⟨1, by simp⟩\n  rw [hcomp] at hmem\n  rw [mem_SO3_iff] at hR\n  have := hmem.2\n  rw [hdg, hR.2] at this\n  norm_num at this\nexact @key (KaluzaKlein.Sets.Surjective.Rz (Real.pi / 2)) (!![1, 0, 0; 0, 1, 0; 0, 0, -1]) (((KaluzaKlein.Sets.Surjective.stabilizer_eq _).2 ⟨_, rfl⟩).1) ((by rw [KaluzaKlein.Sets.Connected.mem_O3_iff]; ext i j; fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply, Fin.sum_univ_succ])) ((by simp [Matrix.det_fin_three]))'),
    (['KaluzaKlein.Sets.Surjective.Rz 1', '!![1, 0, 0; 0, 1, 0; 0, 0, -1]', '((KaluzaKlein.Sets.Surjective.stabilizer_eq _).2 ⟨_, rfl⟩).1', '(by rw [KaluzaKlein.Sets.Connected.mem_O3_iff]; ext i j; fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply, Fin.sum_univ_succ])', '(by simp [Matrix.det_fin_three])'], False, 'set_option maxHeartbeats 2000000 in\nhave key : ∀ (R g : Matrix (Fin 3) (Fin 3) ℝ) (hR : R ∈ SO3) (hg : g ∈ O3) (hdg : g.det = -1), JoinedIn SO3 1 R ∧ ¬ JoinedIn O3 R g := by\n  intro R g hR hg hdg\n  refine ⟨rotation_path R hR, fun h => ?_⟩\n  have hRO : R ∈ O3 := by rw [mem_SO3_iff] at hR; rw [mem_O3_iff]; exact hR.1\n  have hcomp := O3_components R hRO\n  obtain ⟨γ, hγ⟩ := h\n  have hsub := (isPreconnected_range γ.continuous).subset_connectedComponentIn (x := R) ⟨0, by simp⟩\n    (by rintro _ ⟨t, rfl⟩; exact hγ t)\n  have hmem : g ∈ connectedComponentIn O3 R := hsub ⟨1, by simp⟩\n  rw [hcomp] at hmem\n  rw [mem_SO3_iff] at hR\n  have := hmem.2\n  rw [hdg, hR.2] at this\n  norm_num at this\nexact @key (KaluzaKlein.Sets.Surjective.Rz 1) (!![1, 0, 0; 0, 1, 0; 0, 0, -1]) (((KaluzaKlein.Sets.Surjective.stabilizer_eq _).2 ⟨_, rfl⟩).1) ((by rw [KaluzaKlein.Sets.Connected.mem_O3_iff]; ext i j; fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply, Fin.sum_univ_succ])) ((by simp [Matrix.det_fin_three]))'),
]
instances = [kernel_instance(*values, proof=proof, edge=edge) for values, edge, proof in CASES]
