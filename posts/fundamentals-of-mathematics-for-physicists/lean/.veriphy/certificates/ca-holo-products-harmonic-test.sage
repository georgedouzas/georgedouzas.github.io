# name: ca-holo-products-harmonic-test
# technique: test fallback (kernel-checked instances)
# goal: sage_test KaluzaKlein.ComplexAnalysis.HolomorphicWorked.products_harmonic
# description: uv and u^2 - v^2 harmonic for f = w, w^2, w^3 + w; each instance proved by computation or mathlib, independently of the claim.
SEED = 0
CASES = [
    (['(fun w : ℂ => w)', 'Set.univ', 'isOpen_univ', '(by fun_prop)', '0', '(Set.mem_univ _)'], 'have hA : AnalyticAt ℂ (fun w => (fun w : ℂ => w) w ^ 2) (0) := ((DifferentiableOn.analyticAt (s := Set.univ) (by fun_prop) (Filter.univ_mem))).pow 2\nhave e1 : (fun w => ((fun w : ℂ => w) w).re * ((fun w : ℂ => w) w).im) = (1 / 2 : ℝ) • (fun w => (((fun w : ℂ => w) w) ^ 2).im) := by\n  funext w\n  simp [sq]\n  ring\nhave e2 : (fun w => ((fun w : ℂ => w) w).re ^ 2 - ((fun w : ℂ => w) w).im ^ 2) = fun w => (((fun w : ℂ => w) w) ^ 2).re := by\n  funext w\n  simp [sq]\nrw [e1, e2]\nexact ⟨hA.harmonicAt_im.const_smul, hA.harmonicAt_re⟩', True),
    (['(fun w : ℂ => w ^ 2)', 'Set.univ', 'isOpen_univ', '(by fun_prop)', '(1 + Complex.I)', '(Set.mem_univ _)'], 'have hA : AnalyticAt ℂ (fun w => (fun w : ℂ => w ^ 2) w ^ 2) (1 + Complex.I) := ((DifferentiableOn.analyticAt (s := Set.univ) (by fun_prop) (Filter.univ_mem))).pow 2\nhave e1 : (fun w => ((fun w : ℂ => w ^ 2) w).re * ((fun w : ℂ => w ^ 2) w).im) = (1 / 2 : ℝ) • (fun w => (((fun w : ℂ => w ^ 2) w) ^ 2).im) := by\n  funext w\n  simp [sq]\n  ring\nhave e2 : (fun w => ((fun w : ℂ => w ^ 2) w).re ^ 2 - ((fun w : ℂ => w ^ 2) w).im ^ 2) = fun w => (((fun w : ℂ => w ^ 2) w) ^ 2).re := by\n  funext w\n  simp [sq]\nrw [e1, e2]\nexact ⟨hA.harmonicAt_im.const_smul, hA.harmonicAt_re⟩', False),
    (['(fun w : ℂ => w ^ 3 + w)', '(Metric.ball 0 1)', 'Metric.isOpen_ball', '(by fun_prop)', '0', '(Metric.mem_ball_self one_pos)'], 'have hA : AnalyticAt ℂ (fun w => (fun w : ℂ => w ^ 3 + w) w ^ 2) (0) := ((DifferentiableOn.analyticAt (s := Metric.ball 0 1) (by fun_prop) (Metric.isOpen_ball.mem_nhds (Metric.mem_ball_self one_pos)))).pow 2\nhave e1 : (fun w => ((fun w : ℂ => w ^ 3 + w) w).re * ((fun w : ℂ => w ^ 3 + w) w).im) = (1 / 2 : ℝ) • (fun w => (((fun w : ℂ => w ^ 3 + w) w) ^ 2).im) := by\n  funext w\n  simp [sq]\n  ring\nhave e2 : (fun w => ((fun w : ℂ => w ^ 3 + w) w).re ^ 2 - ((fun w : ℂ => w ^ 3 + w) w).im ^ 2) = fun w => (((fun w : ℂ => w ^ 3 + w) w) ^ 2).re := by\n  funext w\n  simp [sq]\nrw [e1, e2]\nexact ⟨hA.harmonicAt_im.const_smul, hA.harmonicAt_re⟩', False),
]
instances = [kernel_instance(*values, proof=proof, edge=edge) for values, proof, edge in CASES]
