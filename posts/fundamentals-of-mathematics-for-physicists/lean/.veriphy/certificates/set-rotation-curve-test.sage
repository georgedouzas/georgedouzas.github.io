# name: set-rotation-curve-test
# technique: test fallback (test_fallback recipe): instances the kernel checks, chosen by hand
# goal: sage_test KaluzaKlein.Sets.Continuous.rotation_curve
# description: the claim at the instances below, each proved independently of the claim
SEED = 0
CASES = [
    (['fun t => KaluzaKlein.Sets.Surjective.Rz t', '(by refine continuous_pi fun i => continuous_pi fun j => ?_; fin_cases i <;> fin_cases j <;> simp [KaluzaKlein.Sets.Surjective.Rz] <;> fun_prop)', 'fun t => ((KaluzaKlein.Sets.Surjective.stabilizer_eq _).2 ⟨_, rfl⟩).1'], False, 'set_option maxHeartbeats 2000000 in\nhave key : ∀ (R : ℝ → Matrix (Fin 3) (Fin 3) ℝ) (hR : Continuous R) (hSO : ∀ t, R t ∈ SO3), Continuous (fun t => orbit (R t)) ∧ ∀ t, orbit (R t) ∈ sphere := by\n  intro R hR hSO\n  refine ⟨hR.matrix_mulVec continuous_const, fun t => (orbit_image _).2 ⟨R t, hSO t, rfl⟩⟩\nexact @key (fun t => KaluzaKlein.Sets.Surjective.Rz t) ((by refine continuous_pi fun i => continuous_pi fun j => ?_; fin_cases i <;> fin_cases j <;> simp [KaluzaKlein.Sets.Surjective.Rz] <;> fun_prop)) (fun t => ((KaluzaKlein.Sets.Surjective.stabilizer_eq _).2 ⟨_, rfl⟩).1)'),
    (['fun _ => 1', 'continuous_const', 'fun _ => (Matrix.specialOrthogonalGroup (Fin 3) ℝ).one_mem'], True, 'set_option maxHeartbeats 2000000 in\nhave key : ∀ (R : ℝ → Matrix (Fin 3) (Fin 3) ℝ) (hR : Continuous R) (hSO : ∀ t, R t ∈ SO3), Continuous (fun t => orbit (R t)) ∧ ∀ t, orbit (R t) ∈ sphere := by\n  intro R hR hSO\n  refine ⟨hR.matrix_mulVec continuous_const, fun t => (orbit_image _).2 ⟨R t, hSO t, rfl⟩⟩\nexact @key (fun _ => 1) (continuous_const) (fun _ => (Matrix.specialOrthogonalGroup (Fin 3) ℝ).one_mem)'),
    (['fun t => KaluzaKlein.Sets.Surjective.Rz (2 * t)', '(by refine continuous_pi fun i => continuous_pi fun j => ?_; fin_cases i <;> fin_cases j <;> simp [KaluzaKlein.Sets.Surjective.Rz] <;> fun_prop)', 'fun t => ((KaluzaKlein.Sets.Surjective.stabilizer_eq _).2 ⟨_, rfl⟩).1'], False, 'set_option maxHeartbeats 2000000 in\nhave key : ∀ (R : ℝ → Matrix (Fin 3) (Fin 3) ℝ) (hR : Continuous R) (hSO : ∀ t, R t ∈ SO3), Continuous (fun t => orbit (R t)) ∧ ∀ t, orbit (R t) ∈ sphere := by\n  intro R hR hSO\n  refine ⟨hR.matrix_mulVec continuous_const, fun t => (orbit_image _).2 ⟨R t, hSO t, rfl⟩⟩\nexact @key (fun t => KaluzaKlein.Sets.Surjective.Rz (2 * t)) ((by refine continuous_pi fun i => continuous_pi fun j => ?_; fin_cases i <;> fin_cases j <;> simp [KaluzaKlein.Sets.Surjective.Rz] <;> fun_prop)) (fun t => ((KaluzaKlein.Sets.Surjective.stabilizer_eq _).2 ⟨_, rfl⟩).1)'),
]
instances = [kernel_instance(*values, proof=proof, edge=edge) for values, edge, proof in CASES]
