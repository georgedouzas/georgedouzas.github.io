# name: set-circle-quotient-test
# technique: test fallback (test_fallback recipe): instances the kernel checks, chosen by hand
# goal: sage_test KaluzaKlein.Sets.Quotients.circle_quotient_bijective
# description: the claim at the instances below, each proved independently of the claim
SEED = 0
CASES = [
    (['2 * Real.pi', '(by positivity)'], False, "set_option maxHeartbeats 2000000 in\nhave key : ∀ (T : ℝ) (hT : 0 < T), ∃ F : Quotient (angleSetoid T) → circle, Function.Bijective F ∧ ∀ φ, (F ⟦φ⟧ : ℝ × ℝ) = wrap (2 * Real.pi * φ / T) := by\n  intro T hT\n  have hw : ∀ φ, wrap φ ∈ circle := fun φ => by simp [circle, wrap, Real.cos_sq_add_sin_sq]\n  have hpi := Real.pi_pos\n  have key : ∀ a b : ℝ, wrap (2 * Real.pi * a / T) = wrap (2 * Real.pi * b / T) ↔ ∃ k : ℤ, b - a = k * T := by\n    intro a b\n    constructor\n    · intro h\n      have : 2 * Real.pi * b / T ∈ wrap ⁻¹' {wrap (2 * Real.pi * a / T)} := h.symm\n      rw [wrap_preimage] at this\n      obtain ⟨k, hk⟩ := this\n      refine ⟨k, ?_⟩\n      field_simp at hk\n      nlinarith\n    · rintro ⟨k, hk⟩\n      have : 2 * Real.pi * b / T ∈ wrap ⁻¹' {wrap (2 * Real.pi * a / T)} := by\n        rw [wrap_preimage]\n        refine ⟨k, ?_⟩\n        rw [show b = a + k * T by linarith]\n        field_simp\n        try ring\n      exact this.symm\n  refine ⟨Quotient.lift (fun φ => (⟨wrap (2 * Real.pi * φ / T), hw _⟩ : circle))\n    (fun a b h => Subtype.ext ((key a b).2 h)), ⟨?_, ?_⟩, fun φ => rfl⟩\n  · intro p q h\n    induction p using Quotient.ind\n    induction q using Quotient.ind\n    exact Quotient.sound ((key _ _).1 (congrArg Subtype.val h))\n  · rintro ⟨p, hp⟩\n    have hp' : p ∈ Set.range (fun φ => (1 * Real.cos φ, 1 * Real.sin φ)) := by\n      rw [range_wrap 1 zero_le_one]; simpa [circle] using hp\n    obtain ⟨φ, hφ⟩ := hp'\n    refine ⟨⟦φ * T / (2 * Real.pi)⟧, Subtype.ext ?_⟩\n    simp only [Quotient.lift_mk]\n    rw [← hφ]\n    simp only [wrap, one_mul]\n    congr 2 <;> field_simp\nexact @key (2 * Real.pi) ((by positivity))"),
    (['1', '(by norm_num)'], True, "set_option maxHeartbeats 2000000 in\nhave key : ∀ (T : ℝ) (hT : 0 < T), ∃ F : Quotient (angleSetoid T) → circle, Function.Bijective F ∧ ∀ φ, (F ⟦φ⟧ : ℝ × ℝ) = wrap (2 * Real.pi * φ / T) := by\n  intro T hT\n  have hw : ∀ φ, wrap φ ∈ circle := fun φ => by simp [circle, wrap, Real.cos_sq_add_sin_sq]\n  have hpi := Real.pi_pos\n  have key : ∀ a b : ℝ, wrap (2 * Real.pi * a / T) = wrap (2 * Real.pi * b / T) ↔ ∃ k : ℤ, b - a = k * T := by\n    intro a b\n    constructor\n    · intro h\n      have : 2 * Real.pi * b / T ∈ wrap ⁻¹' {wrap (2 * Real.pi * a / T)} := h.symm\n      rw [wrap_preimage] at this\n      obtain ⟨k, hk⟩ := this\n      refine ⟨k, ?_⟩\n      field_simp at hk\n      nlinarith\n    · rintro ⟨k, hk⟩\n      have : 2 * Real.pi * b / T ∈ wrap ⁻¹' {wrap (2 * Real.pi * a / T)} := by\n        rw [wrap_preimage]\n        refine ⟨k, ?_⟩\n        rw [show b = a + k * T by linarith]\n        field_simp\n        try ring\n      exact this.symm\n  refine ⟨Quotient.lift (fun φ => (⟨wrap (2 * Real.pi * φ / T), hw _⟩ : circle))\n    (fun a b h => Subtype.ext ((key a b).2 h)), ⟨?_, ?_⟩, fun φ => rfl⟩\n  · intro p q h\n    induction p using Quotient.ind\n    induction q using Quotient.ind\n    exact Quotient.sound ((key _ _).1 (congrArg Subtype.val h))\n  · rintro ⟨p, hp⟩\n    have hp' : p ∈ Set.range (fun φ => (1 * Real.cos φ, 1 * Real.sin φ)) := by\n      rw [range_wrap 1 zero_le_one]; simpa [circle] using hp\n    obtain ⟨φ, hφ⟩ := hp'\n    refine ⟨⟦φ * T / (2 * Real.pi)⟧, Subtype.ext ?_⟩\n    simp only [Quotient.lift_mk]\n    rw [← hφ]\n    simp only [wrap, one_mul]\n    congr 2 <;> field_simp\nexact @key (1) ((by norm_num))"),
    (['3', '(by norm_num)'], False, "set_option maxHeartbeats 2000000 in\nhave key : ∀ (T : ℝ) (hT : 0 < T), ∃ F : Quotient (angleSetoid T) → circle, Function.Bijective F ∧ ∀ φ, (F ⟦φ⟧ : ℝ × ℝ) = wrap (2 * Real.pi * φ / T) := by\n  intro T hT\n  have hw : ∀ φ, wrap φ ∈ circle := fun φ => by simp [circle, wrap, Real.cos_sq_add_sin_sq]\n  have hpi := Real.pi_pos\n  have key : ∀ a b : ℝ, wrap (2 * Real.pi * a / T) = wrap (2 * Real.pi * b / T) ↔ ∃ k : ℤ, b - a = k * T := by\n    intro a b\n    constructor\n    · intro h\n      have : 2 * Real.pi * b / T ∈ wrap ⁻¹' {wrap (2 * Real.pi * a / T)} := h.symm\n      rw [wrap_preimage] at this\n      obtain ⟨k, hk⟩ := this\n      refine ⟨k, ?_⟩\n      field_simp at hk\n      nlinarith\n    · rintro ⟨k, hk⟩\n      have : 2 * Real.pi * b / T ∈ wrap ⁻¹' {wrap (2 * Real.pi * a / T)} := by\n        rw [wrap_preimage]\n        refine ⟨k, ?_⟩\n        rw [show b = a + k * T by linarith]\n        field_simp\n        try ring\n      exact this.symm\n  refine ⟨Quotient.lift (fun φ => (⟨wrap (2 * Real.pi * φ / T), hw _⟩ : circle))\n    (fun a b h => Subtype.ext ((key a b).2 h)), ⟨?_, ?_⟩, fun φ => rfl⟩\n  · intro p q h\n    induction p using Quotient.ind\n    induction q using Quotient.ind\n    exact Quotient.sound ((key _ _).1 (congrArg Subtype.val h))\n  · rintro ⟨p, hp⟩\n    have hp' : p ∈ Set.range (fun φ => (1 * Real.cos φ, 1 * Real.sin φ)) := by\n      rw [range_wrap 1 zero_le_one]; simpa [circle] using hp\n    obtain ⟨φ, hφ⟩ := hp'\n    refine ⟨⟦φ * T / (2 * Real.pi)⟧, Subtype.ext ?_⟩\n    simp only [Quotient.lift_mk]\n    rw [← hφ]\n    simp only [wrap, one_mul]\n    congr 2 <;> field_simp\nexact @key (3) ((by norm_num))"),
]
instances = [kernel_instance(*values, proof=proof, edge=edge) for values, edge, proof in CASES]
