# name: set-reciprocals-zero-test
# technique: test fallback (test_fallback recipe): instances the kernel checks, chosen by hand
# goal: sage_test KaluzaKlein.Sets.Subspace.reciprocals_zero_not_discrete
# description: the claim at the instances below, each proved independently of the claim
SEED = 0
CASES = [
    (['1', '(by norm_num)'], True, "set_option maxHeartbeats 2000000 in\nhave key : ∀ (c : ℝ) (hc : 0 < c), ¬ DiscreteTopology ↥(insert (0 : ℝ) (range (fun n : ℕ => c / (n + 1))) : Set ℝ) := by\n  intro c hc\n  set S : Set ℝ := insert (0 : ℝ) (range (fun n : ℕ => c / (n + 1))) with hS\n  intro h\n  have h0 := (discreteTopology_iff_isOpen_singleton.1 h) ⟨0, mem_insert _ _⟩\n  rw [isOpen_induced_iff] at h0\n  obtain ⟨t, ht, hpre⟩ := h0\n  have h0t : (0 : ℝ) ∈ t := by\n    have : (⟨0, mem_insert _ _⟩ : S) ∈ (Subtype.val ⁻¹' t) := by rw [hpre]; rfl\n    exact this\n  obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.1 ht 0 h0t\n  obtain ⟨n, hn⟩ := exists_nat_gt (c / ε)\n  have hpos : (0 : ℝ) < c / (n + 1) := by positivity\n  have hlt : c / (n + 1) < ε := by\n    rw [div_lt_iff₀ (by positivity)]\n    rw [div_lt_iff₀ hε] at hn\n    nlinarith\n  have hmem : (⟨c / (n + 1), mem_insert_of_mem _ ⟨n, rfl⟩⟩ : S) ∈ (Subtype.val ⁻¹' t) := by\n    apply hball\n    rw [mem_ball, Real.dist_eq, sub_zero, abs_of_pos hpos]; exact hlt\n  rw [hpre] at hmem\n  have := congrArg Subtype.val hmem\n  simp at this\n  rcases this with h1 | h1\n  · linarith\n  · have : (0 : ℝ) < n + 1 := by positivity\n    linarith\nexact @key (1) ((by norm_num))"),
    (['2', '(by norm_num)'], False, "set_option maxHeartbeats 2000000 in\nhave key : ∀ (c : ℝ) (hc : 0 < c), ¬ DiscreteTopology ↥(insert (0 : ℝ) (range (fun n : ℕ => c / (n + 1))) : Set ℝ) := by\n  intro c hc\n  set S : Set ℝ := insert (0 : ℝ) (range (fun n : ℕ => c / (n + 1))) with hS\n  intro h\n  have h0 := (discreteTopology_iff_isOpen_singleton.1 h) ⟨0, mem_insert _ _⟩\n  rw [isOpen_induced_iff] at h0\n  obtain ⟨t, ht, hpre⟩ := h0\n  have h0t : (0 : ℝ) ∈ t := by\n    have : (⟨0, mem_insert _ _⟩ : S) ∈ (Subtype.val ⁻¹' t) := by rw [hpre]; rfl\n    exact this\n  obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.1 ht 0 h0t\n  obtain ⟨n, hn⟩ := exists_nat_gt (c / ε)\n  have hpos : (0 : ℝ) < c / (n + 1) := by positivity\n  have hlt : c / (n + 1) < ε := by\n    rw [div_lt_iff₀ (by positivity)]\n    rw [div_lt_iff₀ hε] at hn\n    nlinarith\n  have hmem : (⟨c / (n + 1), mem_insert_of_mem _ ⟨n, rfl⟩⟩ : S) ∈ (Subtype.val ⁻¹' t) := by\n    apply hball\n    rw [mem_ball, Real.dist_eq, sub_zero, abs_of_pos hpos]; exact hlt\n  rw [hpre] at hmem\n  have := congrArg Subtype.val hmem\n  simp at this\n  rcases this with h1 | h1\n  · linarith\n  · have : (0 : ℝ) < n + 1 := by positivity\n    linarith\nexact @key (2) ((by norm_num))"),
    (['1/3', '(by norm_num)'], False, "set_option maxHeartbeats 2000000 in\nhave key : ∀ (c : ℝ) (hc : 0 < c), ¬ DiscreteTopology ↥(insert (0 : ℝ) (range (fun n : ℕ => c / (n + 1))) : Set ℝ) := by\n  intro c hc\n  set S : Set ℝ := insert (0 : ℝ) (range (fun n : ℕ => c / (n + 1))) with hS\n  intro h\n  have h0 := (discreteTopology_iff_isOpen_singleton.1 h) ⟨0, mem_insert _ _⟩\n  rw [isOpen_induced_iff] at h0\n  obtain ⟨t, ht, hpre⟩ := h0\n  have h0t : (0 : ℝ) ∈ t := by\n    have : (⟨0, mem_insert _ _⟩ : S) ∈ (Subtype.val ⁻¹' t) := by rw [hpre]; rfl\n    exact this\n  obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.1 ht 0 h0t\n  obtain ⟨n, hn⟩ := exists_nat_gt (c / ε)\n  have hpos : (0 : ℝ) < c / (n + 1) := by positivity\n  have hlt : c / (n + 1) < ε := by\n    rw [div_lt_iff₀ (by positivity)]\n    rw [div_lt_iff₀ hε] at hn\n    nlinarith\n  have hmem : (⟨c / (n + 1), mem_insert_of_mem _ ⟨n, rfl⟩⟩ : S) ∈ (Subtype.val ⁻¹' t) := by\n    apply hball\n    rw [mem_ball, Real.dist_eq, sub_zero, abs_of_pos hpos]; exact hlt\n  rw [hpre] at hmem\n  have := congrArg Subtype.val hmem\n  simp at this\n  rcases this with h1 | h1\n  · linarith\n  · have : (0 : ℝ) < n + 1 := by positivity\n    linarith\nexact @key (1/3) ((by norm_num))"),
]
instances = [kernel_instance(*values, proof=proof, edge=edge) for values, edge, proof in CASES]
