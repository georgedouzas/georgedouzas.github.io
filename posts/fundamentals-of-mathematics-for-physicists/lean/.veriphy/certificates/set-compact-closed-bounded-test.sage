# name: set-compact-closed-bounded-test
# technique: test fallback (test_fallback recipe): instances the kernel checks, chosen by hand
# goal: sage_test KaluzaKlein.Sets.Compact.compact_of_closed_bounded
# description: the claim at the instances below, each proved independently of the claim
SEED = 0
CASES = [
    (['ℝ × ℝ', 'inferInstance', 'inferInstance', 'KaluzaKlein.Sets.Sets.circle', 'KaluzaKlein.Sets.Compact.circle_closed_bounded.1', 'KaluzaKlein.Sets.Compact.circle_closed_bounded.2'], False, 'set_option maxHeartbeats 2000000 in\nhave key : ∀ (E : Type) [inst1 : MetricSpace E] [inst2 : ProperSpace E] (K : Set E) (hc : IsClosed K) (hb : Bornology.IsBounded K), IsCompact K := by\n  intro E inst1 inst2 K hc hb\n  exact (Metric.isCompact_of_isClosed_isBounded hc hb)\nexact @key (ℝ × ℝ) (inferInstance) (inferInstance) (KaluzaKlein.Sets.Sets.circle) (KaluzaKlein.Sets.Compact.circle_closed_bounded.1) (KaluzaKlein.Sets.Compact.circle_closed_bounded.2)'),
    (['Fin 3 → ℝ', 'inferInstance', 'inferInstance', 'KaluzaKlein.Sets.Sets.sphere', 'KaluzaKlein.Sets.Compact.sphere_closed_bounded.1', 'KaluzaKlein.Sets.Compact.sphere_closed_bounded.2'], False, 'set_option maxHeartbeats 2000000 in\nhave key : ∀ (E : Type) [inst1 : MetricSpace E] [inst2 : ProperSpace E] (K : Set E) (hc : IsClosed K) (hb : Bornology.IsBounded K), IsCompact K := by\n  intro E inst1 inst2 K hc hb\n  exact (Metric.isCompact_of_isClosed_isBounded hc hb)\nexact @key (Fin 3 → ℝ) (inferInstance) (inferInstance) (KaluzaKlein.Sets.Sets.sphere) (KaluzaKlein.Sets.Compact.sphere_closed_bounded.1) (KaluzaKlein.Sets.Compact.sphere_closed_bounded.2)'),
    (['(ℝ × ℝ) × (ℝ × ℝ)', 'inferInstance', 'inferInstance', 'KaluzaKlein.Sets.Sets.circle ×ˢ KaluzaKlein.Sets.Sets.circle', 'KaluzaKlein.Sets.Compact.torus_closed_bounded.1', 'KaluzaKlein.Sets.Compact.torus_closed_bounded.2'], False, 'set_option maxHeartbeats 2000000 in\nhave key : ∀ (E : Type) [inst1 : MetricSpace E] [inst2 : ProperSpace E] (K : Set E) (hc : IsClosed K) (hb : Bornology.IsBounded K), IsCompact K := by\n  intro E inst1 inst2 K hc hb\n  exact (Metric.isCompact_of_isClosed_isBounded hc hb)\nexact @key ((ℝ × ℝ) × (ℝ × ℝ)) (inferInstance) (inferInstance) (KaluzaKlein.Sets.Sets.circle ×ˢ KaluzaKlein.Sets.Sets.circle) (KaluzaKlein.Sets.Compact.torus_closed_bounded.1) (KaluzaKlein.Sets.Compact.torus_closed_bounded.2)'),
    (['Fin 3 → Fin 3 → ℝ', 'inferInstance', 'inferInstance', 'KaluzaKlein.Sets.Compact.SO3pi', 'KaluzaKlein.Sets.Compact.SO3_closed_bounded.1', 'KaluzaKlein.Sets.Compact.SO3_closed_bounded.2'], False, 'set_option maxHeartbeats 2000000 in\nhave key : ∀ (E : Type) [inst1 : MetricSpace E] [inst2 : ProperSpace E] (K : Set E) (hc : IsClosed K) (hb : Bornology.IsBounded K), IsCompact K := by\n  intro E inst1 inst2 K hc hb\n  exact (Metric.isCompact_of_isClosed_isBounded hc hb)\nexact @key (Fin 3 → Fin 3 → ℝ) (inferInstance) (inferInstance) (KaluzaKlein.Sets.Compact.SO3pi) (KaluzaKlein.Sets.Compact.SO3_closed_bounded.1) (KaluzaKlein.Sets.Compact.SO3_closed_bounded.2)'),
    (['ℝ', 'inferInstance', 'inferInstance', '∅', 'isClosed_empty', 'Bornology.isBounded_empty'], True, 'set_option maxHeartbeats 2000000 in\nhave key : ∀ (E : Type) [inst1 : MetricSpace E] [inst2 : ProperSpace E] (K : Set E) (hc : IsClosed K) (hb : Bornology.IsBounded K), IsCompact K := by\n  intro E inst1 inst2 K hc hb\n  exact (Metric.isCompact_of_isClosed_isBounded hc hb)\nexact @key (ℝ) (inferInstance) (inferInstance) (∅) (isClosed_empty) (Bornology.isBounded_empty)'),
]
instances = [kernel_instance(*values, proof=proof, edge=edge) for values, edge, proof in CASES]
