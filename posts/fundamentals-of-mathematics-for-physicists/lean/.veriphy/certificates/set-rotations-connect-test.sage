# name: set-rotations-connect-test
# technique: test fallback (test_fallback recipe): instances the kernel checks, chosen by hand
# goal: sage_test KaluzaKlein.Sets.Connected.rotations_connect
# description: the claim at the instances below, each proved independently of the claim
SEED = 0
CASES = [
    (['1', 'KaluzaKlein.Sets.Surjective.Rz (Real.pi / 2)', '(Matrix.specialOrthogonalGroup (Fin 3) ℝ).one_mem', '((KaluzaKlein.Sets.Surjective.stabilizer_eq _).2 ⟨_, rfl⟩).1'], False, 'set_option maxHeartbeats 2000000 in\nhave key : ∀ (R₁ R₂ : Matrix (Fin 3) (Fin 3) ℝ) (h₁ : R₁ ∈ SO3) (h₂ : R₂ ∈ SO3), JoinedIn SO3 R₁ R₂ := by\n  intro R₁ R₂ h₁ h₂\n  have hpc : IsPathConnected SO3 := ⟨1, (Matrix.specialOrthogonalGroup (Fin 3) ℝ).one_mem,\n    fun {y} hy => rotation_path y hy⟩\n  exact hpc.joinedIn R₁ h₁ R₂ h₂\nexact @key (1) (KaluzaKlein.Sets.Surjective.Rz (Real.pi / 2)) ((Matrix.specialOrthogonalGroup (Fin 3) ℝ).one_mem) (((KaluzaKlein.Sets.Surjective.stabilizer_eq _).2 ⟨_, rfl⟩).1)'),
    (['1', '1', '(Matrix.specialOrthogonalGroup (Fin 3) ℝ).one_mem', '(Matrix.specialOrthogonalGroup (Fin 3) ℝ).one_mem'], True, 'set_option maxHeartbeats 2000000 in\nhave key : ∀ (R₁ R₂ : Matrix (Fin 3) (Fin 3) ℝ) (h₁ : R₁ ∈ SO3) (h₂ : R₂ ∈ SO3), JoinedIn SO3 R₁ R₂ := by\n  intro R₁ R₂ h₁ h₂\n  have hpc : IsPathConnected SO3 := ⟨1, (Matrix.specialOrthogonalGroup (Fin 3) ℝ).one_mem,\n    fun {y} hy => rotation_path y hy⟩\n  exact hpc.joinedIn R₁ h₁ R₂ h₂\nexact @key (1) (1) ((Matrix.specialOrthogonalGroup (Fin 3) ℝ).one_mem) ((Matrix.specialOrthogonalGroup (Fin 3) ℝ).one_mem)'),
    (['KaluzaKlein.Sets.Surjective.Rz 1', 'KaluzaKlein.Sets.Surjective.Rz 2', '((KaluzaKlein.Sets.Surjective.stabilizer_eq _).2 ⟨_, rfl⟩).1', '((KaluzaKlein.Sets.Surjective.stabilizer_eq _).2 ⟨_, rfl⟩).1'], False, 'set_option maxHeartbeats 2000000 in\nhave key : ∀ (R₁ R₂ : Matrix (Fin 3) (Fin 3) ℝ) (h₁ : R₁ ∈ SO3) (h₂ : R₂ ∈ SO3), JoinedIn SO3 R₁ R₂ := by\n  intro R₁ R₂ h₁ h₂\n  have hpc : IsPathConnected SO3 := ⟨1, (Matrix.specialOrthogonalGroup (Fin 3) ℝ).one_mem,\n    fun {y} hy => rotation_path y hy⟩\n  exact hpc.joinedIn R₁ h₁ R₂ h₂\nexact @key (KaluzaKlein.Sets.Surjective.Rz 1) (KaluzaKlein.Sets.Surjective.Rz 2) (((KaluzaKlein.Sets.Surjective.stabilizer_eq _).2 ⟨_, rfl⟩).1) (((KaluzaKlein.Sets.Surjective.stabilizer_eq _).2 ⟨_, rfl⟩).1)'),
]
instances = [kernel_instance(*values, proof=proof, edge=edge) for values, edge, proof in CASES]
