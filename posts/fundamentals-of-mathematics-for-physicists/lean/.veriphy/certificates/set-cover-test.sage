# name: set-cover-test
# technique: test fallback (test_fallback recipe): instances the kernel checks, chosen by hand
# goal: sage_test KaluzaKlein.Sets.Compact.cover_no_finite_subcover
# description: the claim at the instances below, each proved independently of the claim
SEED = 0
CASES = [
    (['1', '(by norm_num)'], True, 'set_option maxHeartbeats 2000000 in\nhave key : ∀ (c : ℝ) (hc : 0 < c), (⋃ n : ℕ, Ioo (c / (n + 2)) c) = Ioo 0 c ∧ ∀ N : ℕ, c / (N + 2) ∈ Ioo 0 c ∧ c / (N + 2) ∉ ⋃ n ∈ Finset.range N, Ioo (c / (n + 2)) c := by\n  intro c hc\n  refine ⟨?_, fun N => ⟨⟨by positivity, by rw [div_lt_iff₀ (by positivity)]; nlinarith⟩, ?_⟩⟩\n  · ext x\n    simp only [mem_iUnion, mem_Ioo]\n    constructor\n    · rintro ⟨n, h1, h2⟩; exact ⟨lt_trans (by positivity) h1, h2⟩\n    · rintro ⟨h1, h2⟩\n      obtain ⟨n, hn⟩ := exists_nat_gt (c / x)\n      refine ⟨n, ?_, h2⟩\n      rw [div_lt_iff₀ (by positivity)]\n      rw [div_lt_iff₀ h1] at hn\n      nlinarith\n  · simp only [mem_iUnion, mem_Ioo, Finset.mem_range, not_exists, not_and]\n    intro n hn h\n    exfalso\n    have : c / (N + 2) ≤ c / (n + 2) := by\n      apply div_le_div_of_nonneg_left hc.le (by positivity)\n      have : (n : ℝ) < N := by exact_mod_cast hn\n      linarith\n    linarith\nexact @key (1) ((by norm_num))'),
    (['2', '(by norm_num)'], False, 'set_option maxHeartbeats 2000000 in\nhave key : ∀ (c : ℝ) (hc : 0 < c), (⋃ n : ℕ, Ioo (c / (n + 2)) c) = Ioo 0 c ∧ ∀ N : ℕ, c / (N + 2) ∈ Ioo 0 c ∧ c / (N + 2) ∉ ⋃ n ∈ Finset.range N, Ioo (c / (n + 2)) c := by\n  intro c hc\n  refine ⟨?_, fun N => ⟨⟨by positivity, by rw [div_lt_iff₀ (by positivity)]; nlinarith⟩, ?_⟩⟩\n  · ext x\n    simp only [mem_iUnion, mem_Ioo]\n    constructor\n    · rintro ⟨n, h1, h2⟩; exact ⟨lt_trans (by positivity) h1, h2⟩\n    · rintro ⟨h1, h2⟩\n      obtain ⟨n, hn⟩ := exists_nat_gt (c / x)\n      refine ⟨n, ?_, h2⟩\n      rw [div_lt_iff₀ (by positivity)]\n      rw [div_lt_iff₀ h1] at hn\n      nlinarith\n  · simp only [mem_iUnion, mem_Ioo, Finset.mem_range, not_exists, not_and]\n    intro n hn h\n    exfalso\n    have : c / (N + 2) ≤ c / (n + 2) := by\n      apply div_le_div_of_nonneg_left hc.le (by positivity)\n      have : (n : ℝ) < N := by exact_mod_cast hn\n      linarith\n    linarith\nexact @key (2) ((by norm_num))'),
    (['1/2', '(by norm_num)'], False, 'set_option maxHeartbeats 2000000 in\nhave key : ∀ (c : ℝ) (hc : 0 < c), (⋃ n : ℕ, Ioo (c / (n + 2)) c) = Ioo 0 c ∧ ∀ N : ℕ, c / (N + 2) ∈ Ioo 0 c ∧ c / (N + 2) ∉ ⋃ n ∈ Finset.range N, Ioo (c / (n + 2)) c := by\n  intro c hc\n  refine ⟨?_, fun N => ⟨⟨by positivity, by rw [div_lt_iff₀ (by positivity)]; nlinarith⟩, ?_⟩⟩\n  · ext x\n    simp only [mem_iUnion, mem_Ioo]\n    constructor\n    · rintro ⟨n, h1, h2⟩; exact ⟨lt_trans (by positivity) h1, h2⟩\n    · rintro ⟨h1, h2⟩\n      obtain ⟨n, hn⟩ := exists_nat_gt (c / x)\n      refine ⟨n, ?_, h2⟩\n      rw [div_lt_iff₀ (by positivity)]\n      rw [div_lt_iff₀ h1] at hn\n      nlinarith\n  · simp only [mem_iUnion, mem_Ioo, Finset.mem_range, not_exists, not_and]\n    intro n hn h\n    exfalso\n    have : c / (N + 2) ≤ c / (n + 2) := by\n      apply div_le_div_of_nonneg_left hc.le (by positivity)\n      have : (n : ℝ) < N := by exact_mod_cast hn\n      linarith\n    linarith\nexact @key (1/2) ((by norm_num))'),
]
instances = [kernel_instance(*values, proof=proof, edge=edge) for values, edge, proof in CASES]
