# name: set-step-test
# technique: test fallback (test_fallback recipe): instances the kernel checks, chosen by hand
# goal: sage_test KaluzaKlein.Sets.Continuous.step_not_continuous
# description: the claim at the instances below, each proved independently of the claim
SEED = 0
CASES = [
    (['0'], True, "set_option maxHeartbeats 2000000 in\nhave key : ∀ (a : ℝ), step a ⁻¹' Ioo (1 / 2) 2 = Ici a ∧ ¬ IsOpen (Ici a) ∧ ¬ Continuous (step a) := by\n  intro a\n  have hpre : step a ⁻¹' Ioo (1 / 2) 2 = Ici a := by\n    ext x\n    simp only [step, mem_preimage, mem_Ioo, mem_Ici]\n    split_ifs with h\n    · constructor\n      · rintro ⟨h1, -⟩; norm_num at h1\n      · intro h2; linarith\n    · constructor\n      · intro _; linarith\n      · intro _; norm_num\n  have hno : ¬ IsOpen (Ici a) := fun h => by\n    have := h.mem_nhds (self_mem_Ici : a ∈ Ici a)\n    rw [mem_nhds_iff_exists_Ioo_subset] at this\n    obtain ⟨l, u, ⟨hl, hu⟩, hsub⟩ := this\n    have := hsub (show (l + a) / 2 ∈ Ioo l u from ⟨by linarith, by linarith⟩)\n    simp only [mem_Ici] at this\n    linarith\n  refine ⟨hpre, hno, fun hc => hno ?_⟩\n  rw [← hpre]\n  exact isOpen_Ioo.preimage hc\nexact @key (0)"),
    (['1'], False, "set_option maxHeartbeats 2000000 in\nhave key : ∀ (a : ℝ), step a ⁻¹' Ioo (1 / 2) 2 = Ici a ∧ ¬ IsOpen (Ici a) ∧ ¬ Continuous (step a) := by\n  intro a\n  have hpre : step a ⁻¹' Ioo (1 / 2) 2 = Ici a := by\n    ext x\n    simp only [step, mem_preimage, mem_Ioo, mem_Ici]\n    split_ifs with h\n    · constructor\n      · rintro ⟨h1, -⟩; norm_num at h1\n      · intro h2; linarith\n    · constructor\n      · intro _; linarith\n      · intro _; norm_num\n  have hno : ¬ IsOpen (Ici a) := fun h => by\n    have := h.mem_nhds (self_mem_Ici : a ∈ Ici a)\n    rw [mem_nhds_iff_exists_Ioo_subset] at this\n    obtain ⟨l, u, ⟨hl, hu⟩, hsub⟩ := this\n    have := hsub (show (l + a) / 2 ∈ Ioo l u from ⟨by linarith, by linarith⟩)\n    simp only [mem_Ici] at this\n    linarith\n  refine ⟨hpre, hno, fun hc => hno ?_⟩\n  rw [← hpre]\n  exact isOpen_Ioo.preimage hc\nexact @key (1)"),
    (['-2'], False, "set_option maxHeartbeats 2000000 in\nhave key : ∀ (a : ℝ), step a ⁻¹' Ioo (1 / 2) 2 = Ici a ∧ ¬ IsOpen (Ici a) ∧ ¬ Continuous (step a) := by\n  intro a\n  have hpre : step a ⁻¹' Ioo (1 / 2) 2 = Ici a := by\n    ext x\n    simp only [step, mem_preimage, mem_Ioo, mem_Ici]\n    split_ifs with h\n    · constructor\n      · rintro ⟨h1, -⟩; norm_num at h1\n      · intro h2; linarith\n    · constructor\n      · intro _; linarith\n      · intro _; norm_num\n  have hno : ¬ IsOpen (Ici a) := fun h => by\n    have := h.mem_nhds (self_mem_Ici : a ∈ Ici a)\n    rw [mem_nhds_iff_exists_Ioo_subset] at this\n    obtain ⟨l, u, ⟨hl, hu⟩, hsub⟩ := this\n    have := hsub (show (l + a) / 2 ∈ Ioo l u from ⟨by linarith, by linarith⟩)\n    simp only [mem_Ici] at this\n    linarith\n  refine ⟨hpre, hno, fun hc => hno ?_⟩\n  rw [← hpre]\n  exact isOpen_Ioo.preimage hc\nexact @key (-2)"),
]
instances = [kernel_instance(*values, proof=proof, edge=edge) for values, edge, proof in CASES]
