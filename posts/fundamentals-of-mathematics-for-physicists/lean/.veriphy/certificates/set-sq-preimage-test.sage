# name: set-sq-preimage-test
# technique: test fallback (test_fallback recipe): instances the kernel checks, chosen by hand
# goal: sage_test KaluzaKlein.Sets.Maps.sq_preimage_Icc
# description: the claim at the instances below, each proved independently of the claim
SEED = 0
CASES = [
    (['1', '2', '(by norm_num)', '(by norm_num)'], False, "set_option maxHeartbeats 2000000 in\nhave key : ∀ (a b : ℝ) (ha : 0 ≤ a) (hab : a ≤ b), (fun x : ℝ => x ^ 2) ⁻¹' Set.Icc (a ^ 2) (b ^ 2) = Set.Icc (-b) (-a) ∪ Set.Icc a b := by\n  intro a b ha hab\n  ext x\n  simp only [Set.mem_preimage, Set.mem_Icc, Set.mem_union]\n  constructor\n  · rintro ⟨h1, h2⟩\n    have hb : |x| ≤ b := abs_le_of_sq_le_sq' h2 (by linarith) |>.elim (fun h1' h2' => abs_le.2 ⟨h1', h2'⟩)\n    have ha' : a ≤ |x| := by\n      rw [← Real.sqrt_sq ha, ← Real.sqrt_sq_eq_abs]; exact Real.sqrt_le_sqrt h1\n    rcases le_or_gt 0 x with hx | hx\n    · rw [abs_of_nonneg hx] at hb ha'; right; exact ⟨ha', hb⟩\n    · rw [abs_of_neg hx] at hb ha'; left; constructor <;> linarith\n  · rintro (⟨h1, h2⟩ | ⟨h1, h2⟩)\n    · constructor <;> nlinarith\n    · constructor <;> nlinarith\nexact @key (1) (2) ((by norm_num)) ((by norm_num))"),
    (['0', '1', '(by norm_num)', '(by norm_num)'], True, "set_option maxHeartbeats 2000000 in\nhave key : ∀ (a b : ℝ) (ha : 0 ≤ a) (hab : a ≤ b), (fun x : ℝ => x ^ 2) ⁻¹' Set.Icc (a ^ 2) (b ^ 2) = Set.Icc (-b) (-a) ∪ Set.Icc a b := by\n  intro a b ha hab\n  ext x\n  simp only [Set.mem_preimage, Set.mem_Icc, Set.mem_union]\n  constructor\n  · rintro ⟨h1, h2⟩\n    have hb : |x| ≤ b := abs_le_of_sq_le_sq' h2 (by linarith) |>.elim (fun h1' h2' => abs_le.2 ⟨h1', h2'⟩)\n    have ha' : a ≤ |x| := by\n      rw [← Real.sqrt_sq ha, ← Real.sqrt_sq_eq_abs]; exact Real.sqrt_le_sqrt h1\n    rcases le_or_gt 0 x with hx | hx\n    · rw [abs_of_nonneg hx] at hb ha'; right; exact ⟨ha', hb⟩\n    · rw [abs_of_neg hx] at hb ha'; left; constructor <;> linarith\n  · rintro (⟨h1, h2⟩ | ⟨h1, h2⟩)\n    · constructor <;> nlinarith\n    · constructor <;> nlinarith\nexact @key (0) (1) ((by norm_num)) ((by norm_num))"),
    (['3', '3', '(by norm_num)', '(by norm_num)'], False, "set_option maxHeartbeats 2000000 in\nhave key : ∀ (a b : ℝ) (ha : 0 ≤ a) (hab : a ≤ b), (fun x : ℝ => x ^ 2) ⁻¹' Set.Icc (a ^ 2) (b ^ 2) = Set.Icc (-b) (-a) ∪ Set.Icc a b := by\n  intro a b ha hab\n  ext x\n  simp only [Set.mem_preimage, Set.mem_Icc, Set.mem_union]\n  constructor\n  · rintro ⟨h1, h2⟩\n    have hb : |x| ≤ b := abs_le_of_sq_le_sq' h2 (by linarith) |>.elim (fun h1' h2' => abs_le.2 ⟨h1', h2'⟩)\n    have ha' : a ≤ |x| := by\n      rw [← Real.sqrt_sq ha, ← Real.sqrt_sq_eq_abs]; exact Real.sqrt_le_sqrt h1\n    rcases le_or_gt 0 x with hx | hx\n    · rw [abs_of_nonneg hx] at hb ha'; right; exact ⟨ha', hb⟩\n    · rw [abs_of_neg hx] at hb ha'; left; constructor <;> linarith\n  · rintro (⟨h1, h2⟩ | ⟨h1, h2⟩)\n    · constructor <;> nlinarith\n    · constructor <;> nlinarith\nexact @key (3) (3) ((by norm_num)) ((by norm_num))"),
]
instances = [kernel_instance(*values, proof=proof, edge=edge) for values, edge, proof in CASES]
