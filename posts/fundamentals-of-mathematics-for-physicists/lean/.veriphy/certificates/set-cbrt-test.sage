# name: set-cbrt-test
# technique: test fallback (test_fallback recipe): instances the kernel checks, chosen by hand
# goal: sage_test KaluzaKlein.Sets.Inverse.cbrt_inverse
# description: the claim at the instances below, each proved independently of the claim
SEED = 0
CASES = [
    (['0', '0'], True, 'set_option maxHeartbeats 2000000 in\nhave key : ∀ (x y : ℝ), cbrt (x ^ 3) = x ∧ cbrt y ^ 3 = y := by\n  intro x y\n  have h3 : ((3 : ℕ) : ℝ) ≠ 0 := by norm_num\n  have key : ∀ y : ℝ, cbrt y ^ 3 = y := by\n    intro y\n    unfold cbrt\n    split_ifs with hy\n    · rw [← Real.rpow_natCast, ← Real.rpow_mul hy, inv_mul_cancel₀ h3, Real.rpow_one]\n    · rw [neg_pow, ← Real.rpow_natCast ((-y) ^ _), ← Real.rpow_mul (by linarith), inv_mul_cancel₀ h3,\n        Real.rpow_one]\n      norm_num\n  refine ⟨?_, key y⟩\n  have hinj : Function.Injective (fun x : ℝ => x ^ 3) := (Odd.strictMono_pow (by decide : Odd 3)).injective\n  exact hinj (key (x ^ 3))\nexact @key (0) (0)'),
    (['2', '8'], False, 'set_option maxHeartbeats 2000000 in\nhave key : ∀ (x y : ℝ), cbrt (x ^ 3) = x ∧ cbrt y ^ 3 = y := by\n  intro x y\n  have h3 : ((3 : ℕ) : ℝ) ≠ 0 := by norm_num\n  have key : ∀ y : ℝ, cbrt y ^ 3 = y := by\n    intro y\n    unfold cbrt\n    split_ifs with hy\n    · rw [← Real.rpow_natCast, ← Real.rpow_mul hy, inv_mul_cancel₀ h3, Real.rpow_one]\n    · rw [neg_pow, ← Real.rpow_natCast ((-y) ^ _), ← Real.rpow_mul (by linarith), inv_mul_cancel₀ h3,\n        Real.rpow_one]\n      norm_num\n  refine ⟨?_, key y⟩\n  have hinj : Function.Injective (fun x : ℝ => x ^ 3) := (Odd.strictMono_pow (by decide : Odd 3)).injective\n  exact hinj (key (x ^ 3))\nexact @key (2) (8)'),
    (['-2', '-27'], False, 'set_option maxHeartbeats 2000000 in\nhave key : ∀ (x y : ℝ), cbrt (x ^ 3) = x ∧ cbrt y ^ 3 = y := by\n  intro x y\n  have h3 : ((3 : ℕ) : ℝ) ≠ 0 := by norm_num\n  have key : ∀ y : ℝ, cbrt y ^ 3 = y := by\n    intro y\n    unfold cbrt\n    split_ifs with hy\n    · rw [← Real.rpow_natCast, ← Real.rpow_mul hy, inv_mul_cancel₀ h3, Real.rpow_one]\n    · rw [neg_pow, ← Real.rpow_natCast ((-y) ^ _), ← Real.rpow_mul (by linarith), inv_mul_cancel₀ h3,\n        Real.rpow_one]\n      norm_num\n  refine ⟨?_, key y⟩\n  have hinj : Function.Injective (fun x : ℝ => x ^ 3) := (Odd.strictMono_pow (by decide : Odd 3)).injective\n  exact hinj (key (x ^ 3))\nexact @key (-2) (-27)'),
]
instances = [kernel_instance(*values, proof=proof, edge=edge) for values, edge, proof in CASES]
