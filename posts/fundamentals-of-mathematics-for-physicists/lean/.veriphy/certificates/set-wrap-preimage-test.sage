# name: set-wrap-preimage-test
# technique: test fallback (test_fallback recipe): instances the kernel checks, chosen by hand
# goal: sage_test KaluzaKlein.Sets.Maps.wrap_preimage
# description: the claim at the instances below, each proved independently of the claim
SEED = 0
CASES = [
    (['0'], True, "set_option maxHeartbeats 2000000 in\nhave key : ∀ (a : ℝ), wrap ⁻¹' {wrap a} = {φ | ∃ k : ℤ, φ = a + k * (2 * Real.pi)} := by\n  intro a\n  ext φ\n  simp only [wrap, Set.mem_preimage, Set.mem_singleton_iff, Prod.mk.injEq, Set.mem_setOf_eq]\n  have key : (Real.cos φ = Real.cos a ∧ Real.sin φ = Real.sin a) ↔\n      Complex.exp (φ * Complex.I) = Complex.exp (a * Complex.I) := by\n    rw [Complex.ext_iff, Complex.exp_ofReal_mul_I_re, Complex.exp_ofReal_mul_I_re, Complex.exp_ofReal_mul_I_im,\n      Complex.exp_ofReal_mul_I_im]\n  rw [key, Complex.exp_eq_exp_iff_exists_int]\n  constructor\n  · rintro ⟨n, hn⟩\n    refine ⟨n, ?_⟩\n    have := congrArg Complex.im hn\n    simp at this\n    linarith\n  · rintro ⟨k, rfl⟩\n    refine ⟨k, ?_⟩\n    push_cast; ring\nexact @key (0)"),
    (['Real.pi / 2'], False, "set_option maxHeartbeats 2000000 in\nhave key : ∀ (a : ℝ), wrap ⁻¹' {wrap a} = {φ | ∃ k : ℤ, φ = a + k * (2 * Real.pi)} := by\n  intro a\n  ext φ\n  simp only [wrap, Set.mem_preimage, Set.mem_singleton_iff, Prod.mk.injEq, Set.mem_setOf_eq]\n  have key : (Real.cos φ = Real.cos a ∧ Real.sin φ = Real.sin a) ↔\n      Complex.exp (φ * Complex.I) = Complex.exp (a * Complex.I) := by\n    rw [Complex.ext_iff, Complex.exp_ofReal_mul_I_re, Complex.exp_ofReal_mul_I_re, Complex.exp_ofReal_mul_I_im,\n      Complex.exp_ofReal_mul_I_im]\n  rw [key, Complex.exp_eq_exp_iff_exists_int]\n  constructor\n  · rintro ⟨n, hn⟩\n    refine ⟨n, ?_⟩\n    have := congrArg Complex.im hn\n    simp at this\n    linarith\n  · rintro ⟨k, rfl⟩\n    refine ⟨k, ?_⟩\n    push_cast; ring\nexact @key (Real.pi / 2)"),
    (['Real.pi'], False, "set_option maxHeartbeats 2000000 in\nhave key : ∀ (a : ℝ), wrap ⁻¹' {wrap a} = {φ | ∃ k : ℤ, φ = a + k * (2 * Real.pi)} := by\n  intro a\n  ext φ\n  simp only [wrap, Set.mem_preimage, Set.mem_singleton_iff, Prod.mk.injEq, Set.mem_setOf_eq]\n  have key : (Real.cos φ = Real.cos a ∧ Real.sin φ = Real.sin a) ↔\n      Complex.exp (φ * Complex.I) = Complex.exp (a * Complex.I) := by\n    rw [Complex.ext_iff, Complex.exp_ofReal_mul_I_re, Complex.exp_ofReal_mul_I_re, Complex.exp_ofReal_mul_I_im,\n      Complex.exp_ofReal_mul_I_im]\n  rw [key, Complex.exp_eq_exp_iff_exists_int]\n  constructor\n  · rintro ⟨n, hn⟩\n    refine ⟨n, ?_⟩\n    have := congrArg Complex.im hn\n    simp at this\n    linarith\n  · rintro ⟨k, rfl⟩\n    refine ⟨k, ?_⟩\n    push_cast; ring\nexact @key (Real.pi)"),
]
instances = [kernel_instance(*values, proof=proof, edge=edge) for values, edge, proof in CASES]
