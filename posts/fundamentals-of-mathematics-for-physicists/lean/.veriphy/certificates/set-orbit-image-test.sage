# name: set-orbit-image-test
# technique: test fallback (test_fallback recipe): instances the kernel checks, chosen by hand
# goal: sage_test KaluzaKlein.Sets.Maps.orbit_image
# description: the claim at the instances below, each proved independently of the claim
SEED = 0
CASES = [
    (['KaluzaKlein.Sets.Sets.northPole'], True, 'set_option maxHeartbeats 2000000 in\nhave key : ∀ (p : Fin 3 → ℝ), p ∈ sphere ↔ ∃ g ∈ SO3, orbit g = p := by\n  intro p\n  constructor\n  · intro hp; exact ⟨rotTo p, rotTo_mem p hp, rotTo_orbit p hp⟩\n  · rintro ⟨g, hg, rfl⟩\n    rw [mem_SO3_iff] at hg\n    have h22 := congrFun (congrFun hg.1 2) 2\n    simp [Matrix.mul_apply, Fin.sum_univ_succ] at h22\n    simp only [sphere, Set.mem_setOf_eq, orbit, northPole]\n    simp [Matrix.mulVec, dotProduct, Fin.sum_univ_succ]\n    nlinarith [h22]\nexact @key (KaluzaKlein.Sets.Sets.northPole)'),
    (['![1, 0, 0]'], False, 'set_option maxHeartbeats 2000000 in\nhave key : ∀ (p : Fin 3 → ℝ), p ∈ sphere ↔ ∃ g ∈ SO3, orbit g = p := by\n  intro p\n  constructor\n  · intro hp; exact ⟨rotTo p, rotTo_mem p hp, rotTo_orbit p hp⟩\n  · rintro ⟨g, hg, rfl⟩\n    rw [mem_SO3_iff] at hg\n    have h22 := congrFun (congrFun hg.1 2) 2\n    simp [Matrix.mul_apply, Fin.sum_univ_succ] at h22\n    simp only [sphere, Set.mem_setOf_eq, orbit, northPole]\n    simp [Matrix.mulVec, dotProduct, Fin.sum_univ_succ]\n    nlinarith [h22]\nexact @key (![1, 0, 0])'),
    (['![0, 0, -1]'], False, 'set_option maxHeartbeats 2000000 in\nhave key : ∀ (p : Fin 3 → ℝ), p ∈ sphere ↔ ∃ g ∈ SO3, orbit g = p := by\n  intro p\n  constructor\n  · intro hp; exact ⟨rotTo p, rotTo_mem p hp, rotTo_orbit p hp⟩\n  · rintro ⟨g, hg, rfl⟩\n    rw [mem_SO3_iff] at hg\n    have h22 := congrFun (congrFun hg.1 2) 2\n    simp [Matrix.mul_apply, Fin.sum_univ_succ] at h22\n    simp only [sphere, Set.mem_setOf_eq, orbit, northPole]\n    simp [Matrix.mulVec, dotProduct, Fin.sum_univ_succ]\n    nlinarith [h22]\nexact @key (![0, 0, -1])'),
    (['![3/5, 0, 4/5]'], False, 'set_option maxHeartbeats 2000000 in\nhave key : ∀ (p : Fin 3 → ℝ), p ∈ sphere ↔ ∃ g ∈ SO3, orbit g = p := by\n  intro p\n  constructor\n  · intro hp; exact ⟨rotTo p, rotTo_mem p hp, rotTo_orbit p hp⟩\n  · rintro ⟨g, hg, rfl⟩\n    rw [mem_SO3_iff] at hg\n    have h22 := congrFun (congrFun hg.1 2) 2\n    simp [Matrix.mul_apply, Fin.sum_univ_succ] at h22\n    simp only [sphere, Set.mem_setOf_eq, orbit, northPole]\n    simp [Matrix.mulVec, dotProduct, Fin.sum_univ_succ]\n    nlinarith [h22]\nexact @key (![3/5, 0, 4/5])'),
]
instances = [kernel_instance(*values, proof=proof, edge=edge) for values, edge, proof in CASES]
