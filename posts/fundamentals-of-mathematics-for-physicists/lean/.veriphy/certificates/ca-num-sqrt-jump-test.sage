# name: ca-num-sqrt-jump-test
# technique: test fallback (test_fallback recipe): the claim at instances the kernel checks by computation
# goal: sage_test KaluzaKlein.ComplexAnalysis.Branches.sqrt_jump file "ca-num-sqrt-jump-test.sage"
# description: a limit statement; each instance is rechecked by the kernel through the general argument; instances with an edge case first
SEED = 0
RI = RealIntervalField(128)
instances = []
CI = ComplexIntervalField(128)
def cdiff(a, b):
    d = CI(a) - CI(b)
    return RI(d.real().abs() + d.imag().abs())
CB = ComplexBallField(128)
def bdiff(a, b):
    d = a - b
    return RI(d.real().abs()) + RI(d.imag().abs())
instances.append(kernel_instance(*['(-4)', '(by norm_num)'], proof="set x : ℝ := (-4) with hxv\nhave hx : x < 0 := by rw [hxv]; norm_num\nhave hx0 : (x : ℂ) ≠ 0 := by exact_mod_cast hx.ne\nhave hsq : Real.exp (Real.log |x| / 2) = √|x| := by\n  rw [Real.sqrt_eq_rpow, Real.rpow_def_of_pos (abs_pos.mpr hx.ne)]; ring_nf\nhave hA : Complex.exp ((Real.log |x| + π * I) * (1 / 2)) = √|x| * I := by\n  rw [show ((Real.log |x| : ℝ) + π * I : ℂ) * (1 / 2) = ((Real.log |x| / 2 : ℝ) : ℂ) + π / 2 * I by\n    push_cast; ring, Complex.exp_add, Complex.exp_pi_div_two_mul_I, ← Complex.ofReal_exp, hsq]\nhave hB : Complex.exp ((Real.log |x| - π * I) * (1 / 2)) = -(√|x| * I) := by\n  rw [show ((Real.log |x| : ℝ) - π * I : ℂ) * (1 / 2) = ((Real.log |x| / 2 : ℝ) : ℂ) + -(π / 2 * I) by\n    push_cast; ring, Complex.exp_add, Complex.exp_neg, Complex.exp_pi_div_two_mul_I, Complex.inv_I,\n    ← Complex.ofReal_exp, hsq]\n  ring\nhave hev : ∀ᶠ z in 𝓝 (x : ℂ), z ^ (1 / 2 : ℂ) = Complex.exp (Complex.log z * (1 / 2)) := by\n  filter_upwards [isOpen_compl_singleton.mem_nhds hx0] with z hz\n  exact Complex.cpow_def_of_ne_zero hz _\nconstructor\n· have h := ((Complex.continuous_exp.tendsto _).comp\n    (((log_jump x hx).1).mul_const (1 / 2 : ℂ)))\n  rw [hA] at h\n  exact h.congr' (eventually_nhdsWithin_of_eventually_nhds (hev.mono fun z hz => hz.symm))\n· have h := ((Complex.continuous_exp.tendsto _).comp\n    (((log_jump x hx).2).mul_const (1 / 2 : ℂ)))\n  rw [hB] at h\n  exact h.congr' (eventually_nhdsWithin_of_eventually_nhds (hev.mono fun z hz => hz.symm))", edge=True))
instances.append(kernel_instance(*['(-1)', '(by norm_num)'], proof="set x : ℝ := (-1) with hxv\nhave hx : x < 0 := by rw [hxv]; norm_num\nhave hx0 : (x : ℂ) ≠ 0 := by exact_mod_cast hx.ne\nhave hsq : Real.exp (Real.log |x| / 2) = √|x| := by\n  rw [Real.sqrt_eq_rpow, Real.rpow_def_of_pos (abs_pos.mpr hx.ne)]; ring_nf\nhave hA : Complex.exp ((Real.log |x| + π * I) * (1 / 2)) = √|x| * I := by\n  rw [show ((Real.log |x| : ℝ) + π * I : ℂ) * (1 / 2) = ((Real.log |x| / 2 : ℝ) : ℂ) + π / 2 * I by\n    push_cast; ring, Complex.exp_add, Complex.exp_pi_div_two_mul_I, ← Complex.ofReal_exp, hsq]\nhave hB : Complex.exp ((Real.log |x| - π * I) * (1 / 2)) = -(√|x| * I) := by\n  rw [show ((Real.log |x| : ℝ) - π * I : ℂ) * (1 / 2) = ((Real.log |x| / 2 : ℝ) : ℂ) + -(π / 2 * I) by\n    push_cast; ring, Complex.exp_add, Complex.exp_neg, Complex.exp_pi_div_two_mul_I, Complex.inv_I,\n    ← Complex.ofReal_exp, hsq]\n  ring\nhave hev : ∀ᶠ z in 𝓝 (x : ℂ), z ^ (1 / 2 : ℂ) = Complex.exp (Complex.log z * (1 / 2)) := by\n  filter_upwards [isOpen_compl_singleton.mem_nhds hx0] with z hz\n  exact Complex.cpow_def_of_ne_zero hz _\nconstructor\n· have h := ((Complex.continuous_exp.tendsto _).comp\n    (((log_jump x hx).1).mul_const (1 / 2 : ℂ)))\n  rw [hA] at h\n  exact h.congr' (eventually_nhdsWithin_of_eventually_nhds (hev.mono fun z hz => hz.symm))\n· have h := ((Complex.continuous_exp.tendsto _).comp\n    (((log_jump x hx).2).mul_const (1 / 2 : ℂ)))\n  rw [hB] at h\n  exact h.congr' (eventually_nhdsWithin_of_eventually_nhds (hev.mono fun z hz => hz.symm))", edge=False))
instances.append(kernel_instance(*['(-1 / 2)', '(by norm_num)'], proof="set x : ℝ := (-1 / 2) with hxv\nhave hx : x < 0 := by rw [hxv]; norm_num\nhave hx0 : (x : ℂ) ≠ 0 := by exact_mod_cast hx.ne\nhave hsq : Real.exp (Real.log |x| / 2) = √|x| := by\n  rw [Real.sqrt_eq_rpow, Real.rpow_def_of_pos (abs_pos.mpr hx.ne)]; ring_nf\nhave hA : Complex.exp ((Real.log |x| + π * I) * (1 / 2)) = √|x| * I := by\n  rw [show ((Real.log |x| : ℝ) + π * I : ℂ) * (1 / 2) = ((Real.log |x| / 2 : ℝ) : ℂ) + π / 2 * I by\n    push_cast; ring, Complex.exp_add, Complex.exp_pi_div_two_mul_I, ← Complex.ofReal_exp, hsq]\nhave hB : Complex.exp ((Real.log |x| - π * I) * (1 / 2)) = -(√|x| * I) := by\n  rw [show ((Real.log |x| : ℝ) - π * I : ℂ) * (1 / 2) = ((Real.log |x| / 2 : ℝ) : ℂ) + -(π / 2 * I) by\n    push_cast; ring, Complex.exp_add, Complex.exp_neg, Complex.exp_pi_div_two_mul_I, Complex.inv_I,\n    ← Complex.ofReal_exp, hsq]\n  ring\nhave hev : ∀ᶠ z in 𝓝 (x : ℂ), z ^ (1 / 2 : ℂ) = Complex.exp (Complex.log z * (1 / 2)) := by\n  filter_upwards [isOpen_compl_singleton.mem_nhds hx0] with z hz\n  exact Complex.cpow_def_of_ne_zero hz _\nconstructor\n· have h := ((Complex.continuous_exp.tendsto _).comp\n    (((log_jump x hx).1).mul_const (1 / 2 : ℂ)))\n  rw [hA] at h\n  exact h.congr' (eventually_nhdsWithin_of_eventually_nhds (hev.mono fun z hz => hz.symm))\n· have h := ((Complex.continuous_exp.tendsto _).comp\n    (((log_jump x hx).2).mul_const (1 / 2 : ℂ)))\n  rw [hB] at h\n  exact h.congr' (eventually_nhdsWithin_of_eventually_nhds (hev.mono fun z hz => hz.symm))", edge=False))
print([(x.values, x.kind, x.verdict) for x in instances])
