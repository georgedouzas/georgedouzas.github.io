# name: set-unique-remainder-test
# technique: test fallback (test_fallback recipe): instances the kernel checks, chosen by hand
# goal: sage_test KaluzaKlein.Sets.Products.unique_remainder
# description: the claim at the instances below, each proved independently of the claim
SEED = 0
CASES = [
    (['3', '(by norm_num)', '7'], False, 'set_option maxHeartbeats 2000000 in\nhave key : ∀ (n : ℕ) (hn : 1 ≤ n) (a : ℤ), ∃! r : ℕ, r < n ∧ a ≡ r [ZMOD n] := by\n  intro n hn a\n  refine ⟨(a % n).toNat, ⟨?_, ?_⟩, ?_⟩\n  · have h1 := Int.emod_nonneg a (by omega : (n : ℤ) ≠ 0)\n    have h2 := Int.emod_lt_of_pos a (by omega : (0 : ℤ) < n)\n    omega\n  · have h1 := Int.emod_nonneg a (by omega : (n : ℤ) ≠ 0)\n    rw [Int.toNat_of_nonneg h1]\n    exact (Int.mod_modEq a n).symm\n  · rintro r ⟨hr, har⟩\n    have h1 := Int.emod_nonneg a (by omega : (n : ℤ) ≠ 0)\n    have : (r : ℤ) = a % n := by\n      rw [Int.ModEq] at har\n      rw [har, Int.emod_eq_of_lt (by omega) (by omega)]\n    omega\nexact @key (3) ((by norm_num)) (7)'),
    (['1', '(by norm_num)', '0'], True, 'set_option maxHeartbeats 2000000 in\nhave key : ∀ (n : ℕ) (hn : 1 ≤ n) (a : ℤ), ∃! r : ℕ, r < n ∧ a ≡ r [ZMOD n] := by\n  intro n hn a\n  refine ⟨(a % n).toNat, ⟨?_, ?_⟩, ?_⟩\n  · have h1 := Int.emod_nonneg a (by omega : (n : ℤ) ≠ 0)\n    have h2 := Int.emod_lt_of_pos a (by omega : (0 : ℤ) < n)\n    omega\n  · have h1 := Int.emod_nonneg a (by omega : (n : ℤ) ≠ 0)\n    rw [Int.toNat_of_nonneg h1]\n    exact (Int.mod_modEq a n).symm\n  · rintro r ⟨hr, har⟩\n    have h1 := Int.emod_nonneg a (by omega : (n : ℤ) ≠ 0)\n    have : (r : ℤ) = a % n := by\n      rw [Int.ModEq] at har\n      rw [har, Int.emod_eq_of_lt (by omega) (by omega)]\n    omega\nexact @key (1) ((by norm_num)) (0)'),
    (['5', '(by norm_num)', '-12'], False, 'set_option maxHeartbeats 2000000 in\nhave key : ∀ (n : ℕ) (hn : 1 ≤ n) (a : ℤ), ∃! r : ℕ, r < n ∧ a ≡ r [ZMOD n] := by\n  intro n hn a\n  refine ⟨(a % n).toNat, ⟨?_, ?_⟩, ?_⟩\n  · have h1 := Int.emod_nonneg a (by omega : (n : ℤ) ≠ 0)\n    have h2 := Int.emod_lt_of_pos a (by omega : (0 : ℤ) < n)\n    omega\n  · have h1 := Int.emod_nonneg a (by omega : (n : ℤ) ≠ 0)\n    rw [Int.toNat_of_nonneg h1]\n    exact (Int.mod_modEq a n).symm\n  · rintro r ⟨hr, har⟩\n    have h1 := Int.emod_nonneg a (by omega : (n : ℤ) ≠ 0)\n    have : (r : ℤ) = a % n := by\n      rw [Int.ModEq] at har\n      rw [har, Int.emod_eq_of_lt (by omega) (by omega)]\n    omega\nexact @key (5) ((by norm_num)) (-12)'),
]
instances = [kernel_instance(*values, proof=proof, edge=edge) for values, edge, proof in CASES]
