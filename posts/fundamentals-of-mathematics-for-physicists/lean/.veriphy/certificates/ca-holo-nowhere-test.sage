# name: ca-holo-nowhere-test
# technique: test fallback (kernel-checked instances)
# goal: sage_test KaluzaKlein.ComplexAnalysis.HolomorphicFunctions.nowhere_holomorphic
# description: conj, Re, |·|, |·|^2 are holomorphic at none of 0, 1, i; each instance proved by computation or mathlib, independently of the claim.
SEED = 0
CASES = [
    (['0'], 'refine ⟨fun h => ?_, fun h => ?_, fun h => ?_, fun h => ?_⟩\n· exact (KaluzaKlein.ComplexAnalysis.ComplexDerivative.conj_not_differentiableAt _).2 (Filter.Eventually.self_of_nhds h)\n· exact KaluzaKlein.ComplexAnalysis.ComplexDerivative.re_not_differentiableAt _ (Filter.Eventually.self_of_nhds h)\n· obtain ⟨w, hw, hd⟩ := KaluzaKlein.ComplexAnalysis.HolomorphicFunctions.exists_ne_zero_of_eventually h\n  exact KaluzaKlein.ComplexAnalysis.HolomorphicFunctions.abs_not_differentiableAt w hw hd\n· obtain ⟨w, hw, hd⟩ := KaluzaKlein.ComplexAnalysis.HolomorphicFunctions.exists_ne_zero_of_eventually h\n  exact hw (((KaluzaKlein.ComplexAnalysis.ComplexDerivative.normSq_differentiableAt_iff w).1).1 hd)', True),
    (['1'], 'refine ⟨fun h => ?_, fun h => ?_, fun h => ?_, fun h => ?_⟩\n· exact (KaluzaKlein.ComplexAnalysis.ComplexDerivative.conj_not_differentiableAt _).2 (Filter.Eventually.self_of_nhds h)\n· exact KaluzaKlein.ComplexAnalysis.ComplexDerivative.re_not_differentiableAt _ (Filter.Eventually.self_of_nhds h)\n· obtain ⟨w, hw, hd⟩ := KaluzaKlein.ComplexAnalysis.HolomorphicFunctions.exists_ne_zero_of_eventually h\n  exact KaluzaKlein.ComplexAnalysis.HolomorphicFunctions.abs_not_differentiableAt w hw hd\n· obtain ⟨w, hw, hd⟩ := KaluzaKlein.ComplexAnalysis.HolomorphicFunctions.exists_ne_zero_of_eventually h\n  exact hw (((KaluzaKlein.ComplexAnalysis.ComplexDerivative.normSq_differentiableAt_iff w).1).1 hd)', False),
    (['Complex.I'], 'refine ⟨fun h => ?_, fun h => ?_, fun h => ?_, fun h => ?_⟩\n· exact (KaluzaKlein.ComplexAnalysis.ComplexDerivative.conj_not_differentiableAt _).2 (Filter.Eventually.self_of_nhds h)\n· exact KaluzaKlein.ComplexAnalysis.ComplexDerivative.re_not_differentiableAt _ (Filter.Eventually.self_of_nhds h)\n· obtain ⟨w, hw, hd⟩ := KaluzaKlein.ComplexAnalysis.HolomorphicFunctions.exists_ne_zero_of_eventually h\n  exact KaluzaKlein.ComplexAnalysis.HolomorphicFunctions.abs_not_differentiableAt w hw hd\n· obtain ⟨w, hw, hd⟩ := KaluzaKlein.ComplexAnalysis.HolomorphicFunctions.exists_ne_zero_of_eventually h\n  exact hw (((KaluzaKlein.ComplexAnalysis.ComplexDerivative.normSq_differentiableAt_iff w).1).1 hd)', False),
]
instances = [kernel_instance(*values, proof=proof, edge=edge) for values, proof, edge in CASES]
