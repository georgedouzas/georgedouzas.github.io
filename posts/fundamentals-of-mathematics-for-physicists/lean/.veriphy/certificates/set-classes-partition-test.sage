# name: set-classes-partition-test
# technique: test fallback (test_fallback recipe): instances the kernel checks, chosen by hand
# goal: sage_test KaluzaKlein.Sets.Equivalence.classes_partition
# description: the claim at the instances below, each proved independently of the claim
SEED = 0
CASES = [
    (['ℤ', '⟨fun a b => (3 : ℤ) ∣ a - b, KaluzaKlein.Sets.Equivalence.modEq_equivalence 3⟩', '1', '4'], False, 'set_option maxHeartbeats 2000000 in\nhave key : ∀ {X : Type} (s : Setoid X) (x y : X), ({z | s z x} = {z | s z y} ∨ Disjoint {z | s z x} {z | s z y}) ∧ x ∈ {z | s z x} ∧ (∀ w, x ∈ {z | s z w} → {z | s z w} = {z | s z x}) := by\n  intro X s x y\n  refine ⟨?_, s.refl x, fun w hw => ?_⟩\n  · by_cases h : s x y\n    · left; ext z; exact ⟨fun hz => s.trans hz h, fun hz => s.trans hz (s.symm h)⟩\n    · right\n      rw [Set.disjoint_left]\n      intro z hzx hzy\n      exact h (s.trans (s.symm hzx) hzy)\n  · ext z; exact ⟨fun hz => s.trans hz (s.symm hw), fun hz => s.trans hz hw⟩\nexact @key (ℤ) (⟨fun a b => (3 : ℤ) ∣ a - b, KaluzaKlein.Sets.Equivalence.modEq_equivalence 3⟩) (1) (4)'),
    (['Unit', '⊥', '()', '()'], True, 'set_option maxHeartbeats 2000000 in\nhave key : ∀ {X : Type} (s : Setoid X) (x y : X), ({z | s z x} = {z | s z y} ∨ Disjoint {z | s z x} {z | s z y}) ∧ x ∈ {z | s z x} ∧ (∀ w, x ∈ {z | s z w} → {z | s z w} = {z | s z x}) := by\n  intro X s x y\n  refine ⟨?_, s.refl x, fun w hw => ?_⟩\n  · by_cases h : s x y\n    · left; ext z; exact ⟨fun hz => s.trans hz h, fun hz => s.trans hz (s.symm h)⟩\n    · right\n      rw [Set.disjoint_left]\n      intro z hzx hzy\n      exact h (s.trans (s.symm hzx) hzy)\n  · ext z; exact ⟨fun hz => s.trans hz (s.symm hw), fun hz => s.trans hz hw⟩\nexact @key (Unit) (⊥) (()) (())'),
    (['ℤ', '⟨fun a b => (3 : ℤ) ∣ a - b, KaluzaKlein.Sets.Equivalence.modEq_equivalence 3⟩', '0', '2'], False, 'set_option maxHeartbeats 2000000 in\nhave key : ∀ {X : Type} (s : Setoid X) (x y : X), ({z | s z x} = {z | s z y} ∨ Disjoint {z | s z x} {z | s z y}) ∧ x ∈ {z | s z x} ∧ (∀ w, x ∈ {z | s z w} → {z | s z w} = {z | s z x}) := by\n  intro X s x y\n  refine ⟨?_, s.refl x, fun w hw => ?_⟩\n  · by_cases h : s x y\n    · left; ext z; exact ⟨fun hz => s.trans hz h, fun hz => s.trans hz (s.symm h)⟩\n    · right\n      rw [Set.disjoint_left]\n      intro z hzx hzy\n      exact h (s.trans (s.symm hzx) hzy)\n  · ext z; exact ⟨fun hz => s.trans hz (s.symm hw), fun hz => s.trans hz hw⟩\nexact @key (ℤ) (⟨fun a b => (3 : ℤ) ∣ a - b, KaluzaKlein.Sets.Equivalence.modEq_equivalence 3⟩) (0) (2)'),
]
instances = [kernel_instance(*values, proof=proof, edge=edge) for values, edge, proof in CASES]
