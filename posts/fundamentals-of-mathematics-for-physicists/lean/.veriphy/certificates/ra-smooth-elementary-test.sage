# name: ra-smooth-elementary-test
# technique: test a claim no recipe certifies, at instances the kernel checks by computation
# goal: sage_test KaluzaKlein.RealAnalysis.Calculus.smooth_elementary file "ra-smooth-elementary-test.sage"
# description: smoothness at sample polynomials (and exp, sin, cos, √ on (0, ∞), |x| not differentiable at 0)
SEED = 0  # the instances are listed, no sampling
PROOF = None
CASES = [(['(Polynomial.X : Polynomial ℝ)'], True, 'refine ⟨?_, Real.contDiff_exp, Real.contDiff_sin, Real.contDiff_cos, ?_, not_differentiableAt_abs_zero⟩\n· have h := Polynomial.contDiff_aeval (R := ℝ) (𝕜 := ℝ) ((Polynomial.X : Polynomial ℝ)) ((⊤ : ℕ∞) : WithTop ℕ∞)\n  first | (simp only [Polynomial.coe_aeval_eq_eval] at h; exact h) | simpa using h | (simp; done)\n· intro x hx\n  exact (Real.contDiffAt_sqrt (ne_of_gt hx)).contDiffWithinAt'), (['(Polynomial.X ^ 3 - 2 : Polynomial ℝ)'], False, 'refine ⟨?_, Real.contDiff_exp, Real.contDiff_sin, Real.contDiff_cos, ?_, not_differentiableAt_abs_zero⟩\n· have h := Polynomial.contDiff_aeval (R := ℝ) (𝕜 := ℝ) ((Polynomial.X ^ 3 - 2 : Polynomial ℝ)) ((⊤ : ℕ∞) : WithTop ℕ∞)\n  first | (simp only [Polynomial.coe_aeval_eq_eval] at h; exact h) | simpa using h | (simp; done)\n· intro x hx\n  exact (Real.contDiffAt_sqrt (ne_of_gt hx)).contDiffWithinAt'), (['(2 * Polynomial.X ^ 2 + 1 : Polynomial ℝ)'], False, 'refine ⟨?_, Real.contDiff_exp, Real.contDiff_sin, Real.contDiff_cos, ?_, not_differentiableAt_abs_zero⟩\n· have h := Polynomial.contDiff_aeval (R := ℝ) (𝕜 := ℝ) ((2 * Polynomial.X ^ 2 + 1 : Polynomial ℝ)) ((⊤ : ℕ∞) : WithTop ℕ∞)\n  first | (simp only [Polynomial.coe_aeval_eq_eval] at h; exact h) | simpa using h | (simp; done)\n· intro x hx\n  exact (Real.contDiffAt_sqrt (ne_of_gt hx)).contDiffWithinAt')]
instances = [kernel_instance(*values, proof=(p if p is not None else PROOF), edge=edge) for values, edge, p in CASES]
