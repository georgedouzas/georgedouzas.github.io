# name: set-edge-interior-test
# technique: test fallback (test_fallback recipe): instances the kernel checks, chosen by hand
# goal: sage_test KaluzaKlein.Sets.Quotients.edge_interior_classes
# description: the claim at the instances below, each proved independently of the claim
SEED = 0
CASES = [
    (['1/2', '(by norm_num)', '(1, 1/2)', '(by simp [KaluzaKlein.Sets.Quotients.square]; norm_num)'], False, 'set_option maxHeartbeats 2000000 in\nhave key : ∀ (v : ℝ) (hv : v ∈ Set.Ioo (0 : ℝ) 1) (q : ℝ × ℝ) (hq : q ∈ square 1), (Relation.EqvGen (glue 1) (0, v) q ↔ q = (0, v) ∨ q = (1, v)) ∧ (∀ u ∈ Set.Ioo (0 : ℝ) 1, Relation.EqvGen (glue 1) (u, v) q ↔ q = (u, v)) := by\n  intro v hv q hq\n  obtain ⟨hv0, hv1⟩ := hv\n  have hmem : ∀ u : ℝ, 0 ≤ u → u ≤ 1 → (u, v) ∈ square 1 := fun u h1 h2 => ⟨⟨h1, h2⟩, ⟨hv0.le, hv1.le⟩⟩\n  have hb : ∀ b : ℝ, (v = b ∨ (v = 0 ∧ b = 1) ∨ (v = 1 ∧ b = 0)) ↔ b = v := by\n    intro b\n    constructor\n    · rintro (h | ⟨h, -⟩ | ⟨h, -⟩)\n      · exact h.symm\n      · linarith\n      · linarith\n    · intro h; left; exact h.symm\n  constructor\n  · rw [glue_eqvGen_iff 1 one_pos _ q (hmem 0 le_rfl zero_le_one) hq, κ_eq_iff 1 _ _ one_pos,\n      κ_eq_iff 1 _ _ one_pos]\n    obtain ⟨a, b⟩ := q\n    simp only [Prod.mk.injEq]\n    rw [hb b]\n    constructor\n    · rintro ⟨h | ⟨-, h⟩ | ⟨h, -⟩, hbv⟩\n      · left; exact ⟨h.symm, hbv⟩\n      · right; exact ⟨h, hbv⟩\n      · norm_num at h\n    · rintro (⟨rfl, rfl⟩ | ⟨rfl, rfl⟩) <;> simp\n  · intro u hu\n    obtain ⟨hu0, hu1⟩ := hu\n    rw [glue_eqvGen_iff 1 one_pos _ q (hmem u hu0.le hu1.le) hq, κ_eq_iff 1 _ _ one_pos,\n      κ_eq_iff 1 _ _ one_pos]\n    obtain ⟨a, b⟩ := q\n    simp only [Prod.mk.injEq]\n    rw [hb b]\n    constructor\n    · rintro ⟨h | ⟨h, -⟩ | ⟨h, -⟩, hbv⟩\n      · exact ⟨h.symm, hbv⟩\n      · linarith\n      · linarith\n    · rintro ⟨rfl, rfl⟩\n      exact ⟨Or.inl rfl, by simp⟩\nexact @key (1/2) ((by norm_num)) ((1, 1/2)) ((by simp [KaluzaKlein.Sets.Quotients.square]; norm_num))'),
    (['1/2', '(by norm_num)', '(0, 1/2)', '(by simp [KaluzaKlein.Sets.Quotients.square]; norm_num)'], True, 'set_option maxHeartbeats 2000000 in\nhave key : ∀ (v : ℝ) (hv : v ∈ Set.Ioo (0 : ℝ) 1) (q : ℝ × ℝ) (hq : q ∈ square 1), (Relation.EqvGen (glue 1) (0, v) q ↔ q = (0, v) ∨ q = (1, v)) ∧ (∀ u ∈ Set.Ioo (0 : ℝ) 1, Relation.EqvGen (glue 1) (u, v) q ↔ q = (u, v)) := by\n  intro v hv q hq\n  obtain ⟨hv0, hv1⟩ := hv\n  have hmem : ∀ u : ℝ, 0 ≤ u → u ≤ 1 → (u, v) ∈ square 1 := fun u h1 h2 => ⟨⟨h1, h2⟩, ⟨hv0.le, hv1.le⟩⟩\n  have hb : ∀ b : ℝ, (v = b ∨ (v = 0 ∧ b = 1) ∨ (v = 1 ∧ b = 0)) ↔ b = v := by\n    intro b\n    constructor\n    · rintro (h | ⟨h, -⟩ | ⟨h, -⟩)\n      · exact h.symm\n      · linarith\n      · linarith\n    · intro h; left; exact h.symm\n  constructor\n  · rw [glue_eqvGen_iff 1 one_pos _ q (hmem 0 le_rfl zero_le_one) hq, κ_eq_iff 1 _ _ one_pos,\n      κ_eq_iff 1 _ _ one_pos]\n    obtain ⟨a, b⟩ := q\n    simp only [Prod.mk.injEq]\n    rw [hb b]\n    constructor\n    · rintro ⟨h | ⟨-, h⟩ | ⟨h, -⟩, hbv⟩\n      · left; exact ⟨h.symm, hbv⟩\n      · right; exact ⟨h, hbv⟩\n      · norm_num at h\n    · rintro (⟨rfl, rfl⟩ | ⟨rfl, rfl⟩) <;> simp\n  · intro u hu\n    obtain ⟨hu0, hu1⟩ := hu\n    rw [glue_eqvGen_iff 1 one_pos _ q (hmem u hu0.le hu1.le) hq, κ_eq_iff 1 _ _ one_pos,\n      κ_eq_iff 1 _ _ one_pos]\n    obtain ⟨a, b⟩ := q\n    simp only [Prod.mk.injEq]\n    rw [hb b]\n    constructor\n    · rintro ⟨h | ⟨h, -⟩ | ⟨h, -⟩, hbv⟩\n      · exact ⟨h.symm, hbv⟩\n      · linarith\n      · linarith\n    · rintro ⟨rfl, rfl⟩\n      exact ⟨Or.inl rfl, by simp⟩\nexact @key (1/2) ((by norm_num)) ((0, 1/2)) ((by simp [KaluzaKlein.Sets.Quotients.square]; norm_num))'),
    (['1/3', '(by norm_num)', '(1/2, 1/3)', '(by simp [KaluzaKlein.Sets.Quotients.square]; norm_num)'], False, 'set_option maxHeartbeats 2000000 in\nhave key : ∀ (v : ℝ) (hv : v ∈ Set.Ioo (0 : ℝ) 1) (q : ℝ × ℝ) (hq : q ∈ square 1), (Relation.EqvGen (glue 1) (0, v) q ↔ q = (0, v) ∨ q = (1, v)) ∧ (∀ u ∈ Set.Ioo (0 : ℝ) 1, Relation.EqvGen (glue 1) (u, v) q ↔ q = (u, v)) := by\n  intro v hv q hq\n  obtain ⟨hv0, hv1⟩ := hv\n  have hmem : ∀ u : ℝ, 0 ≤ u → u ≤ 1 → (u, v) ∈ square 1 := fun u h1 h2 => ⟨⟨h1, h2⟩, ⟨hv0.le, hv1.le⟩⟩\n  have hb : ∀ b : ℝ, (v = b ∨ (v = 0 ∧ b = 1) ∨ (v = 1 ∧ b = 0)) ↔ b = v := by\n    intro b\n    constructor\n    · rintro (h | ⟨h, -⟩ | ⟨h, -⟩)\n      · exact h.symm\n      · linarith\n      · linarith\n    · intro h; left; exact h.symm\n  constructor\n  · rw [glue_eqvGen_iff 1 one_pos _ q (hmem 0 le_rfl zero_le_one) hq, κ_eq_iff 1 _ _ one_pos,\n      κ_eq_iff 1 _ _ one_pos]\n    obtain ⟨a, b⟩ := q\n    simp only [Prod.mk.injEq]\n    rw [hb b]\n    constructor\n    · rintro ⟨h | ⟨-, h⟩ | ⟨h, -⟩, hbv⟩\n      · left; exact ⟨h.symm, hbv⟩\n      · right; exact ⟨h, hbv⟩\n      · norm_num at h\n    · rintro (⟨rfl, rfl⟩ | ⟨rfl, rfl⟩) <;> simp\n  · intro u hu\n    obtain ⟨hu0, hu1⟩ := hu\n    rw [glue_eqvGen_iff 1 one_pos _ q (hmem u hu0.le hu1.le) hq, κ_eq_iff 1 _ _ one_pos,\n      κ_eq_iff 1 _ _ one_pos]\n    obtain ⟨a, b⟩ := q\n    simp only [Prod.mk.injEq]\n    rw [hb b]\n    constructor\n    · rintro ⟨h | ⟨h, -⟩ | ⟨h, -⟩, hbv⟩\n      · exact ⟨h.symm, hbv⟩\n      · linarith\n      · linarith\n    · rintro ⟨rfl, rfl⟩\n      exact ⟨Or.inl rfl, by simp⟩\nexact @key (1/3) ((by norm_num)) ((1/2, 1/3)) ((by simp [KaluzaKlein.Sets.Quotients.square]; norm_num))'),
]
instances = [kernel_instance(*values, proof=proof, edge=edge) for values, edge, proof in CASES]
