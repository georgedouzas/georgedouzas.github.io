import KaluzaKlein.Conventions

/-!
# Lie groups: `su(2)` on Pauli matrices, the Killing form of `so(3)`, and the rotation subgroup

* `pauli a` are the Pauli matrices and `T a = −(i/2) σ_a` the anti-Hermitian generators, with `⁅T_a, T_b⁆ = ε_abc T_c`
  and `tr (T_a T_b) = −½ δ_ab`.
* The Killing form of `so(3)` in the basis `L_a` is `tr (L_a L_b) = −2 δ_ab`.
* `rotation t` is the rotation by `t` about the third axis; it is the one-parameter subgroup generated by `L₂`:
  `rotation 0 = 1`, `rotation s * rotation t = rotation (s + t)` and `d/dt rotation t = L₂ * rotation t` (entrywise).
  Veriphy's `matrix_exponential` recipe does not cover generators with eigenvalues `±i`, so the identification with
  `NormedSpace.exp (t • L₂)` is not formalised; the three properties above are what the text uses.
-/

namespace KaluzaKlein

open Matrix

/-- The Pauli matrices `σ₁, σ₂, σ₃`. -/
noncomputable def pauli : Fin 3 → Matrix (Fin 2) (Fin 2) ℂ :=
  ![!![0, 1; 1, 0], !![0, -Complex.I; Complex.I, 0], !![1, 0; 0, -1]]

/-- The anti-Hermitian generators `T_a = −(i/2) σ_a` of `su(2)`. -/
noncomputable def T (a : Fin 3) : Matrix (Fin 2) (Fin 2) ℂ := (-(Complex.I / 2)) • pauli a

/-- `⁅T₀, T₁⁆ = T₂`, `⁅T₁, T₂⁆ = T₀`, `⁅T₂, T₀⁆ = T₁`: the same structure constants as `so(3)`. -/
theorem su2_brackets : ⁅T 0, T 1⁆ = T 2 ∧ ⁅T 1, T 2⁆ = T 0 ∧ ⁅T 2, T 0⁆ = T 1 := by
  refine ⟨?_, ?_, ?_⟩ <;> (rw [Ring.lie_def]; ext i j; fin_cases i <;> fin_cases j <;>
    simp [T, pauli, Matrix.mul_apply, Fin.sum_univ_succ, Complex.ext_iff] <;> ring_nf <;> simp [Complex.I_sq] <;> ring)

/-- `tr (T_a T_b) = −½ δ_ab`. -/
theorem trace_T_mul (a b : Fin 3) : (T a * T b).trace = if a = b then -(1 / 2 : ℂ) else 0 := by
  fin_cases a <;> fin_cases b <;>
    simp [T, pauli, Matrix.trace, Matrix.mul_apply, Fin.sum_univ_succ, Complex.ext_iff] <;> ring_nf <;>
    simp [Complex.I_sq] <;> ring

/-- The Killing form of `so(3)` in the basis `L_a`: `tr (L_a L_b) = −2 δ_ab`. -/
theorem so3_killing_form (a b : Fin 3) : (L a * L b).trace = if a = b then -2 else 0 := by
  fin_cases a <;> fin_cases b <;> simp [L, L0, L1, L2, Matrix.trace, Matrix.mul_apply, Fin.sum_univ_succ] <;> norm_num

/-- `L₂` over `ℝ`, the generator of rotations about the third axis. -/
def L2R : Matrix (Fin 3) (Fin 3) ℝ := !![0, -1, 0; 1, 0, 0; 0, 0, 0]

/-- `L₂² = diag(−1, −1, 0)` and `L₂³ = −L₂`: the powers cycle like those of `i`. -/
theorem L2R_sq : L2R * L2R = !![-1, 0, 0; 0, -1, 0; 0, 0, 0] := by
  ext i j; fin_cases i <;> fin_cases j <;> simp [L2R, Matrix.mul_apply, Fin.sum_univ_succ]

theorem L2R_cube : L2R * L2R * L2R = -L2R := by
  ext i j; fin_cases i <;> fin_cases j <;> simp [L2R, Matrix.mul_apply, Fin.sum_univ_succ]

/-- The rotation by `t` about the third axis. -/
noncomputable def rotation (t : ℝ) : Matrix (Fin 3) (Fin 3) ℝ :=
  !![Real.cos t, -Real.sin t, 0; Real.sin t, Real.cos t, 0; 0, 0, 1]

theorem rotation_zero : rotation 0 = 1 := by
  ext i j; fin_cases i <;> fin_cases j <;> simp [rotation]

/-- Rotations compose by adding angles: `R(s) R(t) = R(s + t)`. -/
theorem rotation_mul (s t : ℝ) : rotation s * rotation t = rotation (s + t) := by
  ext i j; fin_cases i <;> fin_cases j <;>
    simp [rotation, Matrix.mul_apply, Fin.sum_univ_succ, Real.cos_add, Real.sin_add] <;> ring

/-- `R(t)` is orthogonal: `R(t) R(t)ᵀ = 1`. -/
theorem rotation_orthogonal (t : ℝ) : rotation t * (rotation t).transpose = 1 := by
  ext i j; fin_cases i <;> fin_cases j <;>
    simp [rotation, Matrix.mul_apply, Fin.sum_univ_succ, Matrix.transpose_apply] <;>
    nlinarith [Real.sin_sq_add_cos_sq t]

/-- `R(t)` solves the one-parameter subgroup equation `dR/dt = L₂ R` entrywise, so it is `exp (t L₂)`. -/
theorem rotation_deriv (t : ℝ) (i j : Fin 3) :
    deriv (fun s => rotation s i j) t = (L2R * rotation t) i j := by
  fin_cases i <;> fin_cases j <;> simp [rotation, L2R, Matrix.mul_apply, Fin.sum_univ_succ]

end KaluzaKlein
