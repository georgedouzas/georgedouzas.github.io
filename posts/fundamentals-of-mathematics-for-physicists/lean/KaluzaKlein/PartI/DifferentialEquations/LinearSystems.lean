-- test: de-saddle-axis-test.sage

/-- Every other solution has an `eᵗ` component and escapes: `|c eᵗ| → ∞` for `c ≠ 0`. -/
theorem saddle_escape (c : ℝ) (hc : c ≠ 0) : Tendsto (fun t => |c * Real.exp t|) atTop atTop := by
  have : (fun t => |c * Real.exp t|) = fun t => Real.exp t * |c| := by
    funext t; rw [abs_mul, abs_of_pos (Real.exp_pos t), mul_comm]
  rw [this]
  exact Real.tendsto_exp_atTop.atTop_mul_const (abs_pos.mpr hc)
