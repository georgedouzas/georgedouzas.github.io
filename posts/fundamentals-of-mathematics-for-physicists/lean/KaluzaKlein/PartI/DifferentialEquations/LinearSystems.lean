theorem cube_charpoly (l : ℝ) : Matrix.det !![l - 0, -1, 0; 0, l - 0, -1; 0, 1, l - 0] = l ^ 3 + l := by
  veriphy_certified (norm_num [Matrix.det_fin_three] <;> ring1)
