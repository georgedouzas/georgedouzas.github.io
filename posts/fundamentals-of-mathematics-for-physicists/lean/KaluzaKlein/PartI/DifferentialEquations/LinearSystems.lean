/-! ## exm-res-at-natural -/

/-- At `ω = ω₀`: `Δ = 4γ²ω₀²`, so `A = F/(2γω₀)`. -/
theorem natural_delta (γ ω₀ : ℝ) : (ω₀ ^ 2 - ω₀ ^ 2) ^ 2 + 4 * γ ^ 2 * ω₀ ^ 2 = (2 * γ * ω₀) ^ 2 := by
  veriphy_certified (ring1)
  -- certificate: de-poly.sage

/-- … and the response `(F/(2γω₀)) sin ω₀t = A cos(ω₀t - π/2)`: the phase lag is `π/2`. -/
theorem natural_lag (A ω₀ t : ℝ) : A * Real.sin (ω₀ * t) = A * Real.cos (ω₀ * t - Real.pi / 2) := by
  veriphy_certified (rw [Real.cos_sub_pi_div_two])
  -- certificate: de-rewrite.sage

/-- The velocity `A ω₀ cos ω₀t` is in phase with the force. -/
theorem natural_velocity (A ω₀ t : ℝ) : deriv (fun s => A * Real.sin (ω₀ * s)) t = A * ω₀ * Real.cos (ω₀ * t) := by
  veriphy_certified
    ( have hd : HasDerivAt (fun s => A * sin (ω₀ * s)) ((A * ω₀ * (Real.cos (ω₀ * t)) : ℝ)) (t) :=
        by
        convert ((((hasDerivAt_id' (t : ℝ)).const_mul (ω₀ : ℝ)).sin).const_mul (A : ℝ)) using 1
        all_goals (ring1)
      exact hd.deriv.trans (by rfl))
  -- certificate: de-derivative.sage

/-! ## exm-res-secular -/

/-- `q = (F/(2ω₀)) t sin ω₀t` solves `q̈ + ω₀²q = F cos ω₀t`. -/
theorem secular_solves (F ω₀ : ℝ) (hω : ω₀ ≠ 0) (q : ℝ → ℝ) (hq : q = fun s => F / (2 * ω₀) * s * Real.sin (ω₀ * s))
    (t : ℝ) : deriv (deriv q) t + ω₀ ^ 2 * q t = F * Real.cos (ω₀ * t) := by
  veriphy_certified
    ( subst hq
      have d1 :
        deriv (fun s => F / (2 * ω₀) * s * sin (ω₀ * s)) = fun s =>
          s * F * (Real.cos (s * ω₀)) / 2 + (F * (Real.sin (s * ω₀)) / (2 * ω₀)) :=
        by
        funext s
        have hd :
          HasDerivAt (fun s => F / (2 * ω₀) * s * sin (ω₀ * s))
            ((s * F * (Real.cos (s * ω₀)) / 2 + (F * (Real.sin (s * ω₀)) / (2 * ω₀)) : ℝ)) (s) :=
          by
          convert
            (((hasDerivAt_id' (s : ℝ)).mul (((hasDerivAt_id' (s : ℝ)).const_mul (ω₀ : ℝ)).sin)).const_mul
              (F / (2 * ω₀) : ℝ)) using
            1
          all_goals
            first
            | rfl
            | (funext y; simp only [Pi.mul_apply]; ring_nf; done)
            | ((field_simp; ring1))
        exact hd.deriv
      have d2 :
        deriv (fun s => s * F * (Real.cos (s * ω₀)) / 2 + (F * (Real.sin (s * ω₀)) / (2 * ω₀))) = fun s =>
          -s * ω₀ * F * (Real.sin (s * ω₀)) / 2 + (F * (Real.cos (s * ω₀))) :=
        by
        funext s
        have hd :
          HasDerivAt (fun s => s * F * (Real.cos (s * ω₀)) / 2 + (F * (Real.sin (s * ω₀)) / (2 * ω₀)))
            ((-s * ω₀ * F * (Real.sin (s * ω₀)) / 2 + (F * (Real.cos (s * ω₀))) : ℝ)) (s) :=
          by
          convert
            ((((hasDerivAt_id' (s : ℝ)).mul (((hasDerivAt_id' (s : ℝ)).const_mul (ω₀ : ℝ)).cos)).const_mul
                  (F / 2 : ℝ)).add
              ((((hasDerivAt_id' (s : ℝ)).const_mul (ω₀ : ℝ)).sin).const_mul (F / (2 * ω₀) : ℝ))) using
            1
          all_goals
            first
            | rfl
            | (funext y; simp only [Pi.add_apply, Pi.mul_apply]; ring_nf; done)
            | ((field_simp; ring1))
        exact hd.deriv
      simp only [d1, d2]
      (field_simp; ring1))
  -- certificate: de-ode.sage

/-- … and it is unbounded (`F ≠ 0`): it grows linearly in `t`. -/
theorem secular_unbounded (F ω₀ : ℝ) (hF : F ≠ 0) (hω : 0 < ω₀) (M : ℝ) :
    ∃ t, M < |F / (2 * ω₀) * t * Real.sin (ω₀ * t)| := by
  obtain ⟨k, hk⟩ := exists_nat_gt (M * (2 * ω₀) / |F| * ω₀ / Real.pi)
  refine ⟨(2 * k * Real.pi + Real.pi / 2) / ω₀, ?_⟩
  have hs : Real.sin (ω₀ * ((2 * k * Real.pi + Real.pi / 2) / ω₀)) = 1 := by
    rw [mul_div_cancel₀ _ hω.ne', show 2 * (k : ℝ) * Real.pi + Real.pi / 2 = Real.pi / 2 + (k : ℕ) * (2 * Real.pi) by
      ring, Real.sin_add_nat_mul_two_pi, Real.sin_pi_div_two]
  rw [hs, mul_one, abs_mul, abs_div, abs_of_pos (by positivity : (0 : ℝ) < 2 * ω₀),
    abs_of_pos (by positivity : (0 : ℝ) < (2 * k * Real.pi + Real.pi / 2) / ω₀)]
  have hFp : 0 < |F| := abs_pos.mpr hF
  have hpi := Real.pi_pos
  rw [div_lt_iff₀ hpi] at hk
  rw [div_mul_div_comm, lt_div_iff₀ (by positivity)]
  have : M * (2 * ω₀) / |F| * ω₀ < 2 * k * Real.pi + Real.pi / 2 := by nlinarith
  rw [div_mul_eq_mul_div, div_lt_iff₀ hFp] at this
  nlinarith
