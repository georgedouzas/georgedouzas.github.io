/-! ## exm-eigen-spiral -/

/-- `det(λ - A) = λ² + 2λ + 2` for `A = (0, 1; -2, -2)`. -/
theorem spiral_charpoly (l : ℝ) : Matrix.det !![l - 0, -1; 2, l + 2] = l ^ 2 + 2 * l + 2 := by
  veriphy_certified (norm_num [Matrix.det_fin_two_of] <;> ring1)
  -- certificate: la-matrix.sage

/-- Its roots are `-1 ± i`: `(-1 + i)² + 2(-1 + i) + 2 = 0` … -/
theorem spiral_eigen_plus (i : ℂ) (hi : i ^ 2 = -1) : (-1 + i) ^ 2 + 2 * (-1 + i) + 2 = 0 := by
  veriphy_certified (linear_combination hi)
  -- certificate: de-poly.sage

/-- … and `(-1 - i)² + 2(-1 - i) + 2 = 0`. -/
theorem spiral_eigen_minus (i : ℂ) (hi : i ^ 2 = -1) : (-1 - i) ^ 2 + 2 * (-1 - i) + 2 = 0 := by
  veriphy_certified (linear_combination hi)
  -- certificate: de-poly.sage

/-- … and no real eigenvalue: `λ² + 2λ + 2 = (λ + 1)² + 1 > 0`. -/
theorem spiral_no_real (l : ℝ) : 0 < l ^ 2 + 2 * l + 2 := by
  veriphy_certified (linear_combination sq_nonneg (l + 1))
  -- certificate: sos.sage

/-! ## exr-eigen-compute -/

/-- `(1, 1)` is an eigenvector of `(-1, 1; 1, -1)` with eigenvalue `0`. -/
theorem tanks_eigen_zero : !![(-1 : ℝ), 1; 1, -1] * !![(1 : ℝ); 1] = !![0; 0] := by
  veriphy_certified
    ( ext i j
      fin_cases i <;> fin_cases j <;> norm_num [Matrix.mul_apply, Fin.sum_univ_succ, Matrix.transpose_apply])
  -- certificate: la-matrix.sage

/-- `(1, -1)` with eigenvalue `-2`. -/
theorem tanks_eigen_two : !![(-1 : ℝ), 1; 1, -1] * !![(1 : ℝ); -1] = !![-2; 2] := by
  veriphy_certified
    ( ext i j
      fin_cases i <;> fin_cases j <;> norm_num [Matrix.mul_apply, Fin.sum_univ_succ, Matrix.transpose_apply])
  -- certificate: la-matrix.sage

/-- `x(0) = (3, 1) = 2(1, 1) + 1(1, -1)`. -/
theorem tanks_decomposition : (2 : ℝ) • !![(1 : ℝ); 1] + (1 : ℝ) • !![1; -1] = !![3; 1] := by
  veriphy_certified
    ( ext i j
      fin_cases i <;> fin_cases j <;> norm_num [Matrix.mul_apply, Fin.sum_univ_succ, Matrix.transpose_apply])
  -- certificate: la-matrix.sage

/-- `x(t) = 2(1, 1) + e^{-2t}(1, -1) = (2 + e^{-2t}, 2 - e^{-2t})`. -/
theorem tanks_eigen_solution (E : ℝ) : (2 : ℝ) • !![(1 : ℝ); 1] + E • !![1; -1] = !![2 + E; 2 - E] := by
  veriphy_certified
    ( ext i j
      fin_cases i <;> fin_cases j <;> norm_num [Matrix.mul_apply, Fin.sum_univ_succ, Matrix.transpose_apply] <;> ring1)
  -- certificate: la-matrix.sage

/-! ## exr-eigen-trace-det -/

/-- `det(λ - A) = λ² - (tr A)λ + det A` for `A = (a, b; c, d)`. -/
theorem charpoly_two (a b c d l : ℝ) :
    Matrix.det !![l - a, -b; -c, l - d] = l ^ 2 - (a + d) * l + (a * d - b * c) := by
  veriphy_certified (norm_num [Matrix.det_fin_two_of] <;> ring1)
  -- certificate: la-matrix.sage

/-- The roots `½(T ± s)`, `s² = T² - 4D`, have sum `T` (the trace) … -/
theorem vieta_sum (T s : ℝ) : (T + s) / 2 + (T - s) / 2 = T := by
  veriphy_certified (ring1)
  -- certificate: de-poly.sage

/-- The product of the roots is the determinant: `((T + s)/2)((T - s)/2) = D` when `s² = T² - 4D`. -/
theorem vieta_product (T D s : ℝ) (hs : s ^ 2 = T ^ 2 - 4 * D) : (T + s) / 2 * ((T - s) / 2) = D := by
  veriphy_certified (linear_combination (-1 / 4) * hs)
  -- certificate: de-poly.sage

/-- The eigenvalues are real exactly when `(tr A)² ≥ 4 det A`. -/
theorem real_roots_iff (T D : ℝ) : (∃ l : ℝ, l ^ 2 - T * l + D = 0) ↔ 4 * D ≤ T ^ 2 := by
  constructor
  · rintro ⟨l, hl⟩
    nlinarith [sq_nonneg (2 * l - T)]
  · intro h
    refine ⟨(T + Real.sqrt (T ^ 2 - 4 * D)) / 2, ?_⟩
    have := Real.sq_sqrt (show 0 ≤ T ^ 2 - 4 * D by linarith)
    nlinarith [this]
