/-! ## exr-ho-energy-quality -/

/-- `Ė = q̇q̈ + ω₀²qq̇ = -2γq̇²` for the free oscillator. -/
theorem energy_rate (γ ω₀ q q' q'' : ℝ) (h : q'' + 2 * γ * q' + ω₀ ^ 2 * q = 0) :
    q' * q'' + ω₀ ^ 2 * q * q' = -2 * γ * q' ^ 2 := by
  veriphy_certified (linear_combination (q') * h)
  -- certificate: de-poly.sage

/-- After one period `T = 2π/ω_d` the underdamped solution is multiplied by `e^{-γT}`: `q(t + T) = e^{-γT} q(t)`,
so `q²` and `q̇²`, hence the period average of `E`, decay as `e^{-2γt}`. -/
theorem underdamped_period_decay (R γ ωd φ t : ℝ) (hω : ωd ≠ 0) :
    R * Real.exp (-γ * (t + 2 * Real.pi / ωd)) * Real.cos (ωd * (t + 2 * Real.pi / ωd) - φ) =
      Real.exp (-γ * (2 * Real.pi / ωd)) * (R * Real.exp (-γ * t) * Real.cos (ωd * t - φ)) := by
  veriphy_certified
    ( rw [show ωd * (t + 2 * Real.pi / ωd) - φ = ωd * t - φ + 2 * Real.pi by field_simp; ring, Real.cos_add_two_pi,
        show -γ * (t + 2 * Real.pi / ωd) = -γ * (2 * Real.pi / ωd) + -γ * t by ring, Real.exp_add]
      ring)
  -- certificate: de-rewrite.sage

/-- The energy falls by `e^{-2π}` at `t = π/γ`, which contains `(π/γ)/(2π/ω_d) = ω_d/(2γ)` periods. -/
theorem quality_periods (γ ωd : ℝ) (hγ : γ ≠ 0) (hω : ωd ≠ 0) :
    (Real.pi / γ) / (2 * Real.pi / ωd) = ωd / (2 * γ) := by
  veriphy_certified
    ( have hπ := Real.pi_pos.ne'
      (field_simp; done))
  -- certificate: de-rewrite.sage

end KaluzaKlein.DifferentialEquations.HarmonicOscillator

namespace KaluzaKlein.DifferentialEquations.Resonance

/-! ## def-resonance -/

/-- The steady-state response `a cos ωt + b sin ωt` with `a = F(ω₀² - ω²)/Δ`, `b = 2γωF/Δ`,
`Δ = (ω₀² - ω²)² + 4γ²ω²` solves the driven oscillator. -/
theorem steady_state_solves (γ ω₀ ω F t : ℝ) (hΔ : (ω₀ ^ 2 - ω ^ 2) ^ 2 + 4 * γ ^ 2 * ω ^ 2 ≠ 0) :
    deriv (fun s => deriv (fun r => F * (ω₀ ^ 2 - ω ^ 2) / ((ω₀ ^ 2 - ω ^ 2) ^ 2 + 4 * γ ^ 2 * ω ^ 2) *
        Real.cos (ω * r) + 2 * γ * ω * F / ((ω₀ ^ 2 - ω ^ 2) ^ 2 + 4 * γ ^ 2 * ω ^ 2) * Real.sin (ω * r)) s) t +
      2 * γ * deriv (fun s => F * (ω₀ ^ 2 - ω ^ 2) / ((ω₀ ^ 2 - ω ^ 2) ^ 2 + 4 * γ ^ 2 * ω ^ 2) *
        Real.cos (ω * s) + 2 * γ * ω * F / ((ω₀ ^ 2 - ω ^ 2) ^ 2 + 4 * γ ^ 2 * ω ^ 2) * Real.sin (ω * s)) t +
      ω₀ ^ 2 * (F * (ω₀ ^ 2 - ω ^ 2) / ((ω₀ ^ 2 - ω ^ 2) ^ 2 + 4 * γ ^ 2 * ω ^ 2) * Real.cos (ω * t) +
        2 * γ * ω * F / ((ω₀ ^ 2 - ω ^ 2) ^ 2 + 4 * γ ^ 2 * ω ^ 2) * Real.sin (ω * t)) =
      F * Real.cos (ω * t) := by
  set A := F * (ω₀ ^ 2 - ω ^ 2) / ((ω₀ ^ 2 - ω ^ 2) ^ 2 + 4 * γ ^ 2 * ω ^ 2) with hA
  set B := 2 * γ * ω * F / ((ω₀ ^ 2 - ω ^ 2) ^ 2 + 4 * γ ^ 2 * ω ^ 2) with hB
  have h1 : ∀ s, HasDerivAt (fun r => A * Real.cos (ω * r) + B * Real.sin (ω * r))
      (A * (-Real.sin (ω * s) * ω) + B * (Real.cos (ω * s) * ω)) s := by
    intro s
    have := (((hasDerivAt_id' s).const_mul ω).cos.const_mul A).add (((hasDerivAt_id' s).const_mul ω).sin.const_mul B)
    convert this using 1 <;> ring
  rw [show (fun s => deriv (fun r => A * Real.cos (ω * r) + B * Real.sin (ω * r)) s) =
    fun s => A * (-Real.sin (ω * s) * ω) + B * (Real.cos (ω * s) * ω) from funext fun s => (h1 s).deriv, (h1 t).deriv]
  have h2 : HasDerivAt (fun s => A * (-Real.sin (ω * s) * ω) + B * (Real.cos (ω * s) * ω)) _ t :=
    ((((hasDerivAt_id' t).const_mul ω).sin.neg.mul_const ω).const_mul A).add
      ((((hasDerivAt_id' t).const_mul ω).cos.mul_const ω).const_mul B)
  rw [h2.deriv]
  have eA : A * ((ω₀ ^ 2 - ω ^ 2) ^ 2 + 4 * γ ^ 2 * ω ^ 2) = F * (ω₀ ^ 2 - ω ^ 2) := by rw [hA, div_mul_cancel₀ _ hΔ]
  have eB : B * ((ω₀ ^ 2 - ω ^ 2) ^ 2 + 4 * γ ^ 2 * ω ^ 2) = 2 * γ * ω * F := by rw [hB, div_mul_cancel₀ _ hΔ]
  apply mul_left_cancel₀ hΔ
  linear_combination (Real.cos (ω * t) * (ω₀ ^ 2 - ω ^ 2) - 2 * γ * ω * Real.sin (ω * t)) * eA +
    (Real.sin (ω * t) * (ω₀ ^ 2 - ω ^ 2) + 2 * γ * ω * Real.cos (ω * t)) * eB
attribute [veriphy_tested oracle_test 0 3] KaluzaKlein.DifferentialEquations.Resonance.steady_state_solves
-- test: de-steady-state-solves-test.sage

/-- Its amplitude: `a² + b² = F²/Δ`, so `A(ω) = F/√Δ`. -/
theorem steady_state_amplitude (γ ω₀ ω F : ℝ) (hΔ : (ω₀ ^ 2 - ω ^ 2) ^ 2 + 4 * γ ^ 2 * ω ^ 2 ≠ 0) :
    (F * (ω₀ ^ 2 - ω ^ 2) / ((ω₀ ^ 2 - ω ^ 2) ^ 2 + 4 * γ ^ 2 * ω ^ 2)) ^ 2 +
      (2 * γ * ω * F / ((ω₀ ^ 2 - ω ^ 2) ^ 2 + 4 * γ ^ 2 * ω ^ 2)) ^ 2 =
      F ^ 2 / ((ω₀ ^ 2 - ω ^ 2) ^ 2 + 4 * γ ^ 2 * ω ^ 2) := by
  veriphy_certified
    ( rw [div_pow, div_pow, ← add_div, div_eq_div_iff (pow_ne_zero 2 hΔ) hΔ]
      ring)
  -- certificate: de-rewrite.sage

/-- Its phase lag: `b/a = 2γω/(ω₀² - ω²) = tan δ`. -/
theorem steady_state_phase (γ ω₀ ω F : ℝ) (hF : F ≠ 0) (hd : ω₀ ^ 2 - ω ^ 2 ≠ 0)
    (hΔ : (ω₀ ^ 2 - ω ^ 2) ^ 2 + 4 * γ ^ 2 * ω ^ 2 ≠ 0) :
    (2 * γ * ω * F / ((ω₀ ^ 2 - ω ^ 2) ^ 2 + 4 * γ ^ 2 * ω ^ 2)) /
      (F * (ω₀ ^ 2 - ω ^ 2) / ((ω₀ ^ 2 - ω ^ 2) ^ 2 + 4 * γ ^ 2 * ω ^ 2)) = 2 * γ * ω / (ω₀ ^ 2 - ω ^ 2) := by
  veriphy_certified (field_simp)
  -- certificate: de-rewrite.sage

/-- The resonance frequency: in `w = ω²`, `Δ(w) - Δ(ω₀² - 2γ²) = (w - (ω₀² - 2γ²))²`, so `Δ` is least and the
amplitude largest at `ω_r² = ω₀² - 2γ²`. -/
theorem resonance_minimum (γ ω₀ w : ℝ) :
    (ω₀ ^ 2 - w) ^ 2 + 4 * γ ^ 2 * w - ((ω₀ ^ 2 - (ω₀ ^ 2 - 2 * γ ^ 2)) ^ 2 + 4 * γ ^ 2 * (ω₀ ^ 2 - 2 * γ ^ 2)) =
      (w - (ω₀ ^ 2 - 2 * γ ^ 2)) ^ 2 := by
  veriphy_certified (ring1)
  -- certificate: de-poly.sage

/-- The peak: `Δ(ω_r) = 4γ²(ω₀² - γ²)`, so `A(ω_r) = F/(2γ√(ω₀² - γ²))`, unbounded as `γ → 0`. -/
theorem resonance_peak (γ ω₀ : ℝ) :
    (ω₀ ^ 2 - (ω₀ ^ 2 - 2 * γ ^ 2)) ^ 2 + 4 * γ ^ 2 * (ω₀ ^ 2 - 2 * γ ^ 2) = 4 * γ ^ 2 * (ω₀ ^ 2 - γ ^ 2) := by
  veriphy_certified (ring1)
  -- certificate: de-poly.sage

/-- Every solution approaches the steady state: the free part `e^{-γt}·(bounded)` tends to `0` for `γ > 0`. -/
theorem transient_decays (γ C : ℝ) (hγ : 0 < γ) (f : ℝ → ℝ) (hf : ∀ t, |f t| ≤ C) :
    Tendsto (fun t => Real.exp (-γ * t) * f t) atTop (𝓝 0) := by
  have h : Tendsto (fun t => Real.exp (-γ * t)) atTop (𝓝 0) :=
    Real.tendsto_exp_atBot.comp (tendsto_id.const_mul_atTop_of_neg (by linarith))
  refine squeeze_zero_norm (a := fun t => Real.exp (-γ * t) * C) (fun t => ?_) (by simpa using h.mul_const C)
  rw [Real.norm_eq_abs, abs_mul, abs_of_pos (Real.exp_pos _)]
  exact mul_le_mul_of_nonneg_left (hf t) (Real.exp_pos _).le
attribute [veriphy_tested oracle_test 0 3] KaluzaKlein.DifferentialEquations.Resonance.transient_decays
