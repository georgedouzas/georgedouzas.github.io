/-- … characteristic polynomial `λ² + λ + 4` with discriminant `1 - 16 < 0` … -/
theorem A3_charpoly (l : ℝ) : Matrix.det !![l - 0, -2; 2, l + 1] = l ^ 2 + l + 4 := by
