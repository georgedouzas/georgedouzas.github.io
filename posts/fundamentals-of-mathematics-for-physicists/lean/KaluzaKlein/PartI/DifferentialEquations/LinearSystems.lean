import Mathlib
import Veriphy.Kit.Levels

/-!
# Differential equations, part "Linear systems and the matrix exponential"

The claims of the part "Linear systems and the matrix exponential" of
`tutorial/part-i-05-differential-equations.qmd`, one namespace per section: linear systems `ẋ = Ax` (superposition,
the solution space and its dimension), eigenvalues and characteristic polynomials, the matrix exponential (mathlib's
`NormedSpace.exp`) and its closed forms, stability, the damped harmonic oscillator and resonance.

Vectors of `ℝⁿ` are `Fin n → ℝ` with `A *ᵥ x`; explicit vectors and matrices are `!![…]` literals (column matrices
for vectors), so that the identities are matrix identities. Matrix-valued derivatives use the operator norm of
`Norms.Operator` (`linftyOp`), which has the same topology as the product one. A complex eigenvalue `a + bi` is
checked with a generic `i` satisfying `i² = -1` (an identity in the ideal generated by `i² + 1`).
-/

open Real Filter Topology Matrix

namespace KaluzaKlein.DifferentialEquations.LinearSystems

/-! ## def-linear-system -/

/-- Superposition: combinations `αx + βy` of solutions of `ẋ = Ax` are solutions. -/
theorem superposition {n : ℕ} (A : Matrix (Fin n) (Fin n) ℝ) (x y : ℝ → Fin n → ℝ) (α β t : ℝ)
    (hx : HasDerivAt x (A *ᵥ x t) t) (hy : HasDerivAt y (A *ᵥ y t) t) :
    HasDerivAt (fun s => α • x s + β • y s) (A *ᵥ (α • x t + β • y t)) t := by
  convert (hx.const_smul α).add (hy.const_smul β) using 1
  rw [Matrix.mulVec_add, Matrix.mulVec_smul, Matrix.mulVec_smul]
attribute [veriphy_tested oracle_test 0 3] KaluzaKlein.DifferentialEquations.LinearSystems.superposition
-- test: de-superposition-test.sage

/-- The difference of two solutions of `ẋ = Ax + b(t)` solves the homogeneous system. -/
theorem inhomogeneous_difference {n : ℕ} (A : Matrix (Fin n) (Fin n) ℝ) (b : ℝ → Fin n → ℝ)
    (x y : ℝ → Fin n → ℝ) (t : ℝ) (hx : HasDerivAt x (A *ᵥ x t + b t) t) (hy : HasDerivAt y (A *ᵥ y t + b t) t) :
    HasDerivAt (fun s => x s - y s) (A *ᵥ (x t - y t)) t := by
  convert hx.sub hy using 1
  rw [Matrix.mulVec_sub]
  abel
attribute [veriphy_tested oracle_test 0 3] KaluzaKlein.DifferentialEquations.LinearSystems.inhomogeneous_difference
-- test: de-inhomogeneous-test.sage

/-! ## exm-ls-oscillator -/

/-- `(cos ω₀t, -ω₀ sin ω₀t)` solves `ẋ = Ax`, `A = (0, 1; -ω₀², 0)`. -/
theorem oscillator_solution_one (ω₀ t : ℝ) :
    !![(0 : ℝ), 1; -ω₀ ^ 2, 0] * !![Real.cos (ω₀ * t); -ω₀ * Real.sin (ω₀ * t)] =
      !![deriv (fun s => Real.cos (ω₀ * s)) t; deriv (fun s => -ω₀ * Real.sin (ω₀ * s)) t] := by
  veriphy_certified
    ( have h0 : HasDerivAt (fun s => cos (ω₀ * s)) ((-ω₀ * (Real.sin (ω₀ * t)) : ℝ)) (t) :=
        by
        convert (((hasDerivAt_id' (t : ℝ)).const_mul (ω₀ : ℝ)).cos) using 1
        all_goals (ring1)
      rw [h0.deriv]
      have h1 : HasDerivAt (fun s => -ω₀ * sin (ω₀ * s)) ((-(ω₀ ^ 2) * (Real.cos (ω₀ * t)) : ℝ)) (t) :=
        by
        convert ((((hasDerivAt_id' (t : ℝ)).const_mul (ω₀ : ℝ)).sin).const_mul (-ω₀ : ℝ)) using 1
        all_goals (ring1)
      rw [h1.deriv]
      (norm_num; done))
  -- certificate: de-partials.sage

/-- `(sin ω₀t, ω₀ cos ω₀t)` solves `ẋ = Ax`. -/
theorem oscillator_solution_two (ω₀ t : ℝ) :
    !![(0 : ℝ), 1; -ω₀ ^ 2, 0] * !![Real.sin (ω₀ * t); ω₀ * Real.cos (ω₀ * t)] =
      !![deriv (fun s => Real.sin (ω₀ * s)) t; deriv (fun s => ω₀ * Real.cos (ω₀ * s)) t] := by
  veriphy_certified
    ( have h0 : HasDerivAt (fun s => sin (ω₀ * s)) ((ω₀ * (Real.cos (ω₀ * t)) : ℝ)) (t) :=
        by
        convert (((hasDerivAt_id' (t : ℝ)).const_mul (ω₀ : ℝ)).sin) using 1
        all_goals (ring1)
      rw [h0.deriv]
      have h1 : HasDerivAt (fun s => ω₀ * cos (ω₀ * s)) ((-(ω₀ ^ 2) * (Real.sin (ω₀ * t)) : ℝ)) (t) :=
        by
        convert ((((hasDerivAt_id' (t : ℝ)).const_mul (ω₀ : ℝ)).cos).const_mul (ω₀ : ℝ)) using 1
        all_goals (ring1)
      rw [h1.deriv]
      (norm_num; done))
  -- certificate: de-partials.sage

/-- The two solutions span the solution space: their initial values `(1, 0)`, `(0, ω₀)` have determinant `ω₀ ≠ 0`. -/
theorem oscillator_wronskian (ω₀ : ℝ) : Matrix.det !![(1 : ℝ), 0; 0, ω₀] = ω₀ := by
  veriphy_certified (norm_num [Matrix.det_fin_two_of] <;> ring1)
  -- certificate: la-matrix.sage

/-! ## exm-ls-coupled -/

/-- The total `x₁ + x₂` is constant: `(1, 1) A = 0` for `A = (-1, 1; 1, -1)`. -/
theorem tanks_total : !![(1 : ℝ), 1] * !![(-1 : ℝ), 1; 1, -1] = !![0, 0] := by
  veriphy_certified
    ( ext i j
      fin_cases i <;> fin_cases j <;> norm_num [Matrix.mul_apply, Fin.sum_univ_succ, Matrix.transpose_apply])
  -- certificate: la-matrix.sage

/-- The difference decays like `e^{-2t}`: `(1, -1) A = -2 (1, -1)`. -/
theorem tanks_difference : !![(1 : ℝ), -1] * !![(-1 : ℝ), 1; 1, -1] = !![-2, 2] := by
  veriphy_certified
    ( ext i j
      fin_cases i <;> fin_cases j <;> norm_num [Matrix.mul_apply, Fin.sum_univ_succ, Matrix.transpose_apply])
  -- certificate: la-matrix.sage

/-! ## exm-ls-driven -/

/-- `q̈ + 2γq̇ + ω₀²q = F cos ωt` is `ẋ = Ax + b(t)` for `x = (q, v)`: `Ax + b = (v, -ω₀²q - 2γv + F cos ωt)`. -/
theorem driven_system (ω₀ γ F ω t q v : ℝ) :
    !![(0 : ℝ), 1; -ω₀ ^ 2, -2 * γ] * !![q; v] + !![0; F * Real.cos (ω * t)] =
      !![v; -ω₀ ^ 2 * q - 2 * γ * v + F * Real.cos (ω * t)] := by
  veriphy_certified
    ( ext i j
      fin_cases i <;> fin_cases j <;> norm_num [Matrix.mul_apply, Fin.sum_univ_succ, Matrix.transpose_apply] <;> ring1)
  -- certificate: la-matrix.sage

/-! ## exr-ls-desolve-system -/

/-- `x = (2 + e^{-2t}, 2 - e^{-2t})` solves `ẋ₁ = -x₁ + x₂`, `ẋ₂ = x₁ - x₂`. -/
theorem tanks_solution (t : ℝ) :
    !![(-1 : ℝ), 1; 1, -1] * !![2 + Real.exp (-2 * t); 2 - Real.exp (-2 * t)] =
      !![deriv (fun s => 2 + Real.exp (-2 * s)) t; deriv (fun s => 2 - Real.exp (-2 * s)) t] := by
  veriphy_certified
    ( have h0 : HasDerivAt (fun s => 2 + rexp (-2 * s)) ((-2 * (Real.exp (-2 * t)) : ℝ)) (t) :=
        by
        convert ((((hasDerivAt_id' (t : ℝ)).const_mul (-2 : ℝ)).exp).add (hasDerivAt_const (t : ℝ) (2 : ℝ))) using 1
        all_goals
          first
          | rfl
          | (funext y; simp only [Pi.add_apply]; ring_nf; done)
          | (ring1)
      rw [h0.deriv]
      have h1 : HasDerivAt (fun s => 2 - rexp (-2 * s)) ((2 * (Real.exp (-2 * t)) : ℝ)) (t) :=
        by
        convert
          (((((hasDerivAt_id' (t : ℝ)).const_mul (-2 : ℝ)).exp).const_mul (-1 : ℝ)).add
            (hasDerivAt_const (t : ℝ) (2 : ℝ))) using
          1
        all_goals
          first
          | rfl
          | (funext y; simp only [Pi.add_apply]; ring_nf; done)
          | (ring1)
      rw [h1.deriv]
      (ext i j;
        fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply, Fin.sum_univ_succ, Matrix.vecMul, dotProduct] <;>
          ring_nf))
  -- certificate: de-partials.sage

/-- … with `x(0) = (3, 1)`: `x₁(0) = 3` … -/
theorem tanks_initial_one : (2 : ℝ) + Real.exp (-2 * 0) = 3 := by
  veriphy_certified (norm_num)
  -- certificate: de-rewrite.sage

/-- … and `x₂(0) = 1`. -/
theorem tanks_initial_two : (2 : ℝ) - Real.exp (-2 * 0) = 1 := by
  veriphy_certified (norm_num)
  -- certificate: de-rewrite.sage

/-- The sum is `4` … -/
theorem tanks_sum (E : ℝ) : (2 + E) + (2 - E) = 4 := by
  veriphy_certified (ring1)
  -- certificate: de-poly.sage

/-- … and the difference `2e^{-2t}`. -/
theorem tanks_difference_value (E : ℝ) : (2 + E) - (2 - E) = 2 * E := by
  veriphy_certified (ring1)
  -- certificate: de-poly.sage

/-! ## exr-ls-companion -/

/-- The companion matrix of `y^{(n)} + a_{n-1} y^{(n-1)} + … + a₀ y`: ones on the superdiagonal, last row `-a`. -/
def companion {n : ℕ} (a : Fin (n + 1) → ℝ) : Matrix (Fin (n + 1)) (Fin (n + 1)) ℝ :=
  fun i j => if (i : ℕ) = n then -a j else if (j : ℕ) = i + 1 then 1 else 0

/-- `A u` shifts `u = (y, y', …)`: `(Au)ᵢ = uᵢ₊₁` below the last row, and the last row is `-Σ aⱼ uⱼ`, so `u' = Au`
is the equation. -/
theorem companion_mulVec {n : ℕ} (a u : Fin (n + 1) → ℝ) (i : Fin (n + 1)) :
    (companion a *ᵥ u) i = if (i : ℕ) = n then -∑ j, a j * u j else u ⟨(i + 1) % (n + 1), Nat.mod_lt _ (by omega)⟩ := by
  simp only [Matrix.mulVec, dotProduct, companion]
  split_ifs with h
  · simp [Finset.sum_neg_distrib, neg_mul]
  · have hi : (i : ℕ) + 1 < n + 1 := by omega
    rw [Finset.sum_eq_single ⟨(i : ℕ) + 1, hi⟩]
    · simp [Nat.mod_eq_of_lt hi]
    · intro j _ hj
      have : (j : ℕ) ≠ i + 1 := fun e => hj (Fin.ext e)
      simp [this]
    · simp
attribute [veriphy_tested oracle_test 0 3] KaluzaKlein.DifferentialEquations.LinearSystems.companion_mulVec
-- test: de-companion-test.sage

/-- For `n = 2`, `det(λ - A) = λ² + a₁λ + a₀`. -/
theorem companion_charpoly_two (a₀ a₁ l : ℝ) : Matrix.det !![l - 0, -1; a₀, l + a₁] = l ^ 2 + a₁ * l + a₀ := by
  veriphy_certified (norm_num [Matrix.det_fin_two_of] <;> ring1)
  -- certificate: la-matrix.sage

/-- The characteristic polynomial is what `y = e^{λt}` gives: `y'' + a₁y' + a₀y = (λ² + a₁λ + a₀) e^{λt}`. -/
theorem char_substitution (a₀ a₁ l t : ℝ) :
    deriv (fun s => deriv (fun r => Real.exp (l * r)) s) t + a₁ * deriv (fun s => Real.exp (l * s)) t +
      a₀ * Real.exp (l * t) = (l ^ 2 + a₁ * l + a₀) * Real.exp (l * t) := by
  veriphy_certified
    ( have i0 : deriv (fun (r : ℝ) => (rexp (l * r) : ℝ)) = fun (d1 : ℝ) => (l * (Real.exp (d1 * l)) : ℝ) :=
        by
        funext d1
        have hd : HasDerivAt (fun (r : ℝ) => (rexp (l * r) : ℝ)) ((l * (Real.exp (d1 * l)) : ℝ)) (d1) :=
          by
          convert (((hasDerivAt_id' (d1 : ℝ)).const_mul (l : ℝ)).exp) using 1
          all_goals ((ring_nf; done))
        exact hd.deriv
      rw [i0]
      have h1 :
        HasDerivAt (fun s => (fun (d1 : ℝ) => (l * (Real.exp (d1 * l)) : ℝ)) s) (((l ^ 2) * (Real.exp (l * t)) : ℝ))
          (t) :=
        by
        convert ((((hasDerivAt_id' (t : ℝ)).const_mul (l : ℝ)).exp).const_mul (l : ℝ)) using 1
        all_goals ((ring_nf; done))
      try rw [h1.deriv]
      have h2 : HasDerivAt (fun s => rexp (l * s)) ((l * (Real.exp (l * t)) : ℝ)) (t) :=
        by
        convert (((hasDerivAt_id' (t : ℝ)).const_mul (l : ℝ)).exp) using 1
        all_goals (ring1)
      try rw [h2.deriv]
      beta_reduce
      (ring_nf; done))
  -- certificate: de-partials.sage

end KaluzaKlein.DifferentialEquations.LinearSystems

namespace KaluzaKlein.DifferentialEquations.SolutionSpace

/-! ## exr-ls-solution-space -/

open scoped Matrix.Norms.Operator

/-- The solutions of `ẋ = Ax`, as a subspace of the functions `ℝ → ℝⁿ`. -/
def solutions {n : ℕ} (A : Matrix (Fin n) (Fin n) ℝ) : Submodule ℝ (ℝ → Fin n → ℝ) where
  carrier := {x | ∀ t, HasDerivAt x (A *ᵥ x t) t}
  add_mem' := by
    intro x y hx hy t
    have := (hx t).add (hy t)
    rwa [← Matrix.mulVec_add] at this
  zero_mem' := by
    intro t
    simpa using hasDerivAt_const t (0 : Fin n → ℝ)
  smul_mem' := by
    intro c x hx t
    have := (hx t).const_smul c
    rwa [← Matrix.mulVec_smul] at this

/-- Evaluation at `t = 0`, a linear map from the solution space to `ℝⁿ`. -/
def evalZero {n : ℕ} (A : Matrix (Fin n) (Fin n) ℝ) : solutions A →ₗ[ℝ] (Fin n → ℝ) where
  toFun x := (x : ℝ → Fin n → ℝ) 0
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- `x ↦ A x` is Lipschitz on `ℝⁿ` (it is linear on a finite-dimensional space): the hypothesis of
Picard-Lindelöf. -/
theorem mulVec_lipschitz {n : ℕ} (A : Matrix (Fin n) (Fin n) ℝ) :
    ∃ K, LipschitzWith K (fun x : Fin n → ℝ => A *ᵥ x) := by
  let L : (Fin n → ℝ) →L[ℝ] (Fin n → ℝ) := LinearMap.toContinuousLinearMap (Matrix.mulVecLin A)
  exact ⟨‖L‖₊, L.lipschitz⟩
attribute [veriphy_tested oracle_test 0 3] KaluzaKlein.DifferentialEquations.SolutionSpace.mulVec_lipschitz
-- test: de-mulvec-lipschitz-test.sage

/-- Uniqueness: two solutions with the same initial value coincide, so evaluation at `0` is injective. -/
theorem evalZero_injective {n : ℕ} (A : Matrix (Fin n) (Fin n) ℝ) : Function.Injective (evalZero A) := by
  intro x y h
  obtain ⟨K, hK⟩ := mulVec_lipschitz A
  apply Subtype.ext
  exact ODE_solution_unique_univ (v := fun _ z => A *ᵥ z) (s := fun _ => Set.univ) (t₀ := 0)
    (fun _ => hK.lipschitzOnWith) (fun t => ⟨x.2 t, trivial⟩) (fun t => ⟨y.2 t, trivial⟩) h
attribute [veriphy_tested oracle_test 0 3] KaluzaKlein.DifferentialEquations.SolutionSpace.evalZero_injective
-- test: de-evalzero-injective-test.sage

set_option backward.isDefEq.respectTransparency false in
/-- `t ↦ e^{tA}` has derivative `A e^{tA}` (in the operator norm). -/
theorem hasDerivAt_exp_smul {n : ℕ} (A : Matrix (Fin n) (Fin n) ℝ) (t : ℝ) :
    HasDerivAt (fun s : ℝ => NormedSpace.exp (s • A)) (A * NormedSpace.exp (t • A)) t :=
  hasDerivAt_exp_smul_const' A t
attribute [veriphy_tested oracle_test 0 3] KaluzaKlein.DifferentialEquations.SolutionSpace.hasDerivAt_exp_smul
-- test: de-exp-deriv-test.sage

set_option backward.isDefEq.respectTransparency false in
/-- Existence: `x(t) = e^{tA} x₀` solves `ẋ = Ax` with `x(0) = x₀`, so evaluation at `0` is surjective. -/
theorem exp_mulVec_solves {n : ℕ} (A : Matrix (Fin n) (Fin n) ℝ) (x₀ : Fin n → ℝ) (t : ℝ) :
    HasDerivAt (fun s => NormedSpace.exp (s • A) *ᵥ x₀) (A *ᵥ (NormedSpace.exp (t • A) *ᵥ x₀)) t := by
  let L : Matrix (Fin n) (Fin n) ℝ →L[ℝ] (Fin n → ℝ) :=
    LinearMap.toContinuousLinearMap
      { toFun := fun M => M *ᵥ x₀, map_add' := fun M N => Matrix.add_mulVec M N x₀,
        map_smul' := fun c M => Matrix.smul_mulVec c M x₀ }
  have := L.hasFDerivAt.comp_hasDerivAt t (hasDerivAt_exp_smul A t)
  convert this using 1
  all_goals first | rfl | simp [L, Matrix.mulVec_mulVec]
attribute [veriphy_tested oracle_test 0 3] KaluzaKlein.DifferentialEquations.SolutionSpace.exp_mulVec_solves
-- test: de-exp-mulvec-test.sage

set_option backward.isDefEq.respectTransparency false in
theorem evalZero_surjective {n : ℕ} (A : Matrix (Fin n) (Fin n) ℝ) : Function.Surjective (evalZero A) := by
  intro x₀
  refine ⟨⟨fun s => NormedSpace.exp (s • A) *ᵥ x₀, fun t => exp_mulVec_solves A x₀ t⟩, ?_⟩
  simp [evalZero]
attribute [veriphy_tested oracle_test 0 3] KaluzaKlein.DifferentialEquations.SolutionSpace.evalZero_surjective
-- test: de-evalzero-surjective-test.sage

/-- The solution space of `ẋ = Ax` has dimension `n`: evaluation at `0` is a linear bijection onto `ℝⁿ`. -/
theorem finrank_solutions {n : ℕ} (A : Matrix (Fin n) (Fin n) ℝ) : Module.finrank ℝ (solutions A) = n := by
  have e := LinearEquiv.ofBijective (evalZero A) ⟨evalZero_injective A, evalZero_surjective A⟩
  rw [e.finrank_eq, Module.finrank_fin_fun]
attribute [veriphy_tested oracle_test 0 3] KaluzaKlein.DifferentialEquations.SolutionSpace.finrank_solutions
-- test: de-finrank-solutions-test.sage

end KaluzaKlein.DifferentialEquations.SolutionSpace

namespace KaluzaKlein.DifferentialEquations.Eigenvalues

/-! ## def-eigenvalue -/

/-- If `Av = λv` then `x(t) = e^{λt} v` solves `ẋ = Ax`. -/
theorem eigen_solution {n : ℕ} (A : Matrix (Fin n) (Fin n) ℝ) (v : Fin n → ℝ) (l : ℝ) (hv : A *ᵥ v = l • v)
    (t : ℝ) : HasDerivAt (fun s => Real.exp (l * s) • v) (A *ᵥ (Real.exp (l * t) • v)) t := by
  have h : HasDerivAt (fun s => Real.exp (l * s) • v) ((Real.exp (l * t) * l) • v) t := by
    have := (((hasDerivAt_id' t).const_mul l).exp).smul_const v
    simpa using this
  convert h using 1
  rw [Matrix.mulVec_smul, hv, smul_smul, mul_comm]
attribute [veriphy_tested oracle_test 0 3] KaluzaKlein.DifferentialEquations.Eigenvalues.eigen_solution
-- test: de-eigen-solution-test.sage

/-- `λ` is an eigenvalue (`Av = λv` for some `v ≠ 0`) exactly when `det(λ - A) = 0`. -/
theorem eigenvalue_iff_det {n : ℕ} (A : Matrix (Fin n) (Fin n) ℝ) (l : ℝ) :
    (∃ v : Fin n → ℝ, v ≠ 0 ∧ A *ᵥ v = l • v) ↔ Matrix.det (Matrix.scalar (Fin n) l - A) = 0 := by
  rw [← Matrix.exists_mulVec_eq_zero_iff]
  refine exists_congr fun v => and_congr_right fun _ => ?_
  rw [Matrix.sub_mulVec, Matrix.scalar_apply, show (Matrix.diagonal fun _ : Fin n => l) *ᵥ v = l • v by
    ext i; simp [Matrix.mulVec_diagonal], sub_eq_zero, eq_comm]
attribute [veriphy_tested oracle_test 0 3] KaluzaKlein.DifferentialEquations.Eigenvalues.eigenvalue_iff_det
-- test: de-eigen-det-test.sage

/-! ## exm-eigen-diagonal -/

/-- `diag(1, -1) e₁ = e₁`. -/
theorem diag_eigen_one : !![(1 : ℝ), 0; 0, -1] * !![(1 : ℝ); 0] = !![1; 0] := by
  veriphy_certified
    ( ext i j
      fin_cases i <;> fin_cases j <;> norm_num [Matrix.mul_apply, Fin.sum_univ_succ, Matrix.transpose_apply])
  -- certificate: la-matrix.sage

/-- `diag(1, -1) e₂ = -e₂`. -/
theorem diag_eigen_two : !![(1 : ℝ), 0; 0, -1] * !![(0 : ℝ); 1] = !![0; -1] := by
  veriphy_certified
    ( ext i j
      fin_cases i <;> fin_cases j <;> norm_num [Matrix.mul_apply, Fin.sum_univ_succ, Matrix.transpose_apply])
  -- certificate: la-matrix.sage

/-- `x = (c₁eᵗ, c₂e^{-t})` solves `ẋ = diag(1, -1) x`. -/
theorem diag_solution (c₁ c₂ t : ℝ) :
    !![(1 : ℝ), 0; 0, -1] * !![c₁ * Real.exp t; c₂ * Real.exp (-t)] =
      !![deriv (fun s => c₁ * Real.exp s) t; deriv (fun s => c₂ * Real.exp (-s)) t] := by
  veriphy_certified
    ( have h0 : HasDerivAt (fun s => c₁ * rexp s) ((c₁ * (Real.exp t) : ℝ)) (t) :=
        by
        convert (((hasDerivAt_id' (t : ℝ)).exp).const_mul (c₁ : ℝ)) using 1
        all_goals (ring1)
      rw [h0.deriv]
      have h1 : HasDerivAt (fun s => c₂ * rexp (-s)) ((-c₂ * (Real.exp (-t)) : ℝ)) (t) :=
        by
        convert ((((hasDerivAt_id' (t : ℝ)).const_mul (-1 : ℝ)).exp).const_mul (c₂ : ℝ)) using 1
        all_goals ((ring_nf; done))
      rw [h1.deriv]
      (norm_num; done))
  -- certificate: de-partials.sage

/-! ## exm-eigen-rotation -/

/-- `det(λ - J) = λ² + 1`. -/
theorem rotation_charpoly (l : ℝ) : Matrix.det !![l - 0, -1; 1, l - 0] = l ^ 2 + 1 := by
  veriphy_certified (norm_num [Matrix.det_fin_two_of] <;> ring1)
  -- certificate: la-matrix.sage

/-- `J (1, i) = (i, -1)` … -/
theorem rotation_eigenvector (i : ℂ) : !![(0 : ℂ), 1; -1, 0] * !![1; i] = !![i; -1] := by
  veriphy_certified
    ( ext i j
      fin_cases i <;> fin_cases j <;> norm_num [Matrix.mul_apply, Fin.sum_univ_succ, Matrix.transpose_apply] <;> ring1)
  -- certificate: la-matrix.sage

/-- … `= i (1, i)`, since `i · i = -1`: `(1, i)` is an eigenvector for `i` (and `(1, -i)` for `-i`). -/
