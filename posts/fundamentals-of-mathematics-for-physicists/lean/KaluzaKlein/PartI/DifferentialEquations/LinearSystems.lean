/-- Substituting `a cos ωt + b sin ωt`: the coefficient of `cos ωt` gives `(ω₀² - ω²)a + 2γωb = F` … -/
theorem response_cos_equation (γ ω₀ ω F : ℝ) (hΔ : (ω₀ ^ 2 - ω ^ 2) ^ 2 + 4 * γ ^ 2 * ω ^ 2 ≠ 0) :
    (ω₀ ^ 2 - ω ^ 2) * (F * (ω₀ ^ 2 - ω ^ 2) / ((ω₀ ^ 2 - ω ^ 2) ^ 2 + 4 * γ ^ 2 * ω ^ 2)) +
      2 * γ * ω * (2 * γ * ω * F / ((ω₀ ^ 2 - ω ^ 2) ^ 2 + 4 * γ ^ 2 * ω ^ 2)) = F := by
  veriphy_certified
    ( rw [mul_div_assoc', mul_div_assoc', ← add_div, div_eq_iff hΔ]
      ring)
  -- certificate: de-rewrite.sage

/-- … and that of `sin ωt` gives `-2γωa + (ω₀² - ω²)b = 0`. -/
theorem response_sin_equation (γ ω₀ ω F : ℝ) (hΔ : (ω₀ ^ 2 - ω ^ 2) ^ 2 + 4 * γ ^ 2 * ω ^ 2 ≠ 0) :
    -(2 * γ * ω) * (F * (ω₀ ^ 2 - ω ^ 2) / ((ω₀ ^ 2 - ω ^ 2) ^ 2 + 4 * γ ^ 2 * ω ^ 2)) +
      (ω₀ ^ 2 - ω ^ 2) * (2 * γ * ω * F / ((ω₀ ^ 2 - ω ^ 2) ^ 2 + 4 * γ ^ 2 * ω ^ 2)) = 0 := by
  veriphy_certified ((field_simp; ring))
  -- certificate: de-rewrite.sage

