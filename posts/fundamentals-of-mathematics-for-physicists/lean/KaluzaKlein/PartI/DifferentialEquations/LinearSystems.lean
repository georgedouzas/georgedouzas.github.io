-- test: de-real-roots-test.sage

/-! ## exr-eigen-symmetric -/

open scoped ComplexOrder in
/-- Every eigenvalue of a real symmetric matrix is real: if `Av = λv` with `v ∈ ℂⁿ` non-zero then `λ = λ̄`. -/
theorem symmetric_eigenvalue_real {n : ℕ} (A : Matrix (Fin n) (Fin n) ℝ) (hA : Aᵀ = A) (v : Fin n → ℂ)
    (hv : v ≠ 0) (l : ℂ) (h : (A.map (fun x : ℝ => (x : ℂ))) *ᵥ v = l • v) : (starRingEnd ℂ) l = l := by
  set B := A.map (fun x : ℝ => (x : ℂ)) with hB
  have hBh : Bᴴ = B := by
    ext i j
    simp only [hB, Matrix.conjTranspose_apply, Matrix.map_apply, Complex.star_def, Complex.conj_ofReal]
    rw [← Matrix.transpose_apply A j i, hA]
  have hs : star v ⬝ᵥ (B *ᵥ v) = l * (star v ⬝ᵥ v) := by rw [h, dotProduct_smul, smul_eq_mul]
  have hs' : star v ⬝ᵥ (B *ᵥ v) = (starRingEnd ℂ) l * (star v ⬝ᵥ v) := by
    have : star v ⬝ᵥ (B *ᵥ v) = star (B *ᵥ v) ⬝ᵥ v := by
      rw [Matrix.dotProduct_mulVec, Matrix.star_mulVec, hBh]
    rw [this, h, star_smul, smul_dotProduct, smul_eq_mul]
    rfl
  have hpos : star v ⬝ᵥ v ≠ 0 := by
    rw [Ne, dotProduct_star_self_eq_zero]
    exact hv
  exact mul_right_cancel₀ hpos (hs'.symm.trans hs)
attribute [veriphy_tested oracle_test 0 3] KaluzaKlein.DifferentialEquations.Eigenvalues.symmetric_eigenvalue_real
-- test: de-symmetric-real-test.sage

/-- Eigenvectors of a symmetric matrix for different eigenvalues are orthogonal: `w · v = 0`. -/
theorem symmetric_eigenvectors_orthogonal {n : ℕ} (A : Matrix (Fin n) (Fin n) ℝ) (hA : Aᵀ = A)
    (v w : Fin n → ℝ) (l m : ℝ) (hv : A *ᵥ v = l • v) (hw : A *ᵥ w = m • w) (hlm : l ≠ m) : w ⬝ᵥ v = 0 := by
  have h1 : w ⬝ᵥ (A *ᵥ v) = l * (w ⬝ᵥ v) := by rw [hv, dotProduct_smul, smul_eq_mul]
  have h2 : w ⬝ᵥ (A *ᵥ v) = m * (w ⬝ᵥ v) := by
    rw [Matrix.dotProduct_mulVec, ← Matrix.mulVec_transpose, hA, hw, smul_dotProduct, smul_eq_mul]
  have : (l - m) * (w ⬝ᵥ v) = 0 := by rw [sub_mul, ← h1, ← h2, sub_self]
  exact (mul_eq_zero.mp this).resolve_left (sub_ne_zero.mpr hlm)
attribute [veriphy_tested oracle_test 0 3] KaluzaKlein.DifferentialEquations.Eigenvalues.symmetric_eigenvectors_orthogonal
-- test: de-symmetric-orth-test.sage

