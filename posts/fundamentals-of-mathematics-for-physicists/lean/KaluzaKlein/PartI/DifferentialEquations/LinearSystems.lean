/-- … and eigenvalues `-½ ± i√15/2`: a spiral sink. -/
theorem A3_eigenvalue (i s : ℂ) (hi : i ^ 2 = -1) (hs : s ^ 2 = 15) :
    (-1 / 2 + i * s / 2) ^ 2 + (-1 / 2 + i * s / 2) + 4 = 0 := by
  veriphy_certified (linear_combination (15 / 4) * hi + (1 / 4 * i ^ 2) * hs)
  -- certificate: de-poly.sage

/-! ## exr-stab-trace-det-plane -/

/-- Real eigenvalues of opposite signs (a saddle) exactly when the determinant is negative. -/
theorem saddle_iff (l₁ l₂ : ℝ) (h : l₁ * l₂ < 0) : (l₁ < 0 ∧ 0 < l₂) ∨ (0 < l₁ ∧ l₂ < 0) := by
  rcases lt_or_gt_of_ne (show l₁ ≠ 0 by rintro rfl; simp at h) with h₁ | h₁
  · left; exact ⟨h₁, by nlinarith⟩
  · right; exact ⟨h₁, by nlinarith⟩
