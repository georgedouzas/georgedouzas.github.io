/-- … eigenvalues `3, -2`: `det(λ - A₂) = (λ - 3)(λ + 2)`, a saddle. -/
theorem A2_charpoly (l : ℝ) : Matrix.det !![l - 1, -2; -3, l - 0] = (l - 3) * (l + 2) := by
  veriphy_certified (norm_num [Matrix.det_fin_two_of] <;> ring1)
