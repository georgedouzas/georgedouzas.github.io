/-! ## exm-mef-how-sage-exponentiates -/

/-- Sage's complex form of an entry: `½e^{(-1+i)t} + ½e^{(-1-i)t} = e^{-t} cos t`. -/
theorem sage_complex_entry (t : ℝ) :
    1 / 2 * Complex.exp ((-1 + Complex.I) * t) + 1 / 2 * Complex.exp ((-1 - Complex.I) * t) =
      (Real.exp (-t) * Real.cos t : ℝ) := by
  have h1 : (-1 + Complex.I) * (t : ℂ) = (-t : ℂ) + t * Complex.I := by ring
  have h2 : (-1 - Complex.I) * (t : ℂ) = (-t : ℂ) + -(t * Complex.I) := by ring
  rw [h1, h2, Complex.exp_add, Complex.exp_add, Complex.ofReal_mul, Complex.ofReal_exp, Complex.ofReal_cos,
    Complex.cos.eq_1]
  push_cast
  ring_nf
