/-- Summing the series: `e^{tJ} = cos t · 1 + sin t · J`. -/
theorem exp_J_series (t : ℝ) :
    NormedSpace.exp (t • !![(0 : ℝ), 1; -1, 0]) =
      Real.cos t • (1 : Matrix (Fin 2) (Fin 2) ℝ) + Real.sin t • !![(0 : ℝ), 1; -1, 0] := by
  have hB : !![(0 : ℝ), 1; -1, 0] * !![(0 : ℝ), 1; -1, 0] = -((1 : ℝ) ^ 2) • (1 : Matrix (Fin 2) (Fin 2) ℝ) := by
    ext i j; fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply, Fin.sum_univ_two]
  have := MatrixExponential.exp_spiral !![(0 : ℝ), 1; -1, 0] 0 1 one_ne_zero hB t
  simpa using this
attribute [veriphy_tested oracle_test 0 3] KaluzaKlein.DifferentialEquations.LinearSystemComputations.exp_J_series
