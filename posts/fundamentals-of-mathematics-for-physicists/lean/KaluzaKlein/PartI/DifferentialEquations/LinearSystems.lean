/-! ## exr-stab-lyapunov -/

/-- Along a solution of `ẋ = Ax`, `d/dt |x|² = 2 x·Ax`. -/
theorem norm_sq_deriv {n : ℕ} (A : Matrix (Fin n) (Fin n) ℝ) (x : ℝ → Fin n → ℝ) (t : ℝ)
    (hx : HasDerivAt x (A *ᵥ x t) t) :
    HasDerivAt (fun s => x s ⬝ᵥ x s) (2 * (x t ⬝ᵥ (A *ᵥ x t))) t := by
  have hi : ∀ i, HasDerivAt (fun s => x s i) ((A *ᵥ x t) i) t := fun i => hasDerivAt_pi.1 hx i
  have h := HasDerivAt.fun_sum (u := Finset.univ) (fun i _ => (hi i).mul (hi i))
  simp only [dotProduct]
  convert h using 1
  rw [Finset.mul_sum]
  exact Finset.sum_congr rfl fun i _ => by ring
attribute [veriphy_tested oracle_test 0 3] KaluzaKlein.DifferentialEquations.Stability.norm_sq_deriv
-- test: de-norm-sq-deriv-test.sage

/-- Decay from a differential inequality: if `f' ≤ -2c f` then `f(t) ≤ e^{-2ct} f(0)` for `t ≥ 0`. -/
theorem gronwall_decay (f f' : ℝ → ℝ) (c : ℝ) (hf : ∀ t, HasDerivAt f (f' t) t) (h : ∀ t, f' t ≤ -2 * c * f t)
    (t : ℝ) (ht : 0 ≤ t) : f t ≤ Real.exp (-2 * c * t) * f 0 := by
  have hg : ∀ s, HasDerivAt (fun s => Real.exp (2 * c * s) * f s)
      (Real.exp (2 * c * s) * (2 * c) * f s + Real.exp (2 * c * s) * f' s) s := by
    intro s
    have := (((hasDerivAt_id' s).const_mul (2 * c)).exp).mul (hf s)
    convert this using 1
    ring
  have hanti : Antitone fun s => Real.exp (2 * c * s) * f s := by
    apply antitone_of_deriv_nonpos (fun s => (hg s).differentiableAt)
    intro s
    rw [(hg s).deriv]
    have := h s
    have he := Real.exp_pos (2 * c * s)
    nlinarith
  have := hanti ht
  simp only [mul_zero, Real.exp_zero, one_mul] at this
  have he : Real.exp (-2 * c * t) * Real.exp (2 * c * t) = 1 := by
    rw [← Real.exp_add]; simp
  calc f t = Real.exp (-2 * c * t) * (Real.exp (2 * c * t) * f t) := by rw [← mul_assoc, he, one_mul]
    _ ≤ Real.exp (-2 * c * t) * f 0 := mul_le_mul_of_nonneg_left this (Real.exp_pos _).le
attribute [veriphy_tested oracle_test 0 3] KaluzaKlein.DifferentialEquations.Stability.gronwall_decay
-- test: de-gronwall-test.sage

/-- A negative definite quadratic form is bounded by `-c|v|²` for some `c > 0` (compactness of the unit sphere). -/
theorem negdef_bound {n : ℕ} (A : Matrix (Fin n) (Fin n) ℝ) (hA : ∀ v : Fin n → ℝ, v ≠ 0 → v ⬝ᵥ (A *ᵥ v) < 0) :
    ∃ c > 0, ∀ v : Fin n → ℝ, v ⬝ᵥ (A *ᵥ v) ≤ -c * (v ⬝ᵥ v) := by
  set S := {v : Fin n → ℝ | v ⬝ᵥ v = 1}
  have hq : Continuous fun v : Fin n → ℝ => v ⬝ᵥ (A *ᵥ v) := by
    simp only [dotProduct, Matrix.mulVec]; fun_prop
  have hdd : Continuous fun v : Fin n → ℝ => v ⬝ᵥ v := by
    simp only [dotProduct]; fun_prop
  have hsq : ∀ (v : Fin n → ℝ) i, v i ^ 2 ≤ v ⬝ᵥ v := by
    intro v i
    simp only [dotProduct]
    rw [sq]
    exact Finset.single_le_sum (f := fun j => v j * v j) (fun j _ => mul_self_nonneg _) (Finset.mem_univ i)
  have hdpos : ∀ v : Fin n → ℝ, v ≠ 0 → 0 < v ⬝ᵥ v := by
    intro v hv
    obtain ⟨i, hi⟩ := Function.ne_iff.mp hv
    exact lt_of_lt_of_le (lt_of_le_of_ne (sq_nonneg _) (Ne.symm (pow_ne_zero 2 hi))) (hsq v i)
  by_cases hS : S.Nonempty
  · have hc : IsCompact S := by
      apply Metric.isCompact_of_isClosed_isBounded (isClosed_eq hdd continuous_const)
      refine (Metric.isBounded_iff_subset_closedBall 0).2 ⟨1, fun v hv => ?_⟩
      rw [Metric.mem_closedBall, dist_zero_right, pi_norm_le_iff_of_nonneg zero_le_one]
      intro i
      rw [Real.norm_eq_abs]
      have h1 := hsq v i
      rw [show v ⬝ᵥ v = 1 from hv] at h1
      nlinarith [abs_nonneg (v i), sq_abs (v i)]
    obtain ⟨u, hu, hmax⟩ := hc.exists_isMaxOn hS hq.continuousOn
    have hu0 : u ≠ 0 := by
      rintro rfl
      simp [S] at hu
    refine ⟨-(u ⬝ᵥ (A *ᵥ u)), by linarith [hA u hu0], fun v => ?_⟩
    by_cases hv : v = 0
    · subst hv; simp
    · set r := Real.sqrt (v ⬝ᵥ v)
      have hr : 0 < r := Real.sqrt_pos.mpr (hdpos v hv)
      have hr2 : r ^ 2 = v ⬝ᵥ v := Real.sq_sqrt (hdpos v hv).le
      have hw : r⁻¹ • v ∈ S := by
        show (r⁻¹ • v) ⬝ᵥ (r⁻¹ • v) = 1
        rw [smul_dotProduct, dotProduct_smul, smul_eq_mul, smul_eq_mul, ← mul_assoc, ← hr2]
        field_simp
      have := hmax hw
      simp only [Set.mem_setOf_eq] at this
      rw [Matrix.mulVec_smul, smul_dotProduct, dotProduct_smul, smul_eq_mul, smul_eq_mul] at this
      have key : v ⬝ᵥ (A *ᵥ v) = r ^ 2 * (r⁻¹ * (r⁻¹ * (v ⬝ᵥ (A *ᵥ v)))) := by
        field_simp
      rw [key, ← hr2]
      nlinarith [sq_nonneg r]
  · refine ⟨1, one_pos, fun v => ?_⟩
    by_cases hv : v = 0
    · subst hv; simp
    · exfalso
      apply hS
      set r := Real.sqrt (v ⬝ᵥ v)
      have hr : 0 < r := Real.sqrt_pos.mpr (hdpos v hv)
      have hr2 : r ^ 2 = v ⬝ᵥ v := Real.sq_sqrt (hdpos v hv).le
      refine ⟨r⁻¹ • v, ?_⟩
      show (r⁻¹ • v) ⬝ᵥ (r⁻¹ • v) = 1
      rw [smul_dotProduct, dotProduct_smul, smul_eq_mul, smul_eq_mul, ← mul_assoc, ← hr2]
      field_simp
