/-! ## exr-mexp-sage -/

set_option backward.isDefEq.respectTransparency false in
/-- For `M = 1 + N` with `N² = 0`: `e^{tM} = eᵗ (1 + tN)`. -/
theorem exp_one_add_nilpotent {n : ℕ} (N : Matrix (Fin n) (Fin n) ℝ) (hN : N * N = 0) (t : ℝ) :
    NormedSpace.exp (t • (1 + N)) = Real.exp t • (1 + t • N) := by
  apply exp_eq_of_ode
  · intro s
    have h1 := (Real.hasDerivAt_exp s).smul (((hasDerivAt_id s).smul_const N).const_add (1 : Matrix (Fin n) (Fin n) ℝ))
    refine h1.congr_deriv ?_
    simp only [id_eq, one_smul]
    rw [add_mul, one_mul, mul_smul_comm, mul_add, mul_one, mul_smul_comm, hN, smul_zero, add_zero]
    module
  · simp
attribute [veriphy_tested oracle_test 0 3] KaluzaKlein.DifferentialEquations.MatrixExponential.exp_one_add_nilpotent
-- test: de-exp-one-add-nil-test.sage

/-- `e^{tM} = eᵗ (1, t; 0, 1)` satisfies `d/dt e^{tM} = M e^{tM}`, entry by entry. -/
theorem exp_M_derivative (t : ℝ) :
    !![(1 : ℝ), 1; 0, 1] * !![Real.exp t, t * Real.exp t; 0, Real.exp t] =
      !![deriv (fun s => Real.exp s) t, deriv (fun s => s * Real.exp s) t; 0, deriv (fun s => Real.exp s) t] := by
  veriphy_certified
    ( have h0 : HasDerivAt (fun s => rexp s) ((Real.exp t : ℝ)) (t) :=
        by
        convert ((hasDerivAt_id' (t : ℝ)).exp) using 1
        all_goals (ring1)
      rw [h0.deriv]
      have h1 : HasDerivAt (fun s => s * rexp s) ((t * (Real.exp t) + (Real.exp t) : ℝ)) (t) :=
        by
        convert ((hasDerivAt_id' (t : ℝ)).mul ((hasDerivAt_id' (t : ℝ)).exp)) using 1
        all_goals (ring1)
      rw [h1.deriv]
      (norm_num; done))
  -- certificate: de-partials.sage

/-! ## exr-mexp-eigenvector -/

set_option backward.isDefEq.respectTransparency false in
/-- If `Av = λv` then `e^{tA}v = e^{λt}v`. -/
theorem exp_eigenvector {n : ℕ} (A : Matrix (Fin n) (Fin n) ℝ) (v : Fin n → ℝ) (l : ℝ) (hv : A *ᵥ v = l • v)
    (t : ℝ) : NormedSpace.exp (t • A) *ᵥ v = Real.exp (l * t) • v := by
  have h := SolutionSpace.evalZero_injective A
    (a₁ := ⟨fun s => NormedSpace.exp (s • A) *ᵥ v, fun s => SolutionSpace.exp_mulVec_solves A v s⟩)
    (a₂ := ⟨fun s => Real.exp (l * s) • v, fun s => Eigenvalues.eigen_solution A v l hv s⟩)
    (by simp [SolutionSpace.evalZero])
  exact congrFun (congrArg Subtype.val h) t
attribute [veriphy_tested oracle_test 0 3] KaluzaKlein.DifferentialEquations.MatrixExponential.exp_eigenvector
-- test: de-exp-eigenvector-test.sage

/-! ## exr-mexp-commuting -/

/-- `e^N = (1, 1; 0, 1)`. -/
theorem exp_N_one : NormedSpace.exp !![(0 : ℝ), 1; 0, 0] = !![1, 1; 0, 1] := by
  veriphy_certified
    ( have hN : (!![0, 1; 0, 0] : Matrix (Fin 2) (Fin 2) ℝ) ^ 2 = 0 :=
        by
        ext i j
        fin_cases i <;> fin_cases j <;>
          simp [pow_succ, Matrix.mul_apply, Fin.sum_univ_succ, Matrix.diagonal_apply, Matrix.smul_apply,
            Matrix.vecMul_diagonal, Matrix.mulVec_diagonal]
      rw [NormedSpace.exp_eq_tsum_rat]
      beta_reduce
      rw [tsum_eq_sum (s := Finset.range 2)
          (fun n hn => by
            simp only [Finset.mem_range, not_lt] at hn
            rw [pow_eq_zero_of_le hn hN, smul_zero])]
      ext i j
      fin_cases i <;> fin_cases j <;>
          simp [Finset.sum_range_succ, pow_succ, Rat.smul_def, Matrix.mul_apply, Fin.sum_univ_succ,
            Matrix.diagonal_apply, Matrix.smul_apply, Matrix.vecMul_diagonal, Matrix.mulVec_diagonal] <;>
        norm_num)
  -- certificate: de-mexp-N.sage

/-- `e^{Nᵀ} = (1, 0; 1, 1)`. -/
theorem exp_NT_one : NormedSpace.exp !![(0 : ℝ), 0; 1, 0] = !![1, 0; 1, 1] := by
  veriphy_certified
    ( have hN : (!![0, 0; 1, 0] : Matrix (Fin 2) (Fin 2) ℝ) ^ 2 = 0 :=
        by
        ext i j
        fin_cases i <;> fin_cases j <;>
          simp [pow_succ, Matrix.mul_apply, Fin.sum_univ_succ, Matrix.diagonal_apply, Matrix.smul_apply,
            Matrix.vecMul_diagonal, Matrix.mulVec_diagonal]
      rw [NormedSpace.exp_eq_tsum_rat]
      beta_reduce
      rw [tsum_eq_sum (s := Finset.range 2)
          (fun n hn => by
            simp only [Finset.mem_range, not_lt] at hn
            rw [pow_eq_zero_of_le hn hN, smul_zero])]
      ext i j
      fin_cases i <;> fin_cases j <;>
          simp [Finset.sum_range_succ, pow_succ, Rat.smul_def, Matrix.mul_apply, Fin.sum_univ_succ,
            Matrix.diagonal_apply, Matrix.smul_apply, Matrix.vecMul_diagonal, Matrix.mulVec_diagonal] <;>
        norm_num)
  -- certificate: de-mexp-NT.sage

/-- `e^N e^{Nᵀ} = (2, 1; 1, 1)`. -/
theorem exp_N_exp_NT : !![(1 : ℝ), 1; 0, 1] * !![(1 : ℝ), 0; 1, 1] = !![2, 1; 1, 1] := by
  veriphy_certified
    ( ext i j
      fin_cases i <;> fin_cases j <;> norm_num [Matrix.mul_apply, Fin.sum_univ_succ, Matrix.transpose_apply])
  -- certificate: la-matrix.sage

/-- `e^{t(N + Nᵀ)} = (cosh t, sinh t; sinh t, cosh t)`. -/
theorem exp_N_add_NT (t : ℝ) :
    NormedSpace.exp (t • !![(0 : ℝ), 1; 1, 0]) = !![Real.cosh t, Real.sinh t; Real.sinh t, Real.cosh t] := by
  veriphy_certified
    ( have hPQ :
        (!![1, 1; 1, -1] : Matrix (Fin 2) (Fin 2) ℝ) *
            (!![(1 / 2), (1 / 2); (1 / 2), (-1 / 2)] : Matrix (Fin 2) (Fin 2) ℝ) =
          1 :=
        by
        ext i j
        fin_cases i <;> fin_cases j <;> norm_num [Matrix.mul_apply, Fin.sum_univ_succ, Matrix.one_apply]
      have hinv :
        (!![1, 1; 1, -1] : Matrix (Fin 2) (Fin 2) ℝ)⁻¹ =
          (!![(1 / 2), (1 / 2); (1 / 2), (-1 / 2)] : Matrix (Fin 2) (Fin 2) ℝ) :=
        Matrix.inv_eq_right_inv hPQ
      have hunit : IsUnit (!![1, 1; 1, -1] : Matrix (Fin 2) (Fin 2) ℝ) := ⟨⟨_, _, hPQ, mul_eq_one_comm.mp hPQ⟩, rfl⟩
      have hconj :
        t • (!![0, 1; 1, 0] : Matrix (Fin 2) (Fin 2) ℝ) =
          (!![1, 1; 1, -1] : Matrix (Fin 2) (Fin 2) ℝ) * Matrix.diagonal ![1 * t, -1 * t] *
            (!![1, 1; 1, -1] : Matrix (Fin 2) (Fin 2) ℝ)⁻¹ :=
        by
        rw [hinv]
        ext i j
        fin_cases i <;> fin_cases j <;>
            simp [Matrix.mul_apply, Fin.sum_univ_succ, Matrix.diagonal_apply, Matrix.smul_apply, Matrix.vecMul_diagonal,
              Matrix.mulVec_diagonal] <;>
          ring
      rw [hconj, Matrix.exp_conj _ _ hunit, Matrix.exp_diagonal, hinv, Pi.exp_def]
      ext i j
      fin_cases i <;> fin_cases j <;>
          simp [Matrix.mul_apply, Fin.sum_univ_succ, Matrix.diagonal_apply, Matrix.smul_apply, Matrix.vecMul_diagonal,
            Matrix.mulVec_diagonal, ← Real.exp_eq_exp_ℝ, Real.cosh_eq, Real.sinh_eq] <;>
        ring)
  -- certificate: de-mexp-boost.sage

/-- `cosh 1 ≠ 2`, so `e^{N + Nᵀ} ≠ e^N e^{Nᵀ}`: `N` and `Nᵀ` do not commute and the product rule fails. -/
theorem cosh_one_ne_two : Real.cosh 1 ≠ 2 := by
  veriphy_certified
    ( intro h
      rw [Real.cosh_eq] at h
      have h1 := Real.exp_one_lt_d9
      have h2 : Real.exp (-1) < 1 := by rw [← Real.exp_zero]; exact Real.exp_lt_exp.mpr (by norm_num)
      linarith)
  -- certificate: de-rewrite.sage

/-- `N Nᵀ = diag(1, 0)` … -/
theorem N_mul_NT : !![(0 : ℝ), 1; 0, 0] * !![(0 : ℝ), 0; 1, 0] = !![1, 0; 0, 0] := by
  veriphy_certified
    ( ext i j
      fin_cases i <;> fin_cases j <;> norm_num [Matrix.mul_apply, Fin.sum_univ_succ, Matrix.transpose_apply])
  -- certificate: la-matrix.sage

/-- … while `Nᵀ N = diag(0, 1)`: `N` and `Nᵀ` do not commute. -/
theorem NT_mul_N : !![(0 : ℝ), 0; 1, 0] * !![(0 : ℝ), 1; 0, 0] = !![0, 0; 0, 1] := by
  veriphy_certified
    ( ext i j
      fin_cases i <;> fin_cases j <;> norm_num [Matrix.mul_apply, Fin.sum_univ_succ, Matrix.transpose_apply])
  -- certificate: la-matrix.sage

