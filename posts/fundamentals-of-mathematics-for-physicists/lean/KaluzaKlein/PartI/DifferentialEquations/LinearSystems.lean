/-! ## def-harmonic-oscillator -/

/-- `e^{λt}` solves the free oscillator exactly when `λ² + 2γλ + ω₀² = 0`: the residual is that polynomial times
`e^{λt}`. -/
theorem free_exponential (γ ω₀ l t : ℝ) :
    deriv (fun s => deriv (fun r => Real.exp (l * r)) s) t + 2 * γ * deriv (fun s => Real.exp (l * s)) t +
      ω₀ ^ 2 * Real.exp (l * t) = (l ^ 2 + 2 * γ * l + ω₀ ^ 2) * Real.exp (l * t) := by
  veriphy_certified
    ( have i0 : deriv (fun (r : ℝ) => (rexp (l * r) : ℝ)) = fun (d1 : ℝ) => (l * (Real.exp (d1 * l)) : ℝ) :=
        by
        funext d1
        have hd : HasDerivAt (fun (r : ℝ) => (rexp (l * r) : ℝ)) ((l * (Real.exp (d1 * l)) : ℝ)) (d1) :=
          by
          convert (((hasDerivAt_id' (d1 : ℝ)).const_mul (l : ℝ)).exp) using 1
          all_goals ((ring_nf; done))
        exact hd.deriv
      rw [i0]
      have h1 :
        HasDerivAt (fun s => (fun (d1 : ℝ) => (l * (Real.exp (d1 * l)) : ℝ)) s) (((l ^ 2) * (Real.exp (l * t)) : ℝ))
          (t) :=
        by
        convert ((((hasDerivAt_id' (t : ℝ)).const_mul (l : ℝ)).exp).const_mul (l : ℝ)) using 1
        all_goals ((ring_nf; done))
      try rw [h1.deriv]
      have h2 : HasDerivAt (fun s => rexp (l * s)) ((l * (Real.exp (l * t)) : ℝ)) (t) :=
        by
        convert (((hasDerivAt_id' (t : ℝ)).const_mul (l : ℝ)).exp) using 1
        all_goals (ring1)
      try rw [h2.deriv]
      beta_reduce
      (ring_nf; done))
  -- certificate: de-partials.sage

/-- `λ = -γ ± √(γ² - ω₀²)`: with `s² = γ² - ω₀²`, `(-γ + s)² + 2γ(-γ + s) + ω₀² = 0`. -/
theorem free_roots (γ ω₀ s : ℝ) (hs : s ^ 2 = γ ^ 2 - ω₀ ^ 2) : (-γ + s) ^ 2 + 2 * γ * (-γ + s) + ω₀ ^ 2 = 0 := by
  veriphy_certified (linear_combination hs)
  -- certificate: de-poly.sage

/-- Underdamped (`ω₀² = γ² + ω_d²`): `e^{-γt}(C₁ cos ω_d t + C₂ sin ω_d t)` solves the free oscillator. -/
theorem underdamped_solves (γ ωd C₁ C₂ : ℝ) (q : ℝ → ℝ)
    (hq : q = fun s => Real.exp (-γ * s) * (C₁ * Real.cos (ωd * s) + C₂ * Real.sin (ωd * s))) (t : ℝ) :
    deriv (deriv q) t + 2 * γ * deriv q t + (γ ^ 2 + ωd ^ 2) * q t = 0 := by
  veriphy_certified
    ( subst hq
      have d1 :
        deriv (fun s => rexp (-γ * s) * (C₁ * cos (ωd * s) + C₂ * sin (ωd * s))) = fun s =>
          -(C₁ * (Real.cos (s * ωd)) + (C₂ * (Real.sin (s * ωd)))) * γ * (Real.exp (-s * γ)) +
            ((ωd * C₂ * (Real.cos (s * ωd)) - (ωd * C₁ * (Real.sin (s * ωd)))) * (Real.exp (-s * γ))) :=
        by
        funext s
        have hd :
          HasDerivAt (fun s => rexp (-γ * s) * (C₁ * cos (ωd * s) + C₂ * sin (ωd * s)))
            ((-(C₁ * (Real.cos (s * ωd)) + (C₂ * (Real.sin (s * ωd)))) * γ * (Real.exp (-s * γ)) +
                ((ωd * C₂ * (Real.cos (s * ωd)) - (ωd * C₁ * (Real.sin (s * ωd)))) * (Real.exp (-s * γ))) :
              ℝ))
            (s) :=
          by
          convert
            ((((((hasDerivAt_id' (s : ℝ)).const_mul (ωd : ℝ)).cos).const_mul (C₁ : ℝ)).add
                  ((((hasDerivAt_id' (s : ℝ)).const_mul (ωd : ℝ)).sin).const_mul (C₂ : ℝ))).mul
              (((hasDerivAt_id' (s : ℝ)).const_mul (-γ : ℝ)).exp)) using
            1
          all_goals
            first
            | rfl
            | (funext y; simp only [Pi.add_apply, Pi.mul_apply]; ring_nf; done)
            | (simp only [Pi.add_apply]; (ring_nf; done))
        exact hd.deriv
      have d2 :
        deriv
            (fun s =>
              -(C₁ * (Real.cos (s * ωd)) + (C₂ * (Real.sin (s * ωd)))) * γ * (Real.exp (-s * γ)) +
                ((ωd * C₂ * (Real.cos (s * ωd)) - (ωd * C₁ * (Real.sin (s * ωd)))) * (Real.exp (-s * γ)))) =
          fun s =>
          (C₁ * (Real.cos (s * ωd)) + (C₂ * (Real.sin (s * ωd)))) * (γ ^ 2) * (Real.exp (-s * γ)) -
              (2 * (ωd * C₂ * (Real.cos (s * ωd)) - (ωd * C₁ * (Real.sin (s * ωd)))) * γ * (Real.exp (-s * γ))) -
            (((ωd ^ 2) * C₁ * (Real.cos (s * ωd)) + ((ωd ^ 2) * C₂ * (Real.sin (s * ωd)))) * (Real.exp (-s * γ))) :=
        by
        funext s
        have hd :
          HasDerivAt
            (fun s =>
              -(C₁ * (Real.cos (s * ωd)) + (C₂ * (Real.sin (s * ωd)))) * γ * (Real.exp (-s * γ)) +
                ((ωd * C₂ * (Real.cos (s * ωd)) - (ωd * C₁ * (Real.sin (s * ωd)))) * (Real.exp (-s * γ))))
            (((C₁ * (Real.cos (s * ωd)) + (C₂ * (Real.sin (s * ωd)))) * (γ ^ 2) * (Real.exp (-s * γ)) -
                  (2 * (ωd * C₂ * (Real.cos (s * ωd)) - (ωd * C₁ * (Real.sin (s * ωd)))) * γ * (Real.exp (-s * γ))) -
                (((ωd ^ 2) * C₁ * (Real.cos (s * ωd)) + ((ωd ^ 2) * C₂ * (Real.sin (s * ωd)))) * (Real.exp (-s * γ))) :
              ℝ))
            (s) :=
          by
          convert
            ((((((((hasDerivAt_id' (s : ℝ)).const_mul (ωd : ℝ)).cos).const_mul (C₁ : ℝ)).add
                          ((((hasDerivAt_id' (s : ℝ)).const_mul (ωd : ℝ)).sin).const_mul (C₂ : ℝ))).mul
                      (((hasDerivAt_id' (s : ℝ)).const_mul (-γ : ℝ)).exp)).const_mul
                  (-γ : ℝ)).add
              ((((((hasDerivAt_id' (s : ℝ)).const_mul (ωd : ℝ)).cos).const_mul (ωd * C₂ : ℝ)).add
                    ((((hasDerivAt_id' (s : ℝ)).const_mul (ωd : ℝ)).sin).const_mul (-ωd * C₁ : ℝ))).mul
                (((hasDerivAt_id' (s : ℝ)).const_mul (-γ : ℝ)).exp))) using
            1
          all_goals
            first
            | rfl
            | (funext y; simp only [Pi.add_apply, Pi.mul_apply]; ring_nf; done)
            | (simp only [Pi.add_apply]; (ring_nf; done))
        exact hd.deriv
      simp only [d1, d2]
      (ring_nf; done))
  -- certificate: de-ode.sage

/-- Overdamped: with roots `λ₁, λ₂` (`2γ = -(λ₁ + λ₂)`, `ω₀² = λ₁λ₂`), `C₁e^{λ₁t} + C₂e^{λ₂t}` solves it. -/
theorem overdamped_solves (l₁ l₂ C₁ C₂ : ℝ) (q : ℝ → ℝ)
    (hq : q = fun s => C₁ * Real.exp (l₁ * s) + C₂ * Real.exp (l₂ * s)) (t : ℝ) :
    deriv (deriv q) t - (l₁ + l₂) * deriv q t + l₁ * l₂ * q t = 0 := by
  veriphy_certified
    ( subst hq
      have d1 :
        deriv (fun s => C₁ * rexp (l₁ * s) + C₂ * rexp (l₂ * s)) = fun s =>
          l₁ * C₁ * (Real.exp (s * l₁)) + (l₂ * C₂ * (Real.exp (s * l₂))) :=
        by
        funext s
        have hd :
          HasDerivAt (fun s => C₁ * rexp (l₁ * s) + C₂ * rexp (l₂ * s))
            ((l₁ * C₁ * (Real.exp (s * l₁)) + (l₂ * C₂ * (Real.exp (s * l₂))) : ℝ)) (s) :=
          by
          convert
            (((((hasDerivAt_id' (s : ℝ)).const_mul (l₁ : ℝ)).exp).const_mul (C₁ : ℝ)).add
              ((((hasDerivAt_id' (s : ℝ)).const_mul (l₂ : ℝ)).exp).const_mul (C₂ : ℝ))) using
            1
          all_goals ((ring_nf; done))
        exact hd.deriv
      have d2 :
        deriv (fun s => l₁ * C₁ * (Real.exp (s * l₁)) + (l₂ * C₂ * (Real.exp (s * l₂)))) = fun s =>
          (l₁ ^ 2) * C₁ * (Real.exp (s * l₁)) + ((l₂ ^ 2) * C₂ * (Real.exp (s * l₂))) :=
        by
        funext s
        have hd :
          HasDerivAt (fun s => l₁ * C₁ * (Real.exp (s * l₁)) + (l₂ * C₂ * (Real.exp (s * l₂))))
            (((l₁ ^ 2) * C₁ * (Real.exp (s * l₁)) + ((l₂ ^ 2) * C₂ * (Real.exp (s * l₂))) : ℝ)) (s) :=
          by
          convert
            (((((hasDerivAt_id' (s : ℝ)).const_mul (l₁ : ℝ)).exp).const_mul (l₁ * C₁ : ℝ)).add
              ((((hasDerivAt_id' (s : ℝ)).const_mul (l₂ : ℝ)).exp).const_mul (l₂ * C₂ : ℝ))) using
            1
          all_goals
            first
            | rfl
            | (funext y; simp only [Pi.add_apply]; ring_nf; done)
            | ((ring_nf; done))
        exact hd.deriv
      simp only [d1, d2]
      (ring_nf; done))
  -- certificate: de-ode.sage

/-- Critically damped (`γ = ω₀`): `(C₁ + C₂t)e^{-γt}` solves `q̈ + 2γq̇ + γ²q = 0`. -/
theorem critical_solves (γ C₁ C₂ : ℝ) (q : ℝ → ℝ) (hq : q = fun s => (C₁ + C₂ * s) * Real.exp (-γ * s)) (t : ℝ) :
    deriv (deriv q) t + 2 * γ * deriv q t + γ ^ 2 * q t = 0 := by
  veriphy_certified
    ( subst hq
      have d1 :
        deriv (fun s => (C₁ + C₂ * s) * rexp (-γ * s)) = fun s =>
          -(s * C₂ + C₁) * γ * (Real.exp (-s * γ)) + (C₂ * (Real.exp (-s * γ))) :=
        by
        funext s
        have hd :
          HasDerivAt (fun s => (C₁ + C₂ * s) * rexp (-γ * s))
            ((-(s * C₂ + C₁) * γ * (Real.exp (-s * γ)) + (C₂ * (Real.exp (-s * γ))) : ℝ)) (s) :=
          by
          convert
            ((((hasDerivAt_id' (s : ℝ)).const_mul (C₂ : ℝ)).add (hasDerivAt_const (s : ℝ) (C₁ : ℝ))).mul
              (((hasDerivAt_id' (s : ℝ)).const_mul (-γ : ℝ)).exp)) using
            1
          all_goals
            first
            | rfl
            | (funext y; simp only [Pi.add_apply, Pi.mul_apply]; ring_nf; done)
            | (simp only [Pi.add_apply]; (ring_nf; done))
        exact hd.deriv
      have d2 :
        deriv (fun s => -(s * C₂ + C₁) * γ * (Real.exp (-s * γ)) + (C₂ * (Real.exp (-s * γ)))) = fun s =>
          (s * C₂ + C₁) * (γ ^ 2) * (Real.exp (-s * γ)) - (2 * γ * C₂ * (Real.exp (-s * γ))) :=
        by
        funext s
        have hd :
          HasDerivAt (fun s => -(s * C₂ + C₁) * γ * (Real.exp (-s * γ)) + (C₂ * (Real.exp (-s * γ))))
            (((s * C₂ + C₁) * (γ ^ 2) * (Real.exp (-s * γ)) - (2 * γ * C₂ * (Real.exp (-s * γ))) : ℝ)) (s) :=
          by
          convert
            ((((((hasDerivAt_id' (s : ℝ)).const_mul (C₂ : ℝ)).add (hasDerivAt_const (s : ℝ) (C₁ : ℝ))).mul
                      (((hasDerivAt_id' (s : ℝ)).const_mul (-γ : ℝ)).exp)).const_mul
                  (-γ : ℝ)).add
              ((((hasDerivAt_id' (s : ℝ)).const_mul (-γ : ℝ)).exp).const_mul (C₂ : ℝ))) using
            1
          all_goals
            first
            | rfl
            | (funext y; simp only [Pi.add_apply, Pi.mul_apply]; ring_nf; done)
            | (simp only [Pi.add_apply]; (ring_nf; done))
        exact hd.deriv
      simp only [d1, d2]
      (ring_nf; done))
  -- certificate: de-ode.sage

/-! ## exm-ho-undamped -/

/-- `R cos(ω₀t - φ) = (R cos φ) cos ω₀t + (R sin φ) sin ω₀t`: amplitude and phase. -/
theorem amplitude_phase (R φ ω₀ t : ℝ) :
    R * Real.cos (ω₀ * t - φ) = R * Real.cos φ * Real.cos (ω₀ * t) + R * Real.sin φ * Real.sin (ω₀ * t) := by
  veriphy_certified
    ( rw [Real.cos_sub]
      ring)
  -- certificate: de-rewrite.sage

/-- `R = √(C₁² + C₂²)`: `(R cos φ)² + (R sin φ)² = R²`. -/
theorem amplitude_sq (R c s : ℝ) (h : c ^ 2 + s ^ 2 = 1) : (R * c) ^ 2 + (R * s) ^ 2 = R ^ 2 := by
  veriphy_certified (linear_combination (R ^ 2) * h)
  -- certificate: de-poly.sage

/-- The period is `2π/ω₀`, independent of the amplitude. -/
theorem undamped_period (R φ ω₀ t : ℝ) (hω : ω₀ ≠ 0) :
    R * Real.cos (ω₀ * (t + 2 * Real.pi / ω₀) - φ) = R * Real.cos (ω₀ * t - φ) := by
  veriphy_certified
    (rw [show ω₀ * (t + 2 * Real.pi / ω₀) - φ = ω₀ * t - φ + 2 * Real.pi by field_simp; ring, Real.cos_add_two_pi])
  -- certificate: de-rewrite.sage

/-! ## exm-ho-underdamped -/

/-- `λ = -γ ± iω_d` with `ω_d² = ω₀² - γ²`. -/
theorem underdamped_roots (γ ω₀ ωd i : ℂ) (hi : i ^ 2 = -1) (hd : ωd ^ 2 = ω₀ ^ 2 - γ ^ 2) :
    (-γ + i * ωd) ^ 2 + 2 * γ * (-γ + i * ωd) + ω₀ ^ 2 = 0 := by
  veriphy_certified (linear_combination (ωd ^ 2) * hi + (-1) * hd)
  -- certificate: de-poly.sage

/-! ## exm-ho-overdamped -/

/-- For `γ > ω₀ > 0` both roots are negative: `-γ + √(γ² - ω₀²) < 0`. -/
theorem overdamped_negative (γ ω₀ : ℝ) (hω : 0 < ω₀) (hγ : ω₀ < γ) : -γ + Real.sqrt (γ ^ 2 - ω₀ ^ 2) < 0 := by
  have h1 : Real.sqrt (γ ^ 2 - ω₀ ^ 2) < Real.sqrt (γ ^ 2) :=
    Real.sqrt_lt_sqrt (by nlinarith) (by nlinarith)
  rw [Real.sqrt_sq (by linarith)] at h1
  linarith
attribute [veriphy_tested oracle_test 0 3] KaluzaKlein.DifferentialEquations.HarmonicOscillator.overdamped_negative
-- test: de-overdamped-negative-test.sage

/-- The slow rate `λ₊` exceeds `-γ`, the critical rate: critical damping returns faster. -/
theorem critical_faster (γ ω₀ : ℝ) (hω : 0 < ω₀) (hγ : ω₀ < γ) : -γ < -γ + Real.sqrt (γ ^ 2 - ω₀ ^ 2) := by
  have : 0 < Real.sqrt (γ ^ 2 - ω₀ ^ 2) := Real.sqrt_pos.mpr (by nlinarith)
  linarith
attribute [veriphy_tested oracle_test 0 3] KaluzaKlein.DifferentialEquations.HarmonicOscillator.critical_faster
-- test: de-critical-faster-test.sage

/-! ## exr-ho-underdamped-sage -/

/-- The underdamped solution with `q(0) = 1`, `q̇(0) = 0`: `e^{-γt}(cos ω_d t + (γ/ω_d) sin ω_d t)` has `q̇(0) = 0` … -/
theorem underdamped_ivp_velocity (γ ωd : ℝ) (hω : ωd ≠ 0) (q : ℝ → ℝ)
    (hq : q = fun s => Real.exp (-γ * s) * (Real.cos (ωd * s) + γ / ωd * Real.sin (ωd * s))) : deriv q 0 = 0 := by
  veriphy_certified
    ( subst hq
      have d1 :
        deriv (fun (s : ℝ) => (rexp (-γ * s) * (cos (ωd * s) + γ / ωd * sin (ωd * s)) : ℝ)) = fun (s : ℝ) =>
          (-γ * (γ * (Real.sin (s * ωd)) / ωd + (Real.cos (s * ωd))) * (Real.exp (-s * γ)) +
              ((γ * (Real.cos (s * ωd)) - (ωd * (Real.sin (s * ωd)))) * (Real.exp (-s * γ))) :
            ℝ) :=
        by
        funext s
        have hd :
          HasDerivAt (fun (s : ℝ) => (rexp (-γ * s) * (cos (ωd * s) + γ / ωd * sin (ωd * s)) : ℝ))
            ((-γ * (γ * (Real.sin (s * ωd)) / ωd + (Real.cos (s * ωd))) * (Real.exp (-s * γ)) +
                ((γ * (Real.cos (s * ωd)) - (ωd * (Real.sin (s * ωd)))) * (Real.exp (-s * γ))) :
              ℝ))
            (s) :=
          by
          convert
            ((((((hasDerivAt_id' (s : ℝ)).const_mul (ωd : ℝ)).sin).const_mul (γ / ωd : ℝ)).add
                  (((hasDerivAt_id' (s : ℝ)).const_mul (ωd : ℝ)).cos)).mul
              (((hasDerivAt_id' (s : ℝ)).const_mul (-γ : ℝ)).exp)) using
            1
          all_goals
            first
            | rfl
            |
              (funext y;
                simp only [Pi.add_apply, Pi.sub_apply, Pi.mul_apply, Pi.neg_apply, Pi.pow_apply, Pi.div_apply,
                  Pi.const_apply];
                ring_nf; done)
            | (funext y; simp only [Pi.add_apply, Pi.mul_apply]; ring_nf; done)
            | (simp only [Pi.add_apply]; (field_simp; ring1))
        exact hd.deriv
      simp only [d1]
      all_goals ((norm_num; done)))
  -- certificate: de-ode.sage

/-- … and `q(0) = 1`. -/
theorem underdamped_ivp_position (γ ωd : ℝ) (q : ℝ → ℝ)
    (hq : q = fun s => Real.exp (-γ * s) * (Real.cos (ωd * s) + γ / ωd * Real.sin (ωd * s))) : q 0 = 1 := by
  veriphy_certified
    ( subst hq
      (norm_num; done))
  -- certificate: de-ode.sage

/-- For `q̈ + q̇ + 5q = 0`: `γ = 1/2`, `ω_d = √19/2` (so `γ² + ω_d² = 5`) … -/
theorem sage_example_frequency : (1 / 2 : ℝ) ^ 2 + (Real.sqrt 19 / 2) ^ 2 = 5 := by
  veriphy_certified
    ( rw [div_pow, div_pow, Real.sq_sqrt (by norm_num)]
      norm_num)
  -- certificate: de-rewrite.sage

/-- … and `γ/ω_d = 1/√19`. -/
theorem sage_example_ratio : (1 / 2 : ℝ) / (Real.sqrt 19 / 2) = 1 / Real.sqrt 19 := by
  veriphy_certified
    ( have h19 : Real.sqrt 19 ≠ 0 := by positivity
      (field_simp; done))
  -- certificate: de-rewrite.sage

/-! ## exr-ho-overdamped -/

/-- `q = e^{-t} - e^{-4t}` solves `q̈ + 5q̇ + 4q = 0` … -/
theorem overdamped_example_solves (q : ℝ → ℝ) (hq : q = fun s => Real.exp (-s) - Real.exp (-4 * s)) (t : ℝ) :
    deriv (deriv q) t + 5 * deriv q t + 4 * q t = 0 := by
  veriphy_certified
    ( subst hq
      have d1 : deriv (fun s => rexp (-s) - rexp (-4 * s)) = fun s => -(Real.exp (-s)) + (4 * (Real.exp (-4 * s))) :=
        by
        funext s
        have hd :
          HasDerivAt (fun s => rexp (-s) - rexp (-4 * s)) ((-(Real.exp (-s)) + (4 * (Real.exp (-4 * s))) : ℝ)) (s) :=
          by
          convert
            ((((hasDerivAt_id' (s : ℝ)).const_mul (-1 : ℝ)).exp).add
              ((((hasDerivAt_id' (s : ℝ)).const_mul (-4 : ℝ)).exp).const_mul (-1 : ℝ))) using
            1
          all_goals
            first
            | rfl
            | (funext y; simp only [Pi.add_apply]; ring_nf; done)
            | ((ring_nf; done))
        exact hd.deriv
      have d2 :
        deriv (fun s => -(Real.exp (-s)) + (4 * (Real.exp (-4 * s)))) = fun s =>
          Real.exp (-s) - (16 * (Real.exp (-4 * s))) :=
        by
        funext s
        have hd :
          HasDerivAt (fun s => -(Real.exp (-s)) + (4 * (Real.exp (-4 * s))))
            ((Real.exp (-s) - (16 * (Real.exp (-4 * s))) : ℝ)) (s) :=
          by
          convert
            (((((hasDerivAt_id' (s : ℝ)).const_mul (-1 : ℝ)).exp).const_mul (-1 : ℝ)).add
              ((((hasDerivAt_id' (s : ℝ)).const_mul (-4 : ℝ)).exp).const_mul (4 : ℝ))) using
            1
          all_goals
            first
            | rfl
            | (funext y; simp only [Pi.add_apply]; ring_nf; done)
            | ((ring_nf; done))
        exact hd.deriv
      simp only [d1, d2]
      ring1)
  -- certificate: de-ode.sage

/-- … with `q(0) = 0` … -/
theorem overdamped_example_position (q : ℝ → ℝ) (hq : q = fun s => Real.exp (-s) - Real.exp (-4 * s)) :
    q 0 = 0 := by
  veriphy_certified
    ( subst hq
      (ring_nf; done))
  -- certificate: de-ode.sage

/-- … and `q̇(0) = 3`. -/
theorem overdamped_example_velocity (q : ℝ → ℝ) (hq : q = fun s => Real.exp (-s) - Real.exp (-4 * s)) :
    deriv q 0 = 3 := by
  veriphy_certified
    ( subst hq
      have d1 :
        deriv (fun (s : ℝ) => (rexp (-s) - rexp (-4 * s) : ℝ)) = fun (s : ℝ) =>
          (-(Real.exp (-s)) + (4 * (Real.exp (-4 * s))) : ℝ) :=
        by
        funext s
        have hd :
          HasDerivAt (fun (s : ℝ) => (rexp (-s) - rexp (-4 * s) : ℝ))
            ((-(Real.exp (-s)) + (4 * (Real.exp (-4 * s))) : ℝ)) (s) :=
          by
          convert
            ((((hasDerivAt_id' (s : ℝ)).const_mul (-1 : ℝ)).exp).add
              ((((hasDerivAt_id' (s : ℝ)).const_mul (-4 : ℝ)).exp).const_mul (-1 : ℝ))) using
            1
          all_goals
            first
            | rfl
            |
              (funext y;
                simp only [Pi.add_apply, Pi.sub_apply, Pi.mul_apply, Pi.neg_apply, Pi.pow_apply, Pi.div_apply,
                  Pi.const_apply];
                ring_nf; done)
            | (funext y; simp only [Pi.add_apply]; ring_nf; done)
            | ((ring_nf; done))
        exact hd.deriv
      simp only [d1]
      all_goals ((norm_num; done)))
  -- certificate: de-ode.sage

/-- `λ² + 5λ + 4 = (λ + 1)(λ + 4)`. -/
theorem overdamped_example_factor (l : ℝ) : l ^ 2 + 5 * l + 4 = (l + 1) * (l + 4) := by
  veriphy_certified (ring1)
  -- certificate: de-poly.sage

/-- The ratio `e^{-4t}/e^{-t} = e^{-3t}` of the two terms is below `1%` for `t > 1.6`. -/
theorem overdamped_example_ratio (t : ℝ) (ht : 1.6 < t) : Real.exp (-3 * t) < 1 / 100 := by
  have h1 : Real.exp (-3 * t) < Real.exp (-4.8) := Real.exp_lt_exp.mpr (by linarith)
  have h2 : Real.exp (-4.8) < 1 / 100 := by
    rw [Real.exp_neg, inv_lt_comm₀ (Real.exp_pos _) (by norm_num)]
    have h3 : Real.exp 4.8 = Real.exp 1 ^ 4 * Real.exp 0.8 := by
      rw [← Real.exp_nat_mul, ← Real.exp_add]; norm_num
    have h4 := Real.exp_one_gt_d9
    have h5 : (1 : ℝ) + 0.8 + 0.8 ^ 2 / 2 ≤ Real.exp 0.8 := by
      have := Real.sum_le_exp_of_nonneg (x := 0.8) (by norm_num) 3
      simpa [Finset.sum_range_succ, Nat.factorial] using this
    rw [h3]
    have : (2.7182818283 : ℝ) ^ 4 < Real.exp 1 ^ 4 := pow_lt_pow_left₀ h4 (by norm_num) (by norm_num)
    nlinarith
  linarith
