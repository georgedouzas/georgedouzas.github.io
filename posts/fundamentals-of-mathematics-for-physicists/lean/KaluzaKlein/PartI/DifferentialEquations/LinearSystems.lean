/-! ## exm-stab-centre -/

/-- Rotations keep the distance: `(cx + sy)² + (-sx + cy)² = x² + y²` when `c² + s² = 1`. -/
theorem centre_distance (c s x y : ℝ) (h : c ^ 2 + s ^ 2 = 1) :
    (c * x + s * y) ^ 2 + (-s * x + c * y) ^ 2 = x ^ 2 + y ^ 2 := by
  veriphy_certified (linear_combination (x ^ 2 + y ^ 2) * h)
  -- certificate: de-poly.sage

/-- The undamped pendulum's linearisation at `(0, 0)`: `∂_θ(-sin θ) = -1`, a centre `(0, 1; -1, 0)`. -/
theorem pendulum_linearisation : deriv (fun θ => -Real.sin θ) 0 = -1 := by
  veriphy_certified
    ( have hd : HasDerivAt (fun θ => -sin θ) ((-1 : ℝ)) (0) :=
        by
        convert (((hasDerivAt_id' (0 : ℝ)).sin).const_mul (-1 : ℝ)) using 1
        all_goals ((norm_num; done))
      exact hd.deriv.trans (by rfl))
  -- certificate: de-derivative.sage

/-- With damping, `(0, 1; -1, -γ)` has trace `-γ` … -/
theorem damped_trace (γ : ℝ) : Matrix.trace !![(0 : ℝ), 1; -1, -γ] = -γ := by
  veriphy_certified (norm_num [Matrix.trace_fin_two_of] <;> ring1)
  -- certificate: la-matrix.sage

/-- … and determinant `1`: a spiral sink for small `γ > 0`. -/
theorem damped_det (γ : ℝ) : Matrix.det !![(0 : ℝ), 1; -1, -γ] = 1 := by
  veriphy_certified (norm_num [Matrix.det_fin_two_of] <;> ring1)
  -- certificate: la-matrix.sage

/-! ## exr-stab-classify -/

/-- `A₁`: trace `-6` … -/
theorem A1_trace : Matrix.trace !![(-3 : ℝ), 1; 1, -3] = -6 := by
  veriphy_certified (norm_num [Matrix.trace_fin_two_of])
  -- certificate: la-matrix.sage

/-- … determinant `8` … -/
theorem A1_det : Matrix.det !![(-3 : ℝ), 1; 1, -3] = 8 := by
  veriphy_certified (norm_num [Matrix.det_fin_two_of])
  -- certificate: la-matrix.sage

/-- … and eigenvalues `-2, -4`: `det(λ - A₁) = (λ + 2)(λ + 4)`, a stable node. -/
theorem A1_charpoly (l : ℝ) : Matrix.det !![l + 3, -1; -1, l + 3] = (l + 2) * (l + 4) := by
  veriphy_certified (norm_num [Matrix.det_fin_two_of] <;> ring1)
  -- certificate: la-matrix.sage

/-- `A₂`: determinant `-6 < 0` … -/
theorem A2_det : Matrix.det !![(1 : ℝ), 2; 3, 0] = -6 := by
  veriphy_certified (norm_num [Matrix.det_fin_two_of])
