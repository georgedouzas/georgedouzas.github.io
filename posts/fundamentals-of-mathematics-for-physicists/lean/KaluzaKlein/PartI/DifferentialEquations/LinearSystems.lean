  -- certificate: de-rewrite.sage

/-- `A(ω₀) = 1/(2γω₀) = 2`, slightly below the peak. -/
theorem numbers_natural : (1 : ℝ) / (2 * (1 / 4) * 1) = 2 := by
  veriphy_certified (norm_num)
  -- certificate: de-rewrite.sage

/-- The phase lag at `ω = 1/2`: `tan δ = 2γω/(ω₀² - ω²) = 1/3`. -/
theorem numbers_lag_half : 2 * (1 / 4 : ℝ) * (1 / 2) / (1 - (1 / 2) ^ 2) = 1 / 3 := by
  veriphy_certified (norm_num)
  -- certificate: de-rewrite.sage

/-- At `ω = 2`: `tan δ = -1/3`, so `δ = π - arctan(1/3)` (in `(π/2, π)`). -/
theorem numbers_lag_two : 2 * (1 / 4 : ℝ) * 2 / (1 - 2 ^ 2) = -1 / 3 := by
  veriphy_certified (norm_num)
  -- certificate: de-rewrite.sage

/-- … and `tan(π - arctan(1/3)) = -1/3`. -/
theorem numbers_lag_two_angle : Real.tan (Real.pi - Real.arctan (1 / 3)) = -1 / 3 := by
  veriphy_certified
    ( rw [Real.tan_pi_sub, Real.tan_arctan]
      norm_num)
  -- certificate: de-rewrite.sage

/-! ## exr-res-width -/

/-- Near `ω₀`: `ω₀² - ω² = (ω₀ - ω)(ω₀ + ω)` (≈ `2ω₀(ω₀ - ω)`). -/
theorem width_factor (ω₀ ω : ℝ) : ω₀ ^ 2 - ω ^ 2 = (ω₀ - ω) * (ω₀ + ω) := by
  veriphy_certified (ring1)
  -- certificate: de-poly.sage

/-- The Lorentzian `F/(2ω₀√((ω₀ - ω)² + γ²))` equals its maximum divided by `√2` at `ω = ω₀ ± γ`:
`(ω₀ - ω)² + γ² = 2γ²` there. -/
theorem width_half_power (ω₀ γ : ℝ) : (ω₀ - (ω₀ + γ)) ^ 2 + γ ^ 2 = 2 * γ ^ 2 := by
  veriphy_certified (ring1)
  -- certificate: de-poly.sage

/-- … and at `ω = ω₀ - γ`. -/
theorem width_half_power_minus (ω₀ γ : ℝ) : (ω₀ - (ω₀ - γ)) ^ 2 + γ ^ 2 = 2 * γ ^ 2 := by
  veriphy_certified (ring1)
  -- certificate: de-poly.sage

/-- The approximation: with `ω₀ + ω = 2ω₀ + ε` and `2γω = 2γω₀ + η`, the exact `Δ` differs from the Lorentzian
form `4ω₀²((ω₀ - ω)² + γ²)` by terms of higher order. -/
theorem width_expansion (ω₀ ω γ : ℝ) :
    (ω₀ ^ 2 - ω ^ 2) ^ 2 + 4 * γ ^ 2 * ω ^ 2 - 4 * ω₀ ^ 2 * ((ω₀ - ω) ^ 2 + γ ^ 2) =
      (ω₀ - ω) ^ 2 * ((ω₀ + ω) ^ 2 - 4 * ω₀ ^ 2) + 4 * γ ^ 2 * (ω ^ 2 - ω₀ ^ 2) := by
  veriphy_certified (ring1)
  -- certificate: de-poly.sage

/-! ## exr-res-beats -/

/-- Off resonance, `q = F/(ω₀² - ω²)(cos ωt - cos ω₀t)` solves `q̈ + ω₀²q = F cos ωt` … -/
theorem beats_solves (F ω₀ ω : ℝ) (hd : ω₀ ^ 2 - ω ^ 2 ≠ 0) (q : ℝ → ℝ)
    (hq : q = fun s => F / (ω₀ ^ 2 - ω ^ 2) * (Real.cos (ω * s) - Real.cos (ω₀ * s))) (t : ℝ) :
    deriv (deriv q) t + ω₀ ^ 2 * q t = F * Real.cos (ω * t) := by
  veriphy_certified
    ( subst hq
      have d1 :
        deriv (fun (s : ℝ) => (F / (ω₀ ^ 2 - ω ^ 2) * (cos (ω * s) - cos (ω₀ * s)) : ℝ)) = fun (s : ℝ) =>
          ((ω₀ * (Real.sin (s * ω₀)) - (ω * (Real.sin (s * ω)))) * F / (ω₀ ^ 2 - (ω ^ 2)) : ℝ) :=
        by
        funext s
        have hd :
          HasDerivAt (fun (s : ℝ) => (F / (ω₀ ^ 2 - ω ^ 2) * (cos (ω * s) - cos (ω₀ * s)) : ℝ))
            (((ω₀ * (Real.sin (s * ω₀)) - (ω * (Real.sin (s * ω)))) * F / (ω₀ ^ 2 - (ω ^ 2)) : ℝ)) (s) :=
          by
          refine
            (((((((hasDerivAt_id' (s : ℝ)).const_mul (ω₀ : ℝ)).cos).add
                          ((((hasDerivAt_id' (s : ℝ)).const_mul (ω : ℝ)).cos).const_mul (-1 : ℝ))).const_mul
                      (-F / (ω₀ ^ 2 - (ω ^ 2)) : ℝ))).congr_of_eventuallyEq
                  (Filter.Eventually.of_forall fun y => ?_)).congr_deriv
              ?_
          · beta_reduce; (simp; ring_nf; done)
          · (ring_nf; done)
        exact hd.deriv
      have d2 :
        deriv (fun (s : ℝ) => ((ω₀ * (Real.sin (s * ω₀)) - (ω * (Real.sin (s * ω)))) * F / (ω₀ ^ 2 - (ω ^ 2)) : ℝ)) =
          fun (s : ℝ) =>
          (((ω₀ ^ 2) * (Real.cos (s * ω₀)) - ((ω ^ 2) * (Real.cos (s * ω)))) * F / (ω₀ ^ 2 - (ω ^ 2)) : ℝ) :=
        by
        funext s
        have hd :
          HasDerivAt
            (fun (s : ℝ) => ((ω₀ * (Real.sin (s * ω₀)) - (ω * (Real.sin (s * ω)))) * F / (ω₀ ^ 2 - (ω ^ 2)) : ℝ))
            ((((ω₀ ^ 2) * (Real.cos (s * ω₀)) - ((ω ^ 2) * (Real.cos (s * ω)))) * F / (ω₀ ^ 2 - (ω ^ 2)) : ℝ)) (s) :=
          by
          refine
            ((((((((hasDerivAt_id' (s : ℝ)).const_mul (ω₀ : ℝ)).sin).const_mul (ω₀ : ℝ)).add
                          ((((hasDerivAt_id' (s : ℝ)).const_mul (ω : ℝ)).sin).const_mul (-ω : ℝ))).const_mul
                      (F / (ω₀ ^ 2 - (ω ^ 2)) : ℝ))).congr_of_eventuallyEq
                  (Filter.Eventually.of_forall fun y => ?_)).congr_deriv
              ?_
          · beta_reduce; (simp; ring_nf; done)
          · (ring_nf; done)
        exact hd.deriv
      simp only [d1, d2]
      all_goals ((field_simp; ring1)))
  -- certificate: de-ode.sage

/-- … with `q(0) = 0` … -/
theorem beats_position (F ω₀ ω : ℝ) (q : ℝ → ℝ)
    (hq : q = fun s => F / (ω₀ ^ 2 - ω ^ 2) * (Real.cos (ω * s) - Real.cos (ω₀ * s))) : q 0 = 0 := by
  veriphy_certified
    ( subst hq
      (ring_nf; done))
  -- certificate: de-ode.sage

/-- … and `q̇(0) = 0`. -/
theorem beats_velocity (F ω₀ ω : ℝ) (q : ℝ → ℝ)
    (hq : q = fun s => F / (ω₀ ^ 2 - ω ^ 2) * (Real.cos (ω * s) - Real.cos (ω₀ * s))) : deriv q 0 = 0 := by
  veriphy_certified
    ( subst hq
      have d1 :
        deriv (fun (s : ℝ) => (F / (ω₀ ^ 2 - ω ^ 2) * (cos (ω * s) - cos (ω₀ * s)) : ℝ)) = fun (s : ℝ) =>
          ((ω₀ * (Real.sin (s * ω₀)) - (ω * (Real.sin (s * ω)))) * F / (ω₀ ^ 2 - (ω ^ 2)) : ℝ) :=
        by
        funext s
        have hd :
          HasDerivAt (fun (s : ℝ) => (F / (ω₀ ^ 2 - ω ^ 2) * (cos (ω * s) - cos (ω₀ * s)) : ℝ))
            (((ω₀ * (Real.sin (s * ω₀)) - (ω * (Real.sin (s * ω)))) * F / (ω₀ ^ 2 - (ω ^ 2)) : ℝ)) (s) :=
          by
          refine
            (((((((hasDerivAt_id' (s : ℝ)).const_mul (ω₀ : ℝ)).cos).add
                          ((((hasDerivAt_id' (s : ℝ)).const_mul (ω : ℝ)).cos).const_mul (-1 : ℝ))).const_mul
                      (-F / (ω₀ ^ 2 - (ω ^ 2)) : ℝ))).congr_of_eventuallyEq
                  (Filter.Eventually.of_forall fun y => ?_)).congr_deriv
              ?_
          · beta_reduce; (simp; ring_nf; done)
          · (ring_nf; done)
        exact hd.deriv
      simp only [d1]
      all_goals ((norm_num; done)))
  -- certificate: de-ode.sage

/-- The beats form: `cos ωt - cos ω₀t = 2 sin((ω₀ - ω)t/2) sin((ω₀ + ω)t/2)`. -/
theorem beats_product (ω₀ ω t : ℝ) :
    Real.cos (ω * t) - Real.cos (ω₀ * t) = 2 * Real.sin ((ω₀ - ω) * t / 2) * Real.sin ((ω₀ + ω) * t / 2) := by
  veriphy_certified
    ( rw [Real.cos_sub_cos, show (ω * t - ω₀ * t) / 2 = -((ω₀ - ω) * t / 2) by ring, Real.sin_neg,
        show (ω * t + ω₀ * t) / 2 = (ω₀ + ω) * t / 2 by ring]
      ring)
  -- certificate: de-rewrite.sage

/-- The resonant limit `ω → ω₀` is `(F/(2ω₀)) t sin ω₀t`. -/
theorem beats_limit (F ω₀ t : ℝ) (hω : ω₀ ≠ 0) :
    Tendsto (fun ω => F / (ω₀ ^ 2 - ω ^ 2) * (Real.cos (ω * t) - Real.cos (ω₀ * t))) (𝓝[≠] ω₀)
      (𝓝 (F / (2 * ω₀) * t * Real.sin (ω₀ * t))) := by
  -- the difference quotient of `ω ↦ cos ωt` at `ω₀`, times `-F/(ω₀ + ω)`
  have hd : HasDerivAt (fun ω => Real.cos (ω * t)) (-Real.sin (ω₀ * t) * t) ω₀ := by
    simpa using ((hasDerivAt_id ω₀).mul_const t).cos
  have hslope := hd.tendsto_slope
  have hsum : Tendsto (fun ω => ω₀ + ω) (𝓝 ω₀) (𝓝 (ω₀ + ω₀)) := tendsto_const_nhds.add tendsto_id
  have h2ω : ω₀ + ω₀ ≠ 0 := by intro h; apply hω; linarith
  have h2 : Tendsto (fun ω => -F / (ω₀ + ω)) (𝓝[≠] ω₀) (𝓝 (-F / (ω₀ + ω₀))) :=
    (tendsto_const_nhds.div hsum h2ω).mono_left nhdsWithin_le_nhds
  have hne : ∀ᶠ ω in 𝓝[≠] ω₀, ω₀ + ω ≠ 0 :=
    (hsum.eventually_ne h2ω).filter_mono nhdsWithin_le_nhds
  have key : (fun ω => -F / (ω₀ + ω) * slope (fun ω => Real.cos (ω * t)) ω₀ ω) =ᶠ[𝓝[≠] ω₀]
      fun ω => F / (ω₀ ^ 2 - ω ^ 2) * (Real.cos (ω * t) - Real.cos (ω₀ * t)) := by
    filter_upwards [self_mem_nhdsWithin, hne] with ω hω1 hω2
    rw [slope_def_field]
    have h1 : ω - ω₀ ≠ 0 := sub_ne_zero.mpr hω1
    have h3 : ω₀ ^ 2 - ω ^ 2 ≠ 0 := by
      rw [show ω₀ ^ 2 - ω ^ 2 = -((ω - ω₀) * (ω₀ + ω)) by ring]
      exact neg_ne_zero.mpr (mul_ne_zero h1 hω2)
    field_simp
    ring
  have lim := (h2.mul hslope).congr' key
  convert lim using 2
  field_simp
  ring
