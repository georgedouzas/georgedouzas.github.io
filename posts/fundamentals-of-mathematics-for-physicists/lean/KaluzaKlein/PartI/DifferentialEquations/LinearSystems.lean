    have h := (((Real.hasDerivAt_sin s).smul_const A).const_add (1 : Matrix (Fin n) (Fin n) ℝ)).add
      (((Real.hasDerivAt_cos s).const_sub 1).smul_const (A * A))
    refine h.congr_deriv ?_
    rw [mul_add, mul_add, mul_one, mul_smul_comm, mul_smul_comm, hA]
    simp only [neg_neg]
    module
  · simp
attribute [veriphy_tested oracle_test 0 3] KaluzaKlein.DifferentialEquations.LinearSystemComputations.exp_of_cube_neg
-- test: de-exp-cube-test.sage

/-- The closed form `(1, sin t, 1 - cos t; 0, cos t, sin t; 0, -sin t, cos t)` satisfies `Ė = AE`. -/
theorem cube_derivative (t : ℝ) :
    !![(0 : ℝ), 1, 0; 0, 0, 1; 0, -1, 0] *
        !![1, Real.sin t, 1 - Real.cos t; 0, Real.cos t, Real.sin t; 0, -Real.sin t, Real.cos t] =
      !![0, deriv (fun s => Real.sin s) t, deriv (fun s => 1 - Real.cos s) t;
        0, deriv (fun s => Real.cos s) t, deriv (fun s => Real.sin s) t;
        0, deriv (fun s => -Real.sin s) t, deriv (fun s => Real.cos s) t] := by
  veriphy_certified
    ( have h0 : HasDerivAt (fun s => sin s) ((Real.cos t : ℝ)) (t) :=
        by
        convert ((hasDerivAt_id' (t : ℝ)).sin) using 1
        all_goals
          first
          | rfl
          | (funext y; ring_nf; done)
          |
            (first
              | ring1
              | (ring_nf; done)
              | (field_simp; done)
              | (field_simp; ring1)
              | (field_simp; ring_nf; done)
              | (norm_num; done))
      rw [h0.deriv]
      have h1 : HasDerivAt (fun s => 1 - cos s) ((Real.sin t : ℝ)) (t) :=
        by
        convert ((((hasDerivAt_id' (t : ℝ)).cos).const_mul (-1 : ℝ)).add (hasDerivAt_const (t : ℝ) (1 : ℝ))) using 1
        all_goals
          first
          | rfl
          | (funext y; simp only [Pi.add_apply]; ring_nf; done)
          |
            (first
              | ring1
              | (ring_nf; done)
              | (field_simp; done)
              | (field_simp; ring1)
              | (field_simp; ring_nf; done)
              | (norm_num; done))
      rw [h1.deriv]
      have h2 : HasDerivAt (fun s => cos s) ((-(Real.sin t) : ℝ)) (t) :=
        by
        convert ((hasDerivAt_id' (t : ℝ)).cos) using 1
        all_goals
          first
          | rfl
          | (funext y; ring_nf; done)
          |
            (first
              | ring1
              | (ring_nf; done)
              | (field_simp; done)
              | (field_simp; ring1)
              | (field_simp; ring_nf; done)
              | (norm_num; done))
      rw [h2.deriv]
      have h3 : HasDerivAt (fun s => -sin s) ((-(Real.cos t) : ℝ)) (t) :=
        by
        convert (((hasDerivAt_id' (t : ℝ)).sin).const_mul (-1 : ℝ)) using 1
        all_goals
          first
          | rfl
          | (funext y; ring_nf; done)
          |
            (first
              | ring1
              | (ring_nf; done)
              | (field_simp; done)
              | (field_simp; ring1)
              | (field_simp; ring_nf; done)
              | (norm_num; done))
      rw [h3.deriv]
      first
      | ring1
      | (field_simp; ring1)
      | (field_simp; ring_nf; done)
      | (ring_nf; done)
      | (simp only [Real.exp_neg, Real.exp_add, Real.exp_sub]; field_simp; ring_nf; done)
      | (norm_num; done)
      |
        (ext i j;
          fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply, Fin.sum_univ_succ, Matrix.vecMul, dotProduct] <;>
            ring_nf))
  -- certificate: de-partials.sage

/-- The first row gives the general solution `y = y₀ + y₀' sin t + y₀''(1 - cos t)` … -/
theorem cube_first_row (t a b c : ℝ) :
    !![(1 : ℝ), Real.sin t, 1 - Real.cos t] * !![a; b; c] = !![a + b * Real.sin t + c * (1 - Real.cos t)] := by
  veriphy_certified
    ( ext i j
      fin_cases i <;> fin_cases j <;> norm_num [Matrix.mul_apply, Fin.sum_univ_succ, Matrix.transpose_apply] <;> ring1)
  -- certificate: la-matrix.sage

/-- … which solves `y''' + y' = 0`. -/
theorem cube_general_solves (a b c : ℝ) (y : ℝ → ℝ) (hy : y = fun s => a + b * Real.sin s + c * (1 - Real.cos s))
    (t : ℝ) : deriv (deriv (deriv y)) t + deriv y t = 0 := by
  veriphy_certified
    ( subst hy
      have d1 :
        deriv (fun (s : ℝ) => (a + b * sin s + c * (1 - cos s) : ℝ)) = fun (s : ℝ) =>
          (b * (Real.cos s) + (c * (Real.sin s)) : ℝ) :=
        by
        funext s
        have hd :
          HasDerivAt (fun (s : ℝ) => (a + b * sin s + c * (1 - cos s) : ℝ))
            ((b * (Real.cos s) + (c * (Real.sin s)) : ℝ)) (s) :=
          by
          refine
            ((((((((hasDerivAt_id' (s : ℝ)).cos).add (hasDerivAt_const (s : ℝ) (-1 : ℝ))).const_mul (-c : ℝ)).add
                          (((hasDerivAt_id' (s : ℝ)).sin).const_mul (b : ℝ))).add
                      (hasDerivAt_const (s : ℝ) (a : ℝ)))).congr_of_eventuallyEq
                  (Filter.Eventually.of_forall fun y => ?_)).congr_deriv
              ?_
          · beta_reduce; (simp; ring_nf; done)
          · ring1
        exact hd.deriv
      have d2 :
        deriv (fun (s : ℝ) => (b * (Real.cos s) + (c * (Real.sin s)) : ℝ)) = fun (s : ℝ) =>
          (c * (Real.cos s) - (b * (Real.sin s)) : ℝ) :=
        by
        funext s
        have hd :
          HasDerivAt (fun (s : ℝ) => (b * (Real.cos s) + (c * (Real.sin s)) : ℝ))
            ((c * (Real.cos s) - (b * (Real.sin s)) : ℝ)) (s) :=
          by
          refine
            ((((((hasDerivAt_id' (s : ℝ)).cos).const_mul (b : ℝ)).add
                      (((hasDerivAt_id' (s : ℝ)).sin).const_mul (c : ℝ)))).congr_of_eventuallyEq
                  (Filter.Eventually.of_forall fun y => ?_)).congr_deriv
              ?_
          · beta_reduce; rfl
          · ring1
        exact hd.deriv
      have d3 :
        deriv (fun (s : ℝ) => (c * (Real.cos s) - (b * (Real.sin s)) : ℝ)) = fun (s : ℝ) =>
          (-b * (Real.cos s) - (c * (Real.sin s)) : ℝ) :=
        by
        funext s
        have hd :
          HasDerivAt (fun (s : ℝ) => (c * (Real.cos s) - (b * (Real.sin s)) : ℝ))
            ((-b * (Real.cos s) - (c * (Real.sin s)) : ℝ)) (s) :=
          by
          refine
            ((((((hasDerivAt_id' (s : ℝ)).cos).const_mul (c : ℝ)).add
                      (((hasDerivAt_id' (s : ℝ)).sin).const_mul (-b : ℝ)))).congr_of_eventuallyEq
                  (Filter.Eventually.of_forall fun y => ?_)).congr_deriv
              ?_
          · beta_reduce; (simp; ring_nf; done)
          · ring1
        exact hd.deriv
      simp only [d1, d2, d3]
      all_goals (ring1))
  -- certificate: de-ode.sage

/-! ## exr-mef-rotation-series -/

/-- `J^{2k} = (-1)^k` and `J^{2k+1} = (-1)^k J`. -/
theorem J_powers (k : ℕ) :
    !![(0 : ℝ), 1; -1, 0] ^ (2 * k) = (-1 : ℝ) ^ k • (1 : Matrix (Fin 2) (Fin 2) ℝ) ∧
      !![(0 : ℝ), 1; -1, 0] ^ (2 * k + 1) = (-1 : ℝ) ^ k • !![(0 : ℝ), 1; -1, 0] := by
  have hJ : !![(0 : ℝ), 1; -1, 0] ^ 2 = (-1 : ℝ) • (1 : Matrix (Fin 2) (Fin 2) ℝ) := by
    rw [sq]; ext i j; fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply, Fin.sum_univ_two]
  have h2 : !![(0 : ℝ), 1; -1, 0] ^ (2 * k) = (-1 : ℝ) ^ k • (1 : Matrix (Fin 2) (Fin 2) ℝ) := by
    rw [pow_mul, hJ, smul_pow, one_pow]
  exact ⟨h2, by rw [pow_succ, h2, smul_mul_assoc, one_mul]⟩
attribute [veriphy_tested oracle_test 0 3] KaluzaKlein.DifferentialEquations.LinearSystemComputations.J_powers
