namespace KaluzaKlein.DifferentialEquations.Stability

/-! ## def-stability -/

/-- For real eigenvalues, both are negative exactly when their sum (the trace) is negative and their product (the
determinant) positive. -/
theorem stable_real_iff (l₁ l₂ : ℝ) : (l₁ < 0 ∧ l₂ < 0) ↔ (l₁ + l₂ < 0 ∧ 0 < l₁ * l₂) := by
  constructor
  · rintro ⟨h₁, h₂⟩; exact ⟨by linarith, mul_pos_of_neg_of_neg h₁ h₂⟩
  · rintro ⟨hs, hp⟩
    rcases lt_or_ge l₁ 0 with h₁ | h₁
    · exact ⟨h₁, by nlinarith⟩
    · rcases eq_or_lt_of_le h₁ with h | h
      · subst h; simp at hp
      · nlinarith
attribute [veriphy_tested oracle_test 0 3] KaluzaKlein.DifferentialEquations.Stability.stable_real_iff
-- test: de-stable-real-test.sage

/-- For complex eigenvalues `α ± iβ` (`β ≠ 0`): trace `2α`, determinant `α² + β² > 0`, so the real parts are
negative exactly when `tr < 0` and `det > 0`. -/
theorem stable_complex_iff (α β : ℝ) (hβ : β ≠ 0) : α < 0 ↔ (2 * α < 0 ∧ 0 < α ^ 2 + β ^ 2) := by
  have : 0 < β ^ 2 := by positivity
  constructor
  · intro h; exact ⟨by linarith, by positivity⟩
  · rintro ⟨h, _⟩; linarith
attribute [veriphy_tested oracle_test 0 3] KaluzaKlein.DifferentialEquations.Stability.stable_complex_iff
-- test: de-stable-complex-test.sage

/-- A positive eigenvalue makes the origin unstable: along an eigenvector the solution `e^{λt}c` (`c > 0`) escapes. -/
theorem unstable_escape (l c : ℝ) (hl : 0 < l) (hc : 0 < c) : Tendsto (fun t => Real.exp (l * t) * c) atTop atTop :=
  (Real.tendsto_exp_atTop.comp (tendsto_id.const_mul_atTop hl)).atTop_mul_const hc
attribute [veriphy_tested oracle_test 0 3] KaluzaKlein.DifferentialEquations.Stability.unstable_escape
-- test: de-unstable-escape-test.sage

/-! ## exm-stab-sink -/

/-- `tr A = -2` … -/
theorem sink_trace : Matrix.trace !![(0 : ℝ), 1; -2, -2] = -2 := by
  veriphy_certified (norm_num [Matrix.trace_fin_two_of])
  -- certificate: la-matrix.sage

/-- … and `det A = 2`. -/
theorem sink_det : Matrix.det !![(0 : ℝ), 1; -2, -2] = 2 := by
  veriphy_certified (norm_num [Matrix.det_fin_two_of])
  -- certificate: la-matrix.sage

/-- The entries of `e^{tA}` are bounded by `2e^{-t}`, e.g. `|e^{-t}(cos t + sin t)| ≤ 2e^{-t}`: exponential decay. -/
theorem sink_decay (t : ℝ) : |Real.exp (-t) * (Real.cos t + Real.sin t)| ≤ 2 * Real.exp (-t) := by
  rw [abs_mul, abs_of_pos (Real.exp_pos _)]
  have : |Real.cos t + Real.sin t| ≤ 2 :=
    (abs_add_le _ _).trans (by linarith [Real.abs_cos_le_one t, Real.abs_sin_le_one t])
  nlinarith [Real.exp_pos (-t)]
attribute [veriphy_tested oracle_test 0 3] KaluzaKlein.DifferentialEquations.Stability.sink_decay
-- test: de-sink-decay-test.sage

/-! ## exm-stab-saddle -/

/-- `det S = -1 < 0`. -/
theorem saddle_det : Matrix.det !![(1 : ℝ), 0; 0, -1] = -1 := by
  veriphy_certified (norm_num [Matrix.det_fin_two_of])
  -- certificate: la-matrix.sage

/-- Solutions on the `x²` axis converge to the origin: `c e^{-t} → 0`. -/
theorem saddle_stable_axis (c : ℝ) : Tendsto (fun t => c * Real.exp (-t)) atTop (𝓝 0) := by
  simpa using Real.tendsto_exp_neg_atTop_nhds_zero.const_mul c
