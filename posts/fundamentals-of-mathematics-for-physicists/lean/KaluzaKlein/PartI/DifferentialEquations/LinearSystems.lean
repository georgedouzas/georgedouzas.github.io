set_option backward.isDefEq.respectTransparency false in
/-- If `A³ = -A` then `e^{tA} = 1 + sin t A + (1 - cos t) A²`. -/
theorem exp_of_cube_neg {n : ℕ} (A : Matrix (Fin n) (Fin n) ℝ) (hA : A * (A * A) = -A) (t : ℝ) :
