/-! ## exr-mef-general-spiral -/

/-- Cayley-Hamilton for a traceless `2 × 2` matrix: `B² = (a² + bc)·1 = -det B · 1`; with eigenvalues `±iβ`,
`det B = β²` and `B² = -β²`. -/
theorem cayley_hamilton_traceless (a b c : ℝ) :
    !![a, b; c, -a] * !![a, b; c, -a] = !![a ^ 2 + b * c, 0; 0, a ^ 2 + b * c] := by
  veriphy_certified
    ( ext i j
      fin_cases i <;> fin_cases j <;> norm_num [Matrix.mul_apply, Fin.sum_univ_succ, Matrix.transpose_apply] <;> ring1)
  -- certificate: la-matrix.sage

