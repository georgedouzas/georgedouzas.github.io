/-- `ω ≠ 1`, so the sum of the sixth roots vanishes. -/
theorem ω_ne_one : ω ≠ 1 := by
  rw [ω_eq]
  intro h
  have hI : I ^ 2 = -1 := I_sq
  have h3 := sqrt_three_sq
  veriphy_certified
    ( have h1 : (1 : ℂ) = 0 := by
        linear_combination
          (-1 / 2 * (↑√3) * I + 1 / 2 * I ^ 2) * h + (-1 / 4 * (↑√3) * I + 1) * hI + (1 / 4 * I ^ 2) * h3
      exact one_ne_zero h1)
  -- certificate: ca-num-infeasible.sage

/-! ## exm-roots-product -/

/-- Vieta: the product of the roots of the monic `z⁶ - 1` is `(-1)⁶ · (-1) = -1`. -/
theorem vieta_product : ((-1 : ℂ) ^ 6) * (-1) = -1 := by
  veriphy_certified (ring1)
  -- certificate: ca-num-ring.sage

/-- Directly: `∏ ωᵏ = ω^{0 + 1 + ⋯ + 5} = ω¹⁵ = ω³ = e^{iπ} = -1`. -/
theorem prod_exponents : ∑ k ∈ range 6, k = 15 ∧ ω ^ 15 = ω ^ 3 ∧ ω ^ 3 = Complex.exp (π * I) ∧
    Complex.exp (π * I) = -1 := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · simp only [Finset.sum_range_succ, Finset.sum_range_zero]
  · rw [show 15 = 6 * 2 + 3 by norm_num, pow_add, pow_mul, ω_pow_six, one_pow, one_mul]
  · rw [ω, ← Complex.exp_nat_mul]; congr 1; push_cast; ring
  · veriphy_certified
      ( simp only [Complex.arg_one, Complex.arg_I, Complex.arg_neg_one, Complex.arg_neg_I, Complex.log_neg_one,
          Complex.log_I, Complex.log_neg_I, Complex.log_one, Complex.exp_pi_mul_I, Complex.exp_two_pi_mul_I,
          Complex.exp_pi_div_two_mul_I, Complex.exp_zero, Complex.exp_add, Real.cos_pi, Real.sin_pi, neg_neg]
        all_goals ring)
    -- certificate: ca-num-rewrite.sage

/-! ## exm-roots-factorisation -/

/-- Over `ℚ`: `z⁶ - 1 = (z - 1)(z + 1)(z² + z + 1)(z² - z + 1)`. -/
theorem factor_rat : (X ^ 6 - 1 : ℚ[X]) = (X - 1) * (X + 1) * (X ^ 2 + X + 1) * (X ^ 2 - X + 1) := by
  veriphy_certified (ring1)
  -- certificate: ca-num-ring.sage

/-- A rational quadratic `X² + bX + c` with negative discriminant `b² < 4c` has no rational root and is irreducible over
`ℚ`; this covers the factors `X² ± X + 1` (discriminant `-3`). -/
theorem quadratic_irreducible (b c : ℚ) (h : b ^ 2 < 4 * c) : Irreducible (X ^ 2 + C b * X + C c : ℚ[X]) := by
  apply Polynomial.irreducible_of_degree_le_three_of_not_isRoot
  · rw [show (X ^ 2 + C b * X + C c : ℚ[X]).natDegree = 2 by compute_degree!]; decide
  · intro x hx
    simp at hx
    nlinarith [sq_nonneg (2 * x + b)]
example : veriphy_instance% KaluzaKlein.ComplexAnalysis.NumbersWorked.quadratic_irreducible (0) (1) ((by norm_num)) := by
  apply Polynomial.irreducible_of_degree_le_three_of_not_isRoot
  · rw [show (Polynomial.X ^ 2 + Polynomial.C _ * Polynomial.X + Polynomial.C _ : Polynomial ℚ).natDegree = 2 by compute_degree!]
    decide
  · intro x hx
    simp at hx
    nlinarith [sq_nonneg (2 * x + 0)]

