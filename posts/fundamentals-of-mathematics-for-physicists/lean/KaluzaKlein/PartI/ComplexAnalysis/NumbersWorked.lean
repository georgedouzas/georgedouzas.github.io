/-- De Moivre's formula for `n = 3`, from `cos 3θ = 4cos³θ - 3cos θ`, `sin 3θ = 3 sin θ - 4 sin³θ`, `sin² + cos² = 1`
and `i² = -1`. -/
theorem de_moivre_three (θ : ℝ) :
    (Complex.cos θ + Complex.sin θ * I) ^ 3 = Complex.cos (3 * θ) + Complex.sin (3 * θ) * I := by
  have hI : I ^ 2 = -1 := I_sq
  have hc : Complex.cos (3 * θ) = 4 * Complex.cos θ ^ 3 - 3 * Complex.cos θ := Complex.cos_three_mul _
  have hs : Complex.sin (3 * θ) = 3 * Complex.sin θ - 4 * Complex.sin θ ^ 3 := Complex.sin_three_mul _
  have hp : Complex.sin θ ^ 2 + Complex.cos θ ^ 2 = 1 := Complex.sin_sq_add_cos_sq _
  generalize Complex.cos (3 * (θ : ℂ)) = c3 at hc ⊢
  generalize Complex.sin (3 * (θ : ℂ)) = s3 at hs ⊢
  generalize Complex.cos (θ : ℂ) = c at hc hp ⊢
  generalize Complex.sin (θ : ℂ) = s at hs hp ⊢
  rw [← sub_eq_zero]
  veriphy_certified
    (linear_combination
        (3 * c * s ^ 2 + s ^ 3 * I) * hI +
              (2 * c ^ 2 * s ^ 2 - c ^ 2 - 2 * c * s ^ 3 * I + 3 / 2 * c * s * I - 1 / 2 * c * I * s3 - 3 / 2 * s ^ 2 -
                  1 / 2 * s * s3) *
                hc +
            (-2 * c ^ 3 * s + 2 * c ^ 2 * s ^ 2 * I - 3 / 2 * c ^ 2 * I + 3 / 2 * c * s + 1 / 2 * c * I * c3 -
                  s ^ 2 * I +
                1 / 2 * s * c3) *
              hs +
          (8 * c ^ 3 * s ^ 2 - 4 * c ^ 3 - 8 * c ^ 2 * s ^ 3 * I + 6 * c ^ 2 * s * I - 2 * c ^ 2 * I * s3 -
                      6 * c * s ^ 2 +
                    4 * s ^ 3 * I -
                  2 * s ^ 2 * c3 +
                I * s3 +
              c3) *
            hp)
  -- certificate: ideal_membership.sage

/-- `|2 + i| = √5` and `|z|² = z z̄`: `(2 + i)(2 - i) = 5 = |2 + i|²`. -/
theorem norm_two_add_I : ‖(2 : ℂ) + I‖ = √5 ∧ (2 + I) * (starRingEnd ℂ (2 + I)) = ((‖(2 : ℂ) + I‖ ^ 2 : ℝ) : ℂ) := by
  have hn : ‖(2 : ℂ) + I‖ = √5 := by
    rw [show (2 : ℂ) + I = ((2 : ℝ) : ℂ) + ((1 : ℝ) : ℂ) * I by push_cast; ring, norm_add_mul_I]
    veriphy_certified (norm_num)
    -- certificate: ca-num-sqrt.sage
  refine ⟨hn, ?_⟩
  rw [hn, Real.sq_sqrt (by norm_num), map_add, Complex.conj_I, map_ofNat]
  push_cast
  linear_combination (-1 : ℂ) * I_sq

/-- `Log(-1) = iπ` and `Log(-1) + Log(-1) ≠ Log((-1)²)`. -/
theorem log_neg_one_values :
    Complex.log (-1) = π * I ∧ Complex.log (-1) + Complex.log (-1) ≠ Complex.log ((-1) ^ 2) := by
  refine ⟨?_, ?_⟩
  · veriphy_certified
      ( simp only [Complex.arg_one, Complex.arg_I, Complex.arg_neg_one, Complex.arg_neg_I, Complex.log_neg_one,
          Complex.log_I, Complex.log_neg_I, Complex.log_one, Complex.exp_pi_mul_I, Complex.exp_two_pi_mul_I,
          Complex.exp_pi_div_two_mul_I, Complex.exp_zero, Complex.exp_add, Real.cos_pi, Real.sin_pi, neg_neg]
        all_goals ring)
    -- certificate: ca-num-rewrite.sage
  · rw [Complex.log_neg_one, show ((-1 : ℂ) ^ 2) = 1 by norm_num, Complex.log_one]
    intro h
    have := congrArg Complex.im h
    simp at this

/-! ## exm-roots-sum-geometric -/

/-- `(1 + ω + … + ω^{n-1})(1 - ω) = 1 - ωⁿ` for every `ω` and `n`. -/
theorem geom_sum_identity (x : ℂ) (n : ℕ) : (∑ k ∈ range n, x ^ k) * (1 - x) = 1 - x ^ n :=
  geom_sum_mul_neg x n
example : veriphy_instance% KaluzaKlein.ComplexAnalysis.NumbersWorked.geom_sum_identity (0) (0) := by
  simp

example : veriphy_instance% KaluzaKlein.ComplexAnalysis.NumbersWorked.geom_sum_identity (Complex.I) (3) := by
  simp only [Finset.sum_range_succ, Finset.sum_range_zero]
  ring

example : veriphy_instance% KaluzaKlein.ComplexAnalysis.NumbersWorked.geom_sum_identity (2) (4) := by
  simp only [Finset.sum_range_succ, Finset.sum_range_zero]
  ring

