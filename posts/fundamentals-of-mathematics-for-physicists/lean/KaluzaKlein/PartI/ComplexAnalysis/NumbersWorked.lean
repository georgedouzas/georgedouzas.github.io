import Mathlib
import Veriphy.Kit.Levels

/-!
# Complex analysis, section "Worked computations" (complex numbers)

The claims of the first "Worked computations" section of `tutorial/part-i-04-complex-analysis.qmd`: the sixth roots
of unity (powers, sum, product, factorisation of `z⁶ - 1`, the real ones), De Moivre for `n = 3`, `|2 + i| = √5`,
`Log(-1) = iπ`; the cube roots of unity; the discrete orthogonality `∑ ω^{km}`; `z⁶ - 1` over `ℚ`, `ℚ(i)`, `ℚ(ω)`.
-/

namespace KaluzaKlein.ComplexAnalysis.NumbersWorked

open Complex Real Finset Polynomial

/-- The primitive sixth root of unity `ω = e^{2πi/6}`. -/
noncomputable def ω : ℂ := Complex.exp (2 * π * I / 6)

/-- `ω = ½ + i√3/2`. -/
theorem ω_eq : ω = 1 / 2 + √3 / 2 * I := by
  rw [ω, show (2 * π * I / 6 : ℂ) = ((π / 3 : ℝ) : ℂ) * I by push_cast; ring, Complex.exp_mul_I,
    ← Complex.ofReal_cos, ← Complex.ofReal_sin, Real.cos_pi_div_three, Real.sin_pi_div_three]
  push_cast; ring

/-- The relations used below: `i² = -1` and `(√3)² = 3`. -/
theorem sqrt_three_sq : ((√3 : ℝ) : ℂ) ^ 2 = 3 := by
  exact_mod_cast Real.sq_sqrt (by norm_num : (0 : ℝ) ≤ 3)

/-! ## prp-roots-of-unity -/

/-- `ω_k = e^{2πik/6} = ωᵏ`. -/
theorem ω_pow_eq (k : ℕ) : Complex.exp (2 * π * I * k / 6) = ω ^ k := by
  rw [ω, ← Complex.exp_nat_mul]; congr 1; ring
example : veriphy_instance% KaluzaKlein.ComplexAnalysis.NumbersWorked.ω_pow_eq (0) := by
  show Complex.exp _ = Complex.exp (2 * Real.pi * Complex.I / 6) ^ _
  rw [← Complex.exp_nat_mul]
  congr 1
  push_cast
  ring

example : veriphy_instance% KaluzaKlein.ComplexAnalysis.NumbersWorked.ω_pow_eq (1) := by
  show Complex.exp _ = Complex.exp (2 * Real.pi * Complex.I / 6) ^ _
  rw [← Complex.exp_nat_mul]
  congr 1
  push_cast
  ring

example : veriphy_instance% KaluzaKlein.ComplexAnalysis.NumbersWorked.ω_pow_eq (2) := by
  show Complex.exp _ = Complex.exp (2 * Real.pi * Complex.I / 6) ^ _
  rw [← Complex.exp_nat_mul]
  congr 1
  push_cast
  ring

example : veriphy_instance% KaluzaKlein.ComplexAnalysis.NumbersWorked.ω_pow_eq (5) := by
  show Complex.exp _ = Complex.exp (2 * Real.pi * Complex.I / 6) ^ _
  rw [← Complex.exp_nat_mul]
  congr 1
  push_cast
  ring

attribute [veriphy_tested kernel_test 4 0] KaluzaKlein.ComplexAnalysis.NumbersWorked.ω_pow_eq
-- test: ca-num-omega-pow-test.sage

/-- `ω⁶ = 1`, hence `ω_k⁶ = 1` for every `k`. -/
theorem ω_pow_six : ω ^ 6 = 1 := by
  rw [ω_eq]
  have hI : I ^ 2 = -1 := I_sq
  have h3 := sqrt_three_sq
  generalize ((√3 : ℝ) : ℂ) = s at h3 ⊢
  rw [← sub_eq_zero]
  veriphy_certified
    (linear_combination
        (1 / 64 * s ^ 6 * I ^ 4 - 1 / 64 * s ^ 6 * I ^ 2 + 1 / 64 * s ^ 6 + 3 / 32 * s ^ 5 * I ^ 3 -
                      3 / 32 * s ^ 5 * I +
                    15 / 64 * s ^ 4 * I ^ 2 -
                  15 / 64 * s ^ 4 +
                5 / 16 * s ^ 3 * I +
              15 / 64 * s ^ 2) *
            hI +
          (-1 / 64 * s ^ 4 + 3 / 32 * s ^ 3 * I + 3 / 16 * s ^ 2 - 1 / 32 * s * I + 21 / 64) * h3)
  -- certificate: ideal_membership.sage

/-- The sum of the six roots is `0`. -/
theorem sum_roots : ∑ k ∈ range 6, ω ^ k = 0 := by
  simp only [Finset.sum_range_succ, Finset.sum_range_zero, zero_add, pow_zero, pow_one]
  rw [ω_eq]
  have hI : I ^ 2 = -1 := I_sq
  have h3 := sqrt_three_sq
  generalize ((√3 : ℝ) : ℂ) = s at h3 ⊢
  rw [← sub_eq_zero]
  veriphy_certified
    (linear_combination
        (1 / 32 * s ^ 5 * I ^ 3 - 1 / 32 * s ^ 5 * I + 7 / 32 * s ^ 4 * I ^ 2 - 7 / 32 * s ^ 4 + 11 / 16 * s ^ 3 * I +
              21 / 16 * s ^ 2) *
            hI +
          (1 / 32 * s ^ 3 * I + 7 / 32 * s ^ 2 - 19 / 32 * s * I - 21 / 32) * h3)
  -- certificate: ideal_membership.sage

