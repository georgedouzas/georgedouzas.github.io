/-- The explicit sixth roots: `ω⁰ … ω⁵ = 1, ½ + i√3/2, -½ + i√3/2, -1, -½ - i√3/2, ½ - i√3/2`. -/
theorem ω_pow_values :
    ω ^ 2 = -1 / 2 + √3 / 2 * I ∧ ω ^ 3 = -1 ∧ ω ^ 4 = -1 / 2 - √3 / 2 * I ∧ ω ^ 5 = 1 / 2 - √3 / 2 * I := by
  rw [ω_eq]
  have hI : I ^ 2 = -1 := I_sq
  have h3 := sqrt_three_sq
  refine ⟨?_, ?_, ?_, ?_⟩
  · veriphy_certified (linear_combination (1 / 4 * (↑√3) ^ 2) * hI + (-1 / 4) * h3)
    -- certificate: ideal_membership.sage
  · veriphy_certified
      (linear_combination (1 / 8 * (↑√3) ^ 3 * I + 3 / 8 * (↑√3) ^ 2) * hI + (-1 / 8 * (↑√3) * I - 3 / 8) * h3)
    -- certificate: ideal_membership.sage
  · veriphy_certified
      (linear_combination
          (1 / 16 * (↑√3) ^ 4 * I ^ 2 - 1 / 16 * (↑√3) ^ 4 + 1 / 4 * (↑√3) ^ 3 * I + 3 / 8 * (↑√3) ^ 2) * hI +
            (1 / 16 * (↑√3) ^ 2 - 1 / 4 * (↑√3) * I - 3 / 16) * h3)
    -- certificate: ideal_membership.sage
  · veriphy_certified
      (linear_combination
          (1 / 32 * (↑√3) ^ 5 * I ^ 3 - 1 / 32 * (↑√3) ^ 5 * I + 5 / 32 * (↑√3) ^ 4 * I ^ 2 - 5 / 32 * (↑√3) ^ 4 +
                  5 / 16 * (↑√3) ^ 3 * I +
                5 / 16 * (↑√3) ^ 2) *
              hI +
            (1 / 32 * (↑√3) ^ 3 * I + 5 / 32 * (↑√3) ^ 2 - 7 / 32 * (↑√3) * I + 5 / 32) * h3)
    -- certificate: ideal_membership.sage

/-- Exactly two of the sixth roots are real: `ωᵏ` is real for `k ∈ {0, 3}` (the values `±1`) and not for
`k ∈ {1, 2, 4, 5}` (imaginary part `±√3/2 ≠ 0`). -/
theorem real_roots (k : ℕ) (hk : k < 6) : (ω ^ k).im = 0 ↔ k = 0 ∨ k = 3 := by
  obtain ⟨h2, h3, h4, h5⟩ := ω_pow_values
  have hs : (0 : ℝ) < √3 := Real.sqrt_pos.mpr (by norm_num)
  interval_cases k
  · simp
  · rw [pow_one, ω_eq]; simp [hs.ne']
  · rw [h2]; simp [hs.ne']
  · rw [h3]; simp
  · rw [h4]; simp [hs.ne']
  · rw [h5]; simp [hs.ne']
example : veriphy_instance% KaluzaKlein.ComplexAnalysis.NumbersWorked.real_roots (0) ((by norm_num)) := by
  simp

example : veriphy_instance% KaluzaKlein.ComplexAnalysis.NumbersWorked.real_roots (3) ((by norm_num)) := by
  rw [ω_pow_values.2.1]
  simp

example : veriphy_instance% KaluzaKlein.ComplexAnalysis.NumbersWorked.real_roots (1) ((by norm_num)) := by
  rw [pow_one, ω_eq]
  simp [(Real.sqrt_pos.mpr (by norm_num : (0 : ℝ) < 3)).ne']

