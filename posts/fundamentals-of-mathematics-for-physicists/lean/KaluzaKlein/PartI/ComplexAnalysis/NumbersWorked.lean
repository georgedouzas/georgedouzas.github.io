            (1 / 256 * (↑√3) ^ 6 - 1 / 32 * (↑√3) ^ 5 * I - 25 / 256 * (↑√3) ^ 4 + 1 / 8 * (↑√3) ^ 3 * I +
                    11 / 256 * (↑√3) ^ 2 -
                  3 / 32 * (↑√3) * I -
                91 / 256) *
              h3)
    -- certificate: ideal_membership.sage

/-! ## exr-roots-cube -/

/-- `ω₃ = e^{2πi/3} = -½ + i√3/2`. -/
theorem cube_root_eq : Complex.exp (2 * π * I / 3) = -1 / 2 + √3 / 2 * I := by
  rw [show (2 * π * I / 3 : ℂ) = ((π - π / 3 : ℝ) : ℂ) * I by push_cast; ring, Complex.exp_mul_I,
    ← Complex.ofReal_cos, ← Complex.ofReal_sin, Real.cos_pi_sub, Real.sin_pi_sub, Real.cos_pi_div_three,
    Real.sin_pi_div_three, show (-1 / 2 + √3 / 2 * I : ℂ) = (-1 + √3 * I) / 2 by ring,
    eq_div_iff (two_ne_zero : (2 : ℂ) ≠ 0), Complex.ofReal_neg]
  have h1 : ((1 / 2 : ℝ) : ℂ) * 2 = 1 := by push_cast; ring
  have h3 : ((√3 / 2 : ℝ) : ℂ) * 2 = ((√3 : ℝ) : ℂ) := by push_cast; ring
  generalize ((1 / 2 : ℝ) : ℂ) = a at h1 ⊢
  generalize ((√3 / 2 : ℝ) : ℂ) = b at h3 ⊢
  generalize ((√3 : ℝ) : ℂ) = t at h3 ⊢
  rw [← sub_eq_zero]
  veriphy_certified (linear_combination (-1) * h1 + (I) * h3)
  -- certificate: ideal_membership.sage

/-- The cube roots `1, ω, ω²` with `ω = -½ + i√3/2`: `ω³ = 1`, `ω² = -½ - i√3/2`, `1 + ω + ω² = 0`. -/
theorem cube_roots_values :
    (-1 / 2 + √3 / 2 * I : ℂ) ^ 3 = 1 ∧ (-1 / 2 + √3 / 2 * I : ℂ) ^ 2 = -1 / 2 - √3 / 2 * I ∧
      1 + (-1 / 2 + √3 / 2 * I : ℂ) + (-1 / 2 + √3 / 2 * I) ^ 2 = 0 := by
  have hI : I ^ 2 = -1 := I_sq
  have h3 := sqrt_three_sq
  refine ⟨?_, ?_, ?_⟩
  · veriphy_certified
      (linear_combination (1 / 8 * (↑√3) ^ 3 * I - 3 / 8 * (↑√3) ^ 2) * hI + (-1 / 8 * (↑√3) * I + 3 / 8) * h3)
    -- certificate: ideal_membership.sage
  · veriphy_certified (linear_combination (1 / 4 * (↑√3) ^ 2) * hI + (-1 / 4) * h3)
    -- certificate: ideal_membership.sage
  · veriphy_certified (linear_combination (1 / 4 * (↑√3) ^ 2) * hI + (-1 / 4) * h3)
    -- certificate: ideal_membership.sage

/-- `ω² = ω̄ = 1/ω` for `ω = -½ + i√3/2`. -/
theorem cube_root_conj :
    (-1 / 2 + √3 / 2 * I : ℂ) ^ 2 = starRingEnd ℂ (-1 / 2 + √3 / 2 * I) ∧
      (-1 / 2 + √3 / 2 * I : ℂ) ^ 2 = 1 / (-1 / 2 + √3 / 2 * I) := by
  have hI : I ^ 2 = -1 := I_sq
  have h3 := sqrt_three_sq
  have hne : (-1 / 2 + √3 / 2 * I : ℂ) ≠ 0 := by
    intro h; have := congrArg Complex.re h; simp at this
  constructor
  · simp only [map_add, map_mul, map_div₀, map_neg, map_one, map_ofNat, Complex.conj_ofReal, Complex.conj_I]
    veriphy_certified (linear_combination (1 / 4 * (↑√3) ^ 2) * hI + (-1 / 4) * h3)
    -- certificate: ideal_membership.sage
  · rw [eq_div_iff hne]
    veriphy_certified
      (linear_combination (1 / 8 * (↑√3) ^ 3 * I - 3 / 8 * (↑√3) ^ 2) * hI + (-1 / 8 * (↑√3) * I + 3 / 8) * h3)
    -- certificate: ideal_membership.sage

/-! ## exr-roots-general -/

/-- Discrete orthogonality: for `n ≥ 2` and `ω = e^{2πi/n}`, `∑_{k<n} ω^{km}` is `n` if `n ∣ m` and `0` otherwise. -/
theorem discrete_orthogonality (n m : ℕ) (hn : 2 ≤ n) :
    ∑ k ∈ range n, Complex.exp (((2 * π / n : ℝ) : ℂ) * I) ^ (k * m) = if n ∣ m then (n : ℂ) else 0 := by
  rw [show Complex.exp (((2 * π / n : ℝ) : ℂ) * I) = Complex.exp (2 * π * I / n) by congr 1; push_cast; ring]
  have hn0 : n ≠ 0 := by omega
  have hp := Complex.isPrimitiveRoot_exp n hn0
  set ζ := Complex.exp (2 * π * I / n)
  have hterm : ∀ k : ℕ, ζ ^ (k * m) = (ζ ^ m) ^ k := fun k => by rw [← pow_mul, mul_comm]
  simp only [hterm]
  split_ifs with h
  · rw [(hp.pow_eq_one_iff_dvd m).mpr h]; simp
  · have hne : ζ ^ m ≠ 1 := fun h' => h ((hp.pow_eq_one_iff_dvd m).mp h')
    rw [geom_sum_eq hne, show (ζ ^ m) ^ n = (ζ ^ n) ^ m by rw [← pow_mul, ← pow_mul, mul_comm],
      hp.pow_eq_one, one_pow, sub_self, zero_div]
attribute [veriphy_tested oracle_test 0 4] KaluzaKlein.ComplexAnalysis.NumbersWorked.discrete_orthogonality
-- test: ca-num-discrete-orth-test.sage

/-! ## exr-roots-polynomial-factor -/

/-- Over `ℚ(i)` nothing changes: `z² + z + 1` and `z² - z + 1` have no root `a + bi` with `a, b ∈ ℚ`. -/
theorem no_root_gaussian (a b : ℚ) :
    ((a : ℂ) + b * I) ^ 2 + (a + b * I) + 1 ≠ 0 ∧ ((a : ℂ) + b * I) ^ 2 - (a + b * I) + 1 ≠ 0 := by
  have key : ∀ s : ℚ, s ^ 2 = 1 → ((a : ℂ) + b * I) ^ 2 + s * (a + b * I) + 1 ≠ 0 := by
    intro s hs h
    have hre := congrArg Complex.re h
    have him := congrArg Complex.im h
    simp [sq, Complex.mul_re, Complex.mul_im] at hre him
    have hre' : (a : ℝ) * a - b * b + s * a + 1 = 0 := by linarith
    have him' : (b : ℝ) * (2 * a + s) = 0 := by linarith
    have hre'' : a * a - b * b + s * a + 1 = 0 := by exact_mod_cast hre'
    have him'' : b * (2 * a + s) = 0 := by exact_mod_cast him'
    rcases mul_eq_zero.mp him'' with hb | hb
    · rw [hb] at hre''; nlinarith [sq_nonneg (a + s / 2), hs]
    · have ha : a = -s / 2 := by linarith
      rw [ha] at hre''
      have h4 : (2 * b) ^ 2 = 3 := by nlinarith
      have hirr : Irrational (√3) := by
        have := Nat.Prime.irrational_sqrt (p := 3) (by norm_num); simpa using this
      apply hirr
      refine ⟨|2 * b|, ?_⟩
      have h4' := congrArg (fun q : ℚ => (q : ℝ)) h4
      push_cast at h4'
      have : ((|2 * b| : ℚ) : ℝ) ^ 2 = 3 := by push_cast; rw [sq_abs]; exact h4'
      rw [← this, Real.sqrt_sq (by positivity)]
  exact ⟨by simpa using key 1 (by norm_num), by simpa [sub_eq_add_neg] using key (-1) (by norm_num)⟩
attribute [veriphy_tested oracle_test 0 3] KaluzaKlein.ComplexAnalysis.NumbersWorked.no_root_gaussian
-- test: ca-num-no-gaussian-root-test.sage

/-- Over `ℚ(ω)` with `ω² + ω + 1 = 0`, `z⁶ - 1` splits into six linear factors `(z ∓ 1)(z ∓ ω)(z ∓ ω²)`. -/
theorem split_over_eisenstein {K : Type*} [Field K] (ω₃ z : K) (h : ω₃ ^ 2 + ω₃ + 1 = 0) :
    z ^ 6 - 1 = (z - 1) * (z + 1) * (z - ω₃) * (z + ω₃) * (z - ω₃ ^ 2) * (z + ω₃ ^ 2) := by
  veriphy_certified
    (linear_combination
        (z ^ 4 * ω₃ ^ 2 - z ^ 4 * ω₃ + z ^ 4 - z ^ 2 * ω₃ ^ 4 + z ^ 2 * ω₃ ^ 3 - z ^ 2 * ω₃ ^ 2 + ω₃ ^ 4 - ω₃ ^ 3 + ω₃ -
            1) *
          h)
  -- certificate: ideal_membership.sage

end KaluzaKlein.ComplexAnalysis.NumbersWorked
