exp(t T_1) = [1/2*(cos(1/2*t) - I*sin(1/2*t))*cos(t) + 1/2*(I*cos(1/2*t) + sin(1/2*t))*sin(t) + 1/2*cos(1/2*t) - 1/2*I*sin(1/2*t), -1/2*(cos(1/2*t) - I*sin(1/2*t))*cos(t) - 1/2*(I*cos(1/2*t) + sin(1/2*t))*sin(t) + 1/2*cos(1/2*t) - 1/2*I*sin(1/2*t), -1/2*(cos(1/2*t) - I*sin(1/2*t))*cos(t) - 1/2*(I*cos(1/2*t) + sin(1/2*t))*sin(t) + 1/2*cos(1/2*t) - 1/2*I*sin(1/2*t), 1/2*(cos(1/2*t) - I*sin(1/2*t))*cos(t) + 1/2*(I*cos(1/2*t) + sin(1/2*t))*sin(t) + 1/2*cos(1/2*t) - 1/2*I*sin(1/2*t)] ; equals cos(t/2) 1 - i sin(t/2) sigma: True
exp(t T_2) = [1/2*(cos(1/2*t) - I*sin(1/2*t))*cos(t) + 1/2*(I*cos(1/2*t) + sin(1/2*t))*sin(t) + 1/2*cos(1/2*t) - 1/2*I*sin(1/2*t), 1/2*(I*cos(1/2*t) + sin(1/2*t))*cos(t) - 1/2*(cos(1/2*t) - I*sin(1/2*t))*sin(t) - 1/2*I*cos(1/2*t) - 1/2*sin(1/2*t), -1/2*(I*cos(1/2*t) + sin(1/2*t))*cos(t) + 1/2*(cos(1/2*t) - I*sin(1/2*t))*sin(t) + 1/2*I*cos(1/2*t) + 1/2*sin(1/2*t), 1/2*(cos(1/2*t) - I*sin(1/2*t))*cos(t) + 1/2*(I*cos(1/2*t) + sin(1/2*t))*sin(t) + 1/2*cos(1/2*t) - 1/2*I*sin(1/2*t)] ; equals cos(t/2) 1 - i sin(t/2) sigma: True
exp(t T_3) = [cos(1/2*t) - I*sin(1/2*t), 0, 0, cos(1/2*t) + I*sin(1/2*t)] ; equals cos(t/2) 1 - i sin(t/2) sigma: True
exp(2 pi T_3) = [-1, 0, 0, -1] ; exp(4 pi T_3) = [1, 0, 0, 1]
sigma_a^2 = 1 for all a: True
