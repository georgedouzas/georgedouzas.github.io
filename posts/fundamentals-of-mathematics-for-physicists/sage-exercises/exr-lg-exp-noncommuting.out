e^(X+Y) = [1/2*(e^2 + 1)*e^(-1), 1/2*(e^2 - 1)*e^(-1), 1/2*(e^2 - 1)*e^(-1), 1/2*(e^2 + 1)*e^(-1)] ; equals cosh(1) 1 + sinh(1)(X + Y): True
