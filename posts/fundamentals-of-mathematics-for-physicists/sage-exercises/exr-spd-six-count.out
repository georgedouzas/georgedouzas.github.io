M = -4: 4 zero modes of internal chirality -1 -> 4 left-handed four-dimensional spinors, SU(2) spin 3/2
M = -3: 3 zero modes of internal chirality -1 -> 3 left-handed four-dimensional spinors, SU(2) spin 1
M = -2: 2 zero modes of internal chirality -1 -> 2 left-handed four-dimensional spinors, SU(2) spin 1/2
M = -1: 1 zero modes of internal chirality -1 -> 1 left-handed four-dimensional spinors, SU(2) spin 0
M =  0: no zero modes (vanishing theorem)
M = +1: 1 zero modes of internal chirality +1 -> 1 right-handed four-dimensional spinors, SU(2) spin 0
M = +2: 2 zero modes of internal chirality +1 -> 2 right-handed four-dimensional spinors, SU(2) spin 1/2
M = +3: 3 zero modes of internal chirality +1 -> 3 right-handed four-dimensional spinors, SU(2) spin 1
M = +4: 4 zero modes of internal chirality +1 -> 4 right-handed four-dimensional spinors, SU(2) spin 3/2
