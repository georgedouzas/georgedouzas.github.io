# Exercise exr-lg-one-param-affine: the one-parameter subgroup of the affine group generated by X + Y, with
# X = [[1,0],[0,0]], Y = [[0,1],[0,0]]: gamma(t) = e^{t(X+Y)} = [[e^t, e^t - 1],[0, 1]], the group law, the equation
# gamma' = (X + Y) gamma, and the general exponential e^{xX + yY}.
s, t, x, y = var("s t x y", domain="real")
X = matrix(SR, [[1, 0], [0, 0]]); Y = matrix(SR, [[0, 1], [0, 0]])
g = (t * (X + Y)).exp().simplify_full()
print("exp(t(X + Y)) =", g.list())
print("gamma(s) gamma(t) = gamma(s + t):", bool(g.subs(t=s) * g == g.subs(t=s + t)))
print("gamma' = (X + Y) gamma:", bool(diff(g, t) == (X + Y) * g), "; gamma(0) = 1:", g.subs(t=0) == identity_matrix(SR, 2))
G = (x * X + y * Y).exp().simplify_full()
print("exp(xX + yY) =", G.list(), "; equals [[e^x, y (e^x - 1)/x], [0, 1]]:", bool(G == matrix(SR, [[exp(x), y * (exp(x) - 1) / x], [0, 1]])))
print("the orbit (a, b) = (e^t, e^t - 1) lies on the line b = a - 1 through the identity (1, 0)")
