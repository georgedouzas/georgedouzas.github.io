# Exercise exr-lrep-weyl-group: the Weyl group of su(3) is generated by the reflections s_alpha(mu) = mu - 2 (mu.alpha)/
# (alpha.alpha) alpha in the simple roots; it has order 6 (= S_3), permutes the roots, and maps alpha_1 to every root.
L = RootSystem(["A", 2]).ambient_space()
W = L.weyl_group(prefix="s")
print("order of the Weyl group:", W.order(), "; isomorphic to S_3 (permutes the three coordinates)")
a1, a2 = L.simple_roots()
print("s_1(alpha_2) = alpha_1 + alpha_2:", a2.simple_reflection(1) == a1 + a2)
orbit = set(w.action(a1) for w in W)
print("orbit of alpha_1 = all six roots:", orbit == set(L.roots()), "; size", len(orbit))
print("every element of W permutes the roots:", all(set(w.action(r) for r in L.roots()) == set(L.roots()) for w in W))
print("weights of 3 form one orbit:", len(set(w.action(L.fundamental_weights()[1]) for w in W)))
