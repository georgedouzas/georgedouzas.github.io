# Exercise exr-cosq-orbits: orbits of a cyclic group on {1,...,6} and of the dihedral group D_4 on the vertices
# and on the two-element sets of vertices of a square.
G = PermutationGroup([[(1, 2, 3), (4, 5)]], domain=range(1, 7))
print("the group generated by (1,2,3)(4,5) has order", G.order(), "and orbits", G.orbits())
D4 = DihedralGroup(4)
print("D_4 orbits on the vertices:", D4.orbits())
pairs = Set([Set([i, j]) for i in range(1, 5) for j in range(i + 1, 5)])
orbs = []
for p in pairs:
    o = Set([Set([g(i) for i in p]) for g in D4])
    if o not in orbs:
        orbs.append(o)
print("D_4 orbits on the six pairs of vertices:", [sorted(sorted(q) for q in o) for o in orbs])
print("sizes:", [len(o) for o in orbs], "(4 edges and 2 diagonals)")
