# Exercise exr-cosq-cube-rotations: the rotation group of the cube as a matrix group, and the orbit-stabiliser count
# |G| = |orbit of a vertex| x |stabiliser| = 8 x 3.
Rz = matrix(ZZ, [[0, -1, 0], [1, 0, 0], [0, 0, 1]])     # rotation by 90 degrees about Z
Rx = matrix(ZZ, [[1, 0, 0], [0, 0, -1], [0, 1, 0]])     # rotation by 90 degrees about X
G = MatrixGroup([Rz, Rx])
els = [g.matrix() for g in G]
print("order of the group generated by the two quarter turns:", len(els), "; all have determinant 1:", all(m.det() == 1 for m in els))
v = vector(ZZ, [1, 1, 1])
orbit = {tuple(m * v) for m in els}
stab = [m for m in els if m * v == v]
print("orbit of the vertex (1,1,1):", sorted(orbit))
print("|orbit| =", len(orbit), "; |stabiliser| =", len(stab), "; product =", len(orbit) * len(stab))
print("the stabiliser is the cyclic group of rotations about the diagonal:", [list(m) for m in stab])
f = vector(ZZ, [0, 0, 1])
print("orbit of the face centre (0,0,1):", len({tuple(m * f) for m in els}), "points; stabiliser of order", len([m for m in els if m * f == f]))
