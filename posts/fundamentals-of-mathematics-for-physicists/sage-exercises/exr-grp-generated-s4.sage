# Exercise exr-grp-generated-s4: subgroups of S_4 generated by a few permutations.
S4 = SymmetricGroup(4)
G1 = S4.subgroup([S4("(1,2)"), S4("(1,2,3,4)")])
print("<(1,2), (1,2,3,4)> has order", G1.order(), "; equals S_4:", G1.order() == S4.order())
V = S4.subgroup([S4("(1,2)(3,4)"), S4("(1,3)(2,4)")])
print("<(1,2)(3,4), (1,3)(2,4)> =", [str(v) for v in V], "; order", V.order(), "; abelian:", V.is_abelian(), "; cyclic:", V.is_cyclic())
C = S4.subgroup([S4("(1,2,3,4)")])
print("<(1,2,3,4)> =", [str(c) for c in C], "; order", C.order())
G3 = S4.subgroup([S4("(1,2,3)"), S4("(1,2)(3,4)")])
print("<(1,2,3), (1,2)(3,4)> has order", G3.order(), "; it is the alternating group A_4 (the even permutations):", set(G3) == {g for g in S4 if g.sign() == 1})
