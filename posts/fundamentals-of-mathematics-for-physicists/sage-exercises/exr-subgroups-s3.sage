# Exercise exr-subgroups-s3: the subgroups of S_3 and of Z_6 with Sage, which are normal, and the subgroup
# generated by a chosen element.
S3 = SymmetricGroup(3)
for H in S3.subgroups():
    print("subgroup of order", H.order(), ":", H.list(), "; normal:", H.is_normal(S3))
A3 = S3.subgroup([S3((1, 2, 3))])
print("the subgroup generated by (1,2,3) is A_3 of order", A3.order(), "; the one generated by (1,2) has order", S3.subgroup([S3((1, 2))]).order())
Z6 = CyclicPermutationGroup(6)
print("orders of the subgroups of Z_6:", sorted(H.order() for H in Z6.subgroups()), " (every divisor of 6, all normal:", all(H.is_normal(Z6) for H in Z6.subgroups()), ")")
print("Lagrange: every subgroup order divides 6:", all(6 % H.order() == 0 for H in S3.subgroups()))
